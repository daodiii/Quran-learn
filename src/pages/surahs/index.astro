---
import '../../styles/night.css';
import NightTabBar from '../../components/NightTabBar.astro';
import { getCollection } from 'astro:content';
import { SURAH_OPENINGS } from '../../data/surah-openings';

const all = (await getCollection('surahs')).sort((a, b) => a.data.surahNumber - b.data.surahNumber);
if (all.length !== 38) throw new Error(`surahs: expected 38, found ${all.length} — update the astrolabe copy/legend`);
const SURAHS = all.map(s => {
  const extra = SURAH_OPENINGS[s.data.surahNumber];
  if (!extra) throw new Error(`surah-openings: no entry for surah ${s.data.surahNumber}`);
  return {
    num: s.data.surahNumber, ar: s.data.nameArabic, name: s.data.name,
    v: s.data.verseCount, rev: extra.rev, diff: s.data.difficulty,
    open: extra.open, href: `/surahs/${s.id}/`,
  };
});
const counts = {
  beginner: SURAHS.filter(s => s.diff === 'beginner').length,
  intermediate: SURAHS.filter(s => s.diff === 'intermediate').length,
  advanced: SURAHS.filter(s => s.diff === 'advanced').length,
};
const maxVerses = Math.max(...SURAHS.map(s => s.v));
// Mobile view: the astrolabe can't be spun on a phone, so surahs are grouped by
// difficulty into a tappable list. Order beginner → intermediate → advanced.
const surahGroups = ([
  { key: 'beginner', label: 'Beginner', dot: 'b' },
  { key: 'intermediate', label: 'Intermediate', dot: 'i' },
  { key: 'advanced', label: 'Advanced', dot: 'a' },
] as const).map(g => ({ ...g, items: SURAHS.filter(s => s.diff === g.key), count: counts[g.key] }));
const fatiha = SURAHS[0];
if (!fatiha || fatiha.num !== 1) throw new Error('surahs: expected surah 001 first');
const title = 'Surah Breakdowns | Quranic Grammar';
const description = "Word-by-word grammatical analysis of 38 Quranic surahs. Each breakdown includes I'rab case endings, morphology, and syntax for every verse.";
const canonicalURL = new URL('/surahs/', Astro.site);
const ogImageURL = new URL('/images/og-default.jpg', Astro.site);
---

