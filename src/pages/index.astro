<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initCapacitor } from '../scripts/capacitor-init';

  window.gsap = gsap;
  window.ScrollTrigger = ScrollTrigger;
  initCapacitor();

/* ══════════════════════════════════════════════════════════════
   نور على نور · Light upon Light
   Act engine: WebGL nebula, particle basmala, constellation
   scrollytelling, path drawing, kinetic bands, instruments.
   ══════════════════════════════════════════════════════════════ */
(function(){
'use strict';
document.documentElement.classList.add('js');

const RM   = matchMedia('(prefers-reduced-motion: reduce)').matches;
const LITE = matchMedia('(max-width: 767px)').matches;
const FINE = matchMedia('(hover: hover) and (pointer: fine)').matches;
const G    = window.gsap || null;
if (G && window.ScrollTrigger) G.registerPlugin(ScrollTrigger);

const $  = (s, c) => (c || document).querySelector(s);
const $$ = (s, c) => Array.from((c || document).querySelectorAll(s));
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const lerp  = (a, b, t) => a + (b - a) * t;

let pageVisible = !document.hidden;
document.addEventListener('visibilitychange', () => { pageVisible = !document.hidden; });

/* ---------------------------------------------------------------
   NAV scrolled state
--------------------------------------------------------------- */
const nav = $('#nav');
let navTick = false;
addEventListener('scroll', () => {
  if (navTick) return; navTick = true;
  requestAnimationFrame(() => {
    nav.classList.toggle('scrolled', scrollY > 40);
    navTick = false;
  });
}, { passive: true });

/* ---------------------------------------------------------------
   Counters (standalone, no deps)
--------------------------------------------------------------- */
function runCounter(el){
  const target = parseInt(el.dataset.count, 10);
  if (RM) { el.textContent = target; return; }
  const t0 = performance.now(), dur = 1500;
  (function step(now){
    const p = clamp((now - t0) / dur, 0, 1);
    el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
    if (p < 1) requestAnimationFrame(step);
  })(t0);
}
const countIO = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { runCounter(e.target); countIO.unobserve(e.target); }
}), { threshold: 0.5 });
$$('[data-count]').forEach(el => countIO.observe(el));

/* ---------------------------------------------------------------
   Reveal system (sections outside hero)
--------------------------------------------------------------- */
$$('section, footer, .band').forEach(sec => {
  $$('[data-reveal]', sec).forEach((el, i) => { el.dataset.di = Math.min(i, 5); });
});
const heroEl = $('.hero');
const revealIO = new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return;
  const el = e.target;
  el.style.transitionDelay = RM ? '0ms' : (el.dataset.di * 70) + 'ms';
  el.classList.add('on');
  el.addEventListener('transitionend', () => { el.style.transitionDelay = ''; }, { once: true });
  revealIO.unobserve(el);
}), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
$$('[data-reveal]').forEach(el => { if (!heroEl.contains(el)) revealIO.observe(el); });

/* ---------------------------------------------------------------
   ACT I · WebGL nebula
--------------------------------------------------------------- */
const glCanvas = $('#gl');
let glPause = false;
if (!LITE && !RM) (function initGL(){
  let gl;
  try { gl = glCanvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' }); }
  catch(e) { gl = null; }
  if (!gl) { glCanvas.remove(); return; }

  const VS = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
  const FS = `
precision highp float;
uniform vec2 uRes; uniform float uT; uniform vec2 uMouse; uniform float uScroll;
float hash(vec2 p){p=fract(p*vec2(123.34,345.45));p+=dot(p,p+34.345);return fract(p.x*p.y);}
float noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
  float a=hash(i),b=hash(i+vec2(1.,0.)),c=hash(i+vec2(0.,1.)),d=hash(i+vec2(1.,1.));
  return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;mat2 m=mat2(1.6,1.2,-1.2,1.6);
  for(int i=0;i<5;i++){v+=a*noise(p);p=m*p;a*=.5;}return v;}
void main(){
  vec2 uv=gl_FragCoord.xy/uRes;
  vec2 p=(gl_FragCoord.xy-.5*uRes)/uRes.y;
  p.y+=uScroll*.22;
  float t=uT*.022;
  vec2 q=vec2(fbm(p*1.35+t),fbm(p*1.35-t*.7+3.1));
  vec2 r=vec2(fbm(p*1.75+q*1.3+vec2(1.7,9.2)+t*.55),fbm(p*1.75+q*1.3+vec2(8.3,2.8)-t*.4));
  float f=fbm(p*1.9+r*1.25);
  float md=length(p-uMouse);
  f+=.085*exp(-md*3.2);
  vec3 col=mix(vec3(.012,.02,.055),vec3(.052,.09,.21),clamp(f*f*2.0,0.,1.));
  float band=exp(-pow((p.y-.16-q.x*.24)*3.2,2.));
  col=mix(col,vec3(.065,.40,.40),clamp(band*(.3+.7*q.y)*1.4,0.,1.)*.42);
  col=mix(col,vec3(.085,.07,.20),clamp(r.x*1.2,0.,1.)*.2);
  col+=vec3(.79,.55,.25)*pow(clamp(f,0.,1.),3.4)*.72;
  float hor=exp(-pow((p.y+.52)*2.4,2.));
  col+=vec3(.72,.5,.22)*hor*(.5+.5*fbm(vec2(p.x*2.2,t*2.)))*.34;
  float beam=exp(-pow(p.x*2.1,2.))*pow(uv.y,1.7);
  float flick=.85+.15*noise(vec2(uT*.35,p.x*4.));
  col+=vec3(.95,.78,.52)*beam*.13*flick;
  col+=vec3(1.,.82,.5)*exp(-md*4.2)*.11;
  vec2 sg=gl_FragCoord.xy/(uRes.y*.011);
  float sh=hash(floor(sg));
  float star=smoothstep(.9978,1.,sh)*(.35+.65*(.5+.5*sin(uT*1.4+sh*42.)));
  col+=vec3(.95,.9,.75)*star*.55;
  vec2 vc=uv-.5;
  col*=1.-.72*dot(vc,vc)*1.6;
  col*=1.-uScroll*.3;
  col+=(hash(gl_FragCoord.xy+fract(uT)*13.7)-.5)*.02;
  gl_FragColor=vec4(col,1.);
}`;
  function shader(type, src){
    const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.error('shader:', gl.getShaderInfoLog(s)); return null; }
    return s;
  }
  const vs = shader(gl.VERTEX_SHADER, VS), fs = shader(gl.FRAGMENT_SHADER, FS);
  if (!vs || !fs) { glCanvas.remove(); return; }
  const prog = gl.createProgram();
  gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { console.error('link:', gl.getProgramInfoLog(prog)); glCanvas.remove(); return; }
  gl.useProgram(prog);
  const buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
  const loc = gl.getAttribLocation(prog, 'a');
  gl.enableVertexAttribArray(loc);
  gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
  const uRes = gl.getUniformLocation(prog, 'uRes'),
        uT = gl.getUniformLocation(prog, 'uT'),
        uMouse = gl.getUniformLocation(prog, 'uMouse'),
        uScroll = gl.getUniformLocation(prog, 'uScroll');

  const SCALE = 0.6, DPR = Math.min(devicePixelRatio || 1, 1.5);
  function sizeGL(){
    const w = heroEl.clientWidth, h = heroEl.clientHeight;
    glCanvas.width  = Math.max(2, Math.round(w * DPR * SCALE));
    glCanvas.height = Math.max(2, Math.round(h * DPR * SCALE));
    gl.viewport(0, 0, glCanvas.width, glCanvas.height);
  }
  sizeGL();

  let mx = 0, my = 0.1, tx = 0, ty = 0.1;
  addEventListener('pointermove', e => {
    const w = innerWidth, h = innerHeight;
    tx = (e.clientX - w / 2) / h;
    ty = (h / 2 - e.clientY) / h;
  }, { passive: true });

  const heroIO = new IntersectionObserver(es => { glPause = !es[0].isIntersecting; }, { threshold: 0 });
  heroIO.observe(heroEl);

  const t0 = performance.now();
  (function frame(now){
    requestAnimationFrame(frame);
    if (glPause || !pageVisible) return;
    mx = lerp(mx, tx, 0.045); my = lerp(my, ty, 0.045);
    gl.uniform2f(uRes, glCanvas.width, glCanvas.height);
    gl.uniform1f(uT, (now - t0) / 1000);
    gl.uniform2f(uMouse, mx, my);
    gl.uniform1f(uScroll, clamp(scrollY / Math.max(1, heroEl.clientHeight), 0, 1));
    gl.drawArrays(gl.TRIANGLES, 0, 3);
  })(t0);

  let rsz;
  addEventListener('resize', () => { clearTimeout(rsz); rsz = setTimeout(sizeGL, 180); });
})();
if (LITE || RM) glCanvas.remove();

/* ---------------------------------------------------------------
   ACT I · Gold dust: basmala formation + ambient embers
--------------------------------------------------------------- */
const dustCanvas = $('#dust');
const basmala = $('#basmala');
let heroSequenceStarted = false;

/* fit the one-line basmala: 80% of container width, capped by viewport height */
function fitVerse(){
  if (matchMedia('(max-width: 700px)').matches) return;
  const inner = $('.hero-inner');
  basmala.style.fontSize = '96px';
  const availW = inner.clientWidth * 0.80;
  let fs2 = Math.min(96, Math.round(heroEl.clientHeight * 0.108));
  const w = basmala.scrollWidth;
  if (w > availW) fs2 = Math.min(fs2, Math.floor(96 * availW / w * 0.985));
  basmala.style.fontSize = fs2 + 'px';
}

let heroRevealed = false;
function heroReveals(){
  if (heroRevealed) return; heroRevealed = true;
  const els = $$('[data-reveal]', heroEl);
  els.forEach((el, i) => {
    setTimeout(() => el.classList.add('on'), RM ? 0 : 140 + i * 130);
  });
}
function unveilBasmala(){
  basmala.classList.remove('veiled');
}

function startHeroStatic(){
  if (heroSequenceStarted) return; heroSequenceStarted = true;
  dustCanvas.remove();
  unveilBasmala();
  heroReveals();
}

function startHeroFormation(){
  if (heroSequenceStarted) return; heroSequenceStarted = true;
  const ctx = dustCanvas.getContext('2d');
  if (!ctx) { heroSequenceStarted = false; startHeroStatic(); return; }

  const DPR = Math.min(devicePixelRatio || 1, 2);
  let W = heroEl.clientWidth, H = heroEl.clientHeight;
  dustCanvas.width = W * DPR; dustCanvas.height = H * DPR;
  ctx.scale(DPR, DPR);

  /* sample basmala glyphs into target points */
  const heroRect = heroEl.getBoundingClientRect();
  const off = document.createElement('canvas');
  off.width = W; off.height = H;
  const octx = off.getContext('2d', { willReadFrequently: true });
  const fs = parseFloat(getComputedStyle(basmala).fontSize);
  octx.fillStyle = '#fff';
  octx.font = fs + 'px "Amiri Quran"';
  octx.textAlign = 'center';
  octx.direction = 'rtl';
  const lines = $$('.bl', basmala);
  lines.forEach(ln => {
    const r = ln.getBoundingClientRect();
    const cx = r.left + r.width / 2 - heroRect.left;
    const m = octx.measureText(ln.textContent);
    if (m.fontBoundingBoxAscent !== undefined) {
      /* anchor to the DOM baseline: inline-box top + font ascent = baseline,
         so canvas ink lands exactly where the unveiled glyphs render */
      octx.textBaseline = 'alphabetic';
      octx.fillText(ln.textContent, cx, r.top - heroRect.top + m.fontBoundingBoxAscent);
    } else {
      octx.textBaseline = 'middle';
      octx.fillText(ln.textContent, cx, r.top + r.height / 2 - heroRect.top);
    }
  });
  /* two-pass sampling to hit a particle budget */
  const img = octx.getImageData(0, 0, W, H).data;
  const budget = 2400;
  let step = 3, pts = [];
  for (let pass = 0; pass < 2; pass++) {
    pts = [];
    for (let y = 0; y < H; y += step) {
      for (let x = 0; x < W; x += step) {
        if (img[(y * W + x) * 4 + 3] > 120) pts.push([x, y]);
      }
    }
    if (pts.length <= budget * 1.35) break;
    step = Math.ceil(step * Math.sqrt(pts.length / budget));
  }
  if (pts.length < 60) { heroSequenceStarted = false; startHeroStatic(); return; }

  let minX = 1e9, maxX = -1e9;
  const midY = H / 2;
  pts.forEach(p => { if (p[0] < minX) minX = p[0]; if (p[0] > maxX) maxX = p[0]; });
  const spanX = Math.max(1, maxX - minX);

  const P = pts.map(([x, y]) => {
    const nx = (x - minX) / spanX;
    const line2 = y > midY ? 1 : 0;
    const ang = Math.random() * Math.PI * 2;
    const rad = 260 + Math.random() * 640;
    return {
      tx: x, ty: y,
      sx: x + Math.cos(ang) * rad,
      sy: y + Math.sin(ang) * rad * 0.72,
      delay: (1 - nx) * 0.95 + line2 * 0.5 + Math.random() * 0.22,
      size: 0.5 + Math.random() * 1.15,
      tw: Math.random() * Math.PI * 2,
      hot: Math.random() < 0.12,
      x: 0, y: 0, vx: 0, vy: 0, fade: 1, life: 0, span: 8, dur: 2
    };
  });
  P.forEach(p => { p.x = p.sx; p.y = p.sy; });

  const FORM_T = 1.05;
  const T_END = 0.95 + 0.5 + 0.22 + FORM_T;
  let born = performance.now(), phase = 'form', released = false;
  let pointerX = -1e4, pointerY = -1e4;
  addEventListener('pointermove', e => {
    const r = heroEl.getBoundingClientRect();
    pointerX = e.clientX - r.left; pointerY = e.clientY - r.top;
  }, { passive: true });

  const AMBIENT = Math.min(230, Math.round(W / 7));
  function respawnAmbient(p){
    p.x = Math.random() * W;
    p.y = H * 0.55 + Math.random() * H * 0.55;
    p.vx = (Math.random() - 0.5) * 4;
    p.vy = -(5 + Math.random() * 14);
    p.size = 0.4 + Math.random() * 1.2;
    p.life = 0;
    p.span = 7 + Math.random() * 9;
    p.tw = Math.random() * Math.PI * 2;
  }

  let dustPause = false;
  const dustIO = new IntersectionObserver(es => { dustPause = !es[0].isIntersecting; }, { threshold: 0 });
  dustIO.observe(heroEl);

  let prev = born;
  (function frame(now){
    if (phase === 'dead') return;
    requestAnimationFrame(frame);
    if (dustPause || !pageVisible) { prev = now; return; }
    const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
    const t = (now - born) / 1000;
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'lighter';

    if (phase === 'form') {
      for (const p of P) {
        const lp = clamp((t - p.delay) / FORM_T, 0, 1);
        const e = 1 - Math.pow(1 - lp, 3);
        const wob = (1 - e) * 14;
        const px = lerp(p.sx, p.tx, e) + Math.sin(p.tw + t * 2.1) * wob;
        const py = lerp(p.sy, p.ty, e) + Math.cos(p.tw * 1.3 + t * 1.8) * wob;
        p.x = px; p.y = py;
        const twk = 0.62 + 0.38 * Math.sin(p.tw + t * 6);
        const a = (0.12 + 0.88 * e) * twk;
        ctx.fillStyle = p.hot
          ? 'rgba(255,238,200,' + (a * 0.95) + ')'
          : 'rgba(240,196,120,' + (a * 0.8) + ')';
        const s = p.size * (p.hot ? 1.5 : 1);
        ctx.fillRect(px - s / 2, py - s / 2, s, s);
      }
      if (t > T_END + 0.35 && !released) {
        released = true;
        unveilBasmala();
        setTimeout(() => {
          phase = 'release';
          for (const p of P) {
            p.vx = (Math.random() - 0.5) * 9;
            p.vy = -(6 + Math.random() * 22);
            p.fade = 1;
            p.dur = 1.3 + Math.random() * 1.6;
          }
        }, 700);
      }
    }
    else if (phase === 'release') {
      let alive = 0;
      for (const p of P) {
        p.fade -= dt / p.dur;
        if (p.fade <= 0) continue;
        alive++;
        p.x += p.vx * dt; p.y += p.vy * dt;
        p.vy -= 2.5 * dt;
        const a = p.fade * (0.5 + 0.5 * Math.sin(p.tw + t * 5)) * 0.75;
        ctx.fillStyle = 'rgba(240,196,120,' + a + ')';
        ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
      }
      if (alive === 0) {
        phase = 'ambient';
        P.length = AMBIENT;
        P.forEach(p => { respawnAmbient(p); p.y = Math.random() * H; });
      }
    }
    else {
      for (const p of P) {
        p.life += dt;
        if (p.y < -20 || p.life > p.span) respawnAmbient(p);
        const dx = pointerX - p.x, dy = pointerY - p.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 24000 && d2 > 10) {
          const d = Math.sqrt(d2), f = (1 - d / 155) * 9 * dt;
          p.vx += (dx / d) * f; p.vy += (dy / d) * f;
        }
        p.vx *= (1 - 0.5 * dt); p.vy = clamp(p.vy - 1.2 * dt, -30, 8);
        p.x += p.vx * dt; p.y += p.vy * dt;
        const ramp = Math.min(1, p.life / 2) * Math.min(1, (p.span - p.life) / 2);
        const a = ramp * (0.10 + 0.22 * (0.5 + 0.5 * Math.sin(p.tw + t * 3.4)));
        ctx.fillStyle = 'rgba(238,196,126,' + a + ')';
        ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
      }
    }
  })(born);
}

