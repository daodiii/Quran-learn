/* ---------------------------------------------------------------
   ACT II · Constellation scrollytelling
--------------------------------------------------------------- */
const cField = $('.c-field'), cLines = $('#clines');
const cWords = $$('.cw'), cROs = $$('.ro');

function staticConstellation(){
  cWords.forEach(w => { w.style.opacity = 1; w.style.filter = 'none'; w.classList.add('lit'); });
  cROs.forEach(r => { r.style.opacity = 1; r.style.transform = 'none'; });
}

let rebuildLines = null;
function buildConstellation(){
  if (RM || !G || !window.ScrollTrigger || innerWidth < 900) { staticConstellation(); return; }

  const NS = 'http://www.w3.org/2000/svg';
  const dots = [], paths = [];
  for (let i = 0; i < 4; i++) {
    const c = document.createElementNS(NS, 'circle');
    c.setAttribute('r', '3'); c.style.opacity = 0;
    cLines.appendChild(c); dots.push(c);
    if (i > 0) {
      const p = document.createElementNS(NS, 'path');
      cLines.appendChild(p); paths.push(p);
    }
  }
  function geometry(){
    const fr = cField.getBoundingClientRect();
    cLines.setAttribute('width', fr.width); cLines.setAttribute('height', fr.height);
    const pos = cWords.map(w => {
      const r = w.getBoundingClientRect();
      return { x: r.left + r.width / 2 - fr.left, y: r.top - fr.top + r.height * 0.16 };
    });
    dots.forEach((d, i) => { d.setAttribute('cx', pos[i].x); d.setAttribute('cy', pos[i].y); });
    paths.forEach((p, i) => {
      const a = pos[i], b = pos[i + 1];
      const mx = (a.x + b.x) / 2, my = Math.min(a.y, b.y) - 46;
      p.setAttribute('d', 'M ' + a.x + ' ' + a.y + ' Q ' + mx + ' ' + my + ' ' + b.x + ' ' + b.y);
      const L = p.getTotalLength();
      p.style.strokeDasharray = L;
      if (!p.dataset.drawn) p.style.strokeDashoffset = L;
      p.dataset.len = L;
    });
  }
  geometry();
  rebuildLines = geometry;

  const tl = G.timeline({
    scrollTrigger: {
      trigger: '.constellation',
      start: 'top top',
      end: '+=1700',
      pin: '#cstage',
      scrub: 0.65,
      anticipatePin: 1
    },
    defaults: { ease: 'power2.out' }
  });

  for (let k = 0; k < 4; k++) {
    if (k > 0) {
      tl.to(paths[k - 1], {
        strokeDashoffset: 0, duration: 0.55, ease: 'none',
        onStart: function(){ paths[k - 1].dataset.drawn = 1; }
      }, '>-0.05');
    }
    tl.to(cWords[k], {
      opacity: 1, filter: 'blur(0px)', duration: 0.4,
      onStart: function(){ cWords[k].classList.add('lit'); },
      onReverseComplete: function(){ cWords[k].classList.remove('lit'); }
    }, k === 0 ? 0.1 : '>-0.1');
    tl.to(dots[k], { opacity: 0.95, duration: 0.2 }, '<');
    tl.to(cROs[k], { opacity: 1, y: 0, duration: 0.45 }, '>+0.02');
    tl.to({}, { duration: 0.18 });
  }
  tl.to({}, { duration: 0.2 });
}

/* ---------------------------------------------------------------
   ACT III · Level path drawing
--------------------------------------------------------------- */
let rebuildPath = null;
function buildPath(){
  const wrap = $('.path-wrap'), svg = $('#lpath');
  const nodes = $$('.lv-node');
  if (!nodes.length) return;

  const NS = 'http://www.w3.org/2000/svg';
  const glow = document.createElementNS(NS, 'path'); glow.setAttribute('class', 'lp-glow');
  const main = document.createElementNS(NS, 'path');
  svg.appendChild(glow); svg.appendChild(main);

  function geometry(){
    const wr = wrap.getBoundingClientRect();
    svg.setAttribute('viewBox', '0 0 ' + wr.width + ' ' + wr.height);
    const pts = nodes.map(n => {
      const r = n.getBoundingClientRect();
      return { x: r.left + r.width / 2 - wr.left, y: r.top + r.height / 2 - wr.top };
    });
    let d = 'M ' + pts[0].x + ' ' + pts[0].y;
    for (let i = 1; i < pts.length; i++) {
      const a = pts[i - 1], b = pts[i];
      d += ' C ' + a.x + ' ' + lerp(a.y, b.y, 0.55) + ' ' + b.x + ' ' + lerp(a.y, b.y, 0.45) + ' ' + b.x + ' ' + b.y;
    }
    [glow, main].forEach(p => {
      p.setAttribute('d', d);
      const L = p.getTotalLength();
      p.style.strokeDasharray = L;
      p.style.strokeDashoffset = p.dataset.done ? 0 : L;
    });
  }
  geometry();
  rebuildPath = geometry;

  if (RM || !G || !window.ScrollTrigger) {
    [glow, main].forEach(p => { p.style.strokeDashoffset = 0; p.dataset.done = 1; });
  } else {
    G.to([glow, main], {
      strokeDashoffset: 0, ease: 'none',
      scrollTrigger: { trigger: wrap, start: 'top 72%', end: 'bottom 55%', scrub: 0.7 },
      onComplete: function(){ glow.dataset.done = 1; main.dataset.done = 1; }
    });
  }
  const passIO = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('pass'); passIO.unobserve(e.target); }
  }), { threshold: 0.55 });
  $$('.level').forEach(l => passIO.observe(l));
}

/* ---------------------------------------------------------------
   Marquee band with scroll-velocity coupling
--------------------------------------------------------------- */
function buildMarquee(){
  const rows = [
    { el: $('#mq1'), dir: -1, speed: 42 },
    { el: $('#mq2'), dir: 1, speed: 26 }
  ];
  rows.forEach(r => {
    const kids = Array.from(r.el.children);
    for (let i = 0; i < 5; i++) kids.forEach(k => r.el.appendChild(k.cloneNode(true)));
    r.unit = r.el.scrollWidth / 6;
    r.x = r.dir === 1 ? -r.unit : 0;
    r.el.style.transform = 'translate3d(' + r.x + 'px,0,0)';
  });
  if (RM) return;

  let lastY = scrollY, boost = 0, prev = performance.now();
  const band = $('.band');
  let bandVisible = false;
  new IntersectionObserver(es => { bandVisible = es[0].isIntersecting; }, { rootMargin: '80px' }).observe(band);

  (function frame(now){
    requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
    if (!bandVisible || !pageVisible) { lastY = scrollY; return; }
    const dy = scrollY - lastY; lastY = scrollY;
    boost = lerp(boost, clamp(Math.abs(dy) * 0.06, 0, 3.2), 0.12);
    for (const r of rows) {
      r.x += r.dir * (r.speed * (1 + boost)) * dt;
      if (r.dir === -1 && r.x <= -r.unit) r.x += r.unit;
      if (r.dir === 1 && r.x >= 0) r.x -= r.unit;
      r.el.style.transform = 'translate3d(' + r.x + 'px,0,0)';
    }
  })(prev);
}

/* ---------------------------------------------------------------
   ACT IV · Starfield + card tilt
--------------------------------------------------------------- */
function buildStarfield(){
  const c = $('#starfield');
  const ctx = c.getContext('2d');
  if (!ctx) { c.remove(); return; }
  const sec = c.parentElement;
  let stars = [];
  function size(){
    c.width = sec.clientWidth; c.height = sec.clientHeight;
    stars = [];
    const N = LITE ? 60 : 150;
    for (let i = 0; i < N; i++) {
      stars.push({
        x: Math.random() * c.width, y: Math.random() * c.height,
        r: Math.random() < 0.25 ? 1.3 : 0.7,
        cat: i < 38,
        ph: Math.random() * Math.PI * 2,
        sp: 0.4 + Math.random() * 1.2
      });
    }
  }
  size();
  function draw(t){
    ctx.clearRect(0, 0, c.width, c.height);
    for (const s of stars) {
      const tw = RM ? 0.75 : 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(s.ph + t * s.sp));
      ctx.fillStyle = s.cat
        ? 'rgba(227,179,92,' + (0.5 * tw) + ')'
        : 'rgba(220,225,240,' + (0.28 * tw) + ')';
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r * (s.cat ? 1.35 : 1), 0, 6.2832);
      ctx.fill();
    }
  }
  if (RM) { draw(0); return; }
  let vis = false;
  new IntersectionObserver(es => { vis = es[0].isIntersecting; }, { rootMargin: '60px' }).observe(sec);
  (function frame(now){
    requestAnimationFrame(frame);
    if (!vis || !pageVisible) return;
    draw(now / 1000);
  })(0);
  let rs; addEventListener('resize', () => { clearTimeout(rs); rs = setTimeout(size, 220); });
}

function buildTilt(){
  if (!FINE || RM) return;
  $$('.card').forEach(card => {
    let raf = null;
    card.addEventListener('pointermove', e => {
      const r = card.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width, ny = (e.clientY - r.top) / r.height;
      card.style.setProperty('--mx', (nx * 100) + '%');
      card.style.setProperty('--my', (ny * 100) + '%');
      if (raf) return;
      raf = requestAnimationFrame(() => {
        card.style.transition = 'transform .18s cubic-bezier(.23,1,.32,1), border-color .5s';
        card.style.transform = 'rotateX(' + ((0.5 - ny) * 7) + 'deg) rotateY(' + ((nx - 0.5) * 9) + 'deg) translateZ(0)';
        raf = null;
      });
    });
    card.addEventListener('pointerleave', () => {
      card.style.transition = 'transform .9s cubic-bezier(.23,1,.32,1), border-color .5s';
      card.style.transform = 'rotateX(0deg) rotateY(0deg)';
    });
  });
}

/* ---------------------------------------------------------------
   ACT V · Instrument scramble
--------------------------------------------------------------- */
function scramble(el){
  const final = el.textContent;
  const CH = '!<>-_\\/[]{}=+*^?#________';
  const t0 = performance.now(), dur = 950;
  (function step(now){
    const p = clamp((now - t0) / dur, 0, 1);
    const keep = Math.floor(final.length * p);
    let out = final.slice(0, keep);
    for (let i = keep; i < final.length; i++) {
      out += final[i] === ' ' ? ' ' : CH[(Math.random() * CH.length) | 0];
    }
    el.textContent = out;
    if (p < 1) requestAnimationFrame(step);
    else el.textContent = final;
  })(t0);
}
function buildInstrument(){
  const rows = $$('[data-scramble]').filter(el => el.lang !== 'ar');
  if (RM || !rows.length) return;
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (!e.isIntersecting) return;
    io.unobserve(e.target);
    setTimeout(() => scramble(e.target), 150 + Math.random() * 300);
  }), { threshold: 0.6 });
  rows.forEach(r => io.observe(r));
}

