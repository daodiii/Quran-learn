/* ---------------------------------------------------------------
   FINAL CUT · dawn atmosphere, river of light, tree of Juz ʿAmma
--------------------------------------------------------------- */
let dawnP = 0;
function buildDawn(){
  const bg = $('#dawnbg'), sun = $('#dawnsun');
  if (!bg) return;
  const stops = [
    [0.00, [5, 7, 14],   [9, 13, 25]],
    [0.30, [7, 11, 26],  [13, 18, 38]],
    [0.55, [10, 15, 36], [24, 22, 54]],
    [0.75, [15, 21, 48], [48, 35, 64]],
    [0.90, [22, 30, 62], [88, 54, 70]],
    [1.00, [31, 43, 84], [146, 88, 74]]
  ];
  const mixv = (a, b, t) => Math.round(a + (b - a) * t);
  function col(p){
    let i = 1;
    while (i < stops.length - 1 && stops[i][0] < p) i++;
    const A = stops[i - 1], B = stops[i];
    const t = clamp((p - A[0]) / Math.max(0.0001, B[0] - A[0]), 0, 1);
    return [
      'rgb(' + A[1].map((v, k) => mixv(v, B[1][k], t)).join(',') + ')',
      'rgb(' + A[2].map((v, k) => mixv(v, B[2][k], t)).join(',') + ')'
    ];
  }
  let tick = false;
  function apply(){
    const doc = document.documentElement;
    const heroH = heroEl.clientHeight;
    dawnP = clamp((scrollY - heroH * 0.4) / Math.max(1, doc.scrollHeight - innerHeight - heroH * 0.4), 0, 1);
    const [t, b] = col(dawnP);
    bg.style.background = 'linear-gradient(180deg,' + t + ' 0%,' + b + ' 100%)';
    sun.style.opacity = clamp((dawnP - 0.6) / 0.4, 0, 1) * 0.95;
    sun.style.filter = 'blur(' + (10 - 6 * dawnP) + 'px)';
  }
  addEventListener('scroll', () => {
    if (tick) return; tick = true;
    requestAnimationFrame(() => { apply(); tick = false; });
  }, { passive: true });
  addEventListener('resize', apply);
  apply();
}

function buildDawnStars(){
  const c = $('#dawnstars');
  if (!c || LITE) { if (c) c.remove(); return; }
  const ctx = c.getContext('2d');
  if (!ctx) { c.remove(); return; }
  let W, H, layers = [];
  function size(){
    W = c.width = innerWidth; H = c.height = innerHeight;
    const mk = (n, sz, goldChance) => Array.from({ length: n }, () => ({
      x: Math.random() * W, y: Math.random() * H,
      r: sz * (0.6 + Math.random() * 0.8),
      g: Math.random() < goldChance,
      ph: Math.random() * 6.283, tw: 0.3 + Math.random() * 1.1
    }));
    layers = [{ f: 0.03, stars: mk(90, 0.6, 0.06) }, { f: 0.07, stars: mk(52, 1.0, 0.12) }];
  }
  function draw(t){
    ctx.clearRect(0, 0, W, H);
    const dim = 1 - dawnP * 0.92;
    if (dim <= 0.02) return;
    for (const L of layers) {
      const oy = scrollY * L.f;
      for (const st of L.stars) {
        const y = ((st.y - oy) % H + H) % H;
        const tw = RM ? 0.7 : 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(st.ph + t * st.tw));
        ctx.fillStyle = st.g
          ? 'rgba(227,179,92,' + (0.5 * tw * dim) + ')'
          : 'rgba(215,222,240,' + (0.3 * tw * dim) + ')';
        ctx.beginPath(); ctx.arc(st.x, y, st.r, 0, 6.2832); ctx.fill();
      }
    }
  }
  size();
  if (RM) { draw(0); return; }
  (function fr(now){ requestAnimationFrame(fr); if (!pageVisible) return; draw(now / 1000); })(0);
  let rs; addEventListener('resize', () => { clearTimeout(rs); rs = setTimeout(size, 220); });
}

function buildRiver(){
  const c = $('#river');
  if (!c || LITE || RM) { if (c) c.remove(); return; }
  const ctx = c.getContext('2d');
  if (!ctx) { c.remove(); return; }
  let W, H;
  function size(){ W = c.width = innerWidth; H = c.height = innerHeight; }
  size();
  let anchors = [];
  function computeAnchors(){
    anchors = [];
    document.querySelectorAll('.c-verse, #levels .lv-node, #treestage, .p-word .ar, .why-verse, .dua').forEach(el => {
      const r = el.getBoundingClientRect();
      anchors.push({ x: r.left + r.width / 2, y: r.top + r.height / 2 + scrollY });
    });
  }
  computeAnchors();
  if (window.ScrollTrigger) ScrollTrigger.addEventListener('refresh', computeAnchors);
  const N = Math.min(230, Math.round(innerWidth * 0.16));
  const P = Array.from({ length: N }, () => ({
    x: Math.random() * innerWidth, y: Math.random() * innerHeight,
    vx: 0, vy: 6 + Math.random() * 10,
    g: Math.random() < 0.32, sz: 0.6 + Math.random() * 1.1
  }));
  let prev = performance.now();
  (function fr(now){
    requestAnimationFrame(fr);
    if (!pageVisible) { prev = now; return; }
    const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
    ctx.globalCompositeOperation = 'destination-out';
    ctx.fillStyle = 'rgba(0,0,0,.08)';
    ctx.fillRect(0, 0, W, H);
    const cy = scrollY + innerHeight * 0.5;
    let best = null, bd = 1e18;
    for (const a of anchors) { const d = Math.abs(a.y - cy); if (d < bd) { bd = d; best = a; } }
    const tx = best ? best.x : W / 2;
    const ty = best ? clamp(best.y - scrollY, 70, H - 70) : H * 0.5;
    const t = now / 1000;
    ctx.globalCompositeOperation = 'lighter';
    for (const p of P) {
      const ang = Math.sin(p.x * 0.006 + t * 0.5) + Math.cos(p.y * 0.005 - t * 0.4) + Math.sin((p.x + p.y) * 0.003 + t * 0.22);
      p.vx += Math.cos(ang) * 30 * dt;
      p.vy += (Math.sin(ang) * 30 + 12) * dt;
      const dx = tx - p.x, dy = ty - p.y, d = Math.hypot(dx, dy) || 1;
      if (d < 560) { const pull = (1 - d / 560) * 60 * dt; p.vx += dx / d * pull; p.vy += dy / d * pull; }
      p.vx *= (1 - 1.0 * dt); p.vy *= (1 - 1.0 * dt);
      p.x += p.vx * dt * 6; p.y += p.vy * dt * 6;
      if (p.x < -12) p.x = W + 12; if (p.x > W + 12) p.x = -12;
      if (p.y < -12) p.y = H + 12; if (p.y > H + 12) p.y = -12;
      const a2 = 0.2 + 0.36 * Math.min(1, Math.hypot(p.vx, p.vy) / 70);
      ctx.fillStyle = p.g ? 'rgba(240,196,120,' + a2 + ')' : 'rgba(190,205,235,' + (a2 * 0.66) + ')';
      ctx.fillRect(p.x, p.y, p.sz, p.sz);
    }
  })(prev);
  let rs; addEventListener('resize', () => { clearTimeout(rs); rs = setTimeout(() => { size(); computeAnchors(); }, 240); });
}

function buildTree(){
  const stage = $('#treestage'), cv = $('#treecv');
  if (!stage || !cv) return;
  const ctx = cv.getContext('2d');
  if (!ctx) { cv.remove(); return; }
  const plaque = $('#plaque'), plqInner = $('#plqInner');
  const plqAr = $('#plqAr'), plqEn = $('#plqEn'), plqMeta = $('#plqMeta');
  const rootLabel = $('#treeroot');
  const TDPR = Math.min(devicePixelRatio || 1, 2);

  /* [number, name, arabicName, verseCount, href] — injected from the content collection */
  const SURAHS = JSON.parse(document.getElementById('surah-data').textContent);
  const HREFS = new Map(SURAHS.map(s => [s[0], s[4]]));
  const slug = n => HREFS.get(n) || '/surahs/';

  const MAXD = 4;
  const WIDTHS = [7, 4.4, 2.9, 1.9, 1.2];
  const ROOTW = [3.4, 2, 1.2];
  let W = 0, H = 0, GY = 0, TOPY = 0;
  let segs = [], rootSegs = [], lights = [], mist = [], leaves = [];
  const fatiha = { num: 1, name: 'Al-Fatiha', ar: SURAHS[0][2], vs: 7, root: true, hot: 0, sx: 0, sy: 0 };

  function makeRnd(seed){ let s = seed; return () => { s = (s * 16807) % 2147483647; return s / 2147483647; }; }

  function genTree(){
    for (let seed = 9; seed < 60; seed++) {
      const rnd = makeRnd(seed);
      segs = []; const tips = [];
      (function branch(x, y, ang, len, depth, parent){
        ang = lerp(ang, -Math.PI / 2, depth === 0 ? 0 : 0.14);   /* reach upward */
        const x1 = x + Math.cos(ang) * len, y1 = y + Math.sin(ang) * len;
        const perp = ang + Math.PI / 2, bow = (rnd() - 0.5) * len * (depth === 0 ? 0.2 : 0.55);
        const cx = (x + x1) / 2 + Math.cos(perp) * bow, cy = (y + y1) / 2 + Math.sin(perp) * bow;
        const id = segs.length;
        segs.push({ x0: x, y0: y, cx, cy, x1, y1, depth, parent, ph: rnd() * 6.283, id });
        if (depth >= MAXD) { tips.push(segs[id]); return; }
        const n = depth === 0 ? 3 : (rnd() < 0.5 ? 2 : 3);
        const spread = [1.05, 0.66, 0.6, 0.52][depth] || 0.5;
        for (let k = 0; k < n; k++) {
          const off = (k - (n - 1) / 2) * spread + (rnd() - 0.5) * 0.22;
          branch(x1, y1, ang + off, len * (0.6 + rnd() * 0.16), depth + 1, id);
        }
      })(0, 0, -Math.PI / 2, 1, 0, -1);
      if (tips.length >= 37) {
        tips.sort((a, b) => a.x1 - b.x1);
        const chosen = [];
        for (let i = 0; i < 37; i++) chosen.push(tips[Math.round(i * (tips.length - 1) / 36)]);
        const uniq = [...new Set(chosen)];
        if (uniq.length < 37) continue;
        lights = uniq.map((seg, i) => {
          const s = SURAHS[i + 1];
          return { seg, num: s[0], name: s[1], ar: s[2], vs: s[3],
                   R: 2.4 + Math.sqrt(s[3]) * 0.75, ph: seg.ph, hot: 0, sx: 0, sy: 0, lineage: null };
        });
        lights.forEach(L => {
          const set = new Set(); let p = L.seg;
          while (p) { set.add(p.id); p = p.parent >= 0 ? segs[p.parent] : null; }
          L.lineage = set;
        });
        break;
      }
    }
    const rr = makeRnd(31);
    rootSegs = [];
    (function root(x, y, ang, len, depth){
      const x1 = x + Math.cos(ang) * len, y1 = y + Math.sin(ang) * len;
      const perp = ang + Math.PI / 2, bow = (rr() - 0.5) * len * 0.6;
      const cx = (x + x1) / 2 + Math.cos(perp) * bow, cy = (y + y1) / 2 + Math.sin(perp) * bow;
      rootSegs.push({ x0: x, y0: y, cx, cy, x1, y1, depth });
      if (depth >= 2) return;
      const n = depth === 0 ? 4 : 2;
      for (let k = 0; k < n; k++) {
        const off = (k - (n - 1) / 2) * 0.9 + (rr() - 0.5) * 0.3;
        root(x1, y1, ang + off * 0.6, len * 0.62, depth + 1);
      }
    })(0, 0, Math.PI / 2, 0.34, 0);
  }

  function fitTree(){
    let minY = 0, minX = 0, maxX = 0;
    segs.forEach(s => { minY = Math.min(minY, s.y1); minX = Math.min(minX, s.x1); maxX = Math.max(maxX, s.x1); });
    const ky = (GY - TOPY) / (-minY || 1);
    const kx = (W * 0.62) / Math.max(0.0001, maxX - minX);
    const midX = (minX + maxX) / 2;
    /* pull the canopy mostly back to centre; the remaining 30% keeps a natural lean */
    const mapX = v => W * 0.5 + (v - midX * 0.7) * kx;
    const mapY = v => GY + v * ky;
    segs.forEach(s => {
      s.X0 = mapX(s.x0); s.Y0 = mapY(s.y0);
      s.CX = mapX(s.cx); s.CY = mapY(s.cy);
      s.X1 = mapX(s.x1); s.Y1 = mapY(s.y1);
    });
    rootSegs.forEach(s => {
      s.X0 = W * 0.5 + s.x0 * ky * 0.9; s.Y0 = GY + s.y0 * ky * 0.5;
      s.CX = W * 0.5 + s.cx * ky * 0.9; s.CY = GY + s.cy * ky * 0.5;
      s.X1 = W * 0.5 + s.x1 * ky * 0.9; s.Y1 = GY + s.y1 * ky * 0.5;
    });
    segs.forEach(s => { s.birth = s.depth * 0.5 + (s.ph % 1) * 0.24; });
    rootSegs.forEach(s => { s.birth = s.depth * 0.4; });
    lights.forEach((L, i) => { L.birth = L.seg.birth + 0.62 + i * 0.028; });
  }

  function sizeTree(){
    W = stage.clientWidth; H = stage.clientHeight;
    GY = H * 0.84; TOPY = H * 0.08;
    cv.width = W * TDPR; cv.height = H * TDPR; ctx.setTransform(TDPR, 0, 0, TDPR, 0, 0);
    genTree(); fitTree();
    const rnd = makeRnd(3);
    mist = LITE ? [] : Array.from({ length: 5 }, (_, i) => ({
      x: rnd() * W, y: GY - 6 + i * 8, rx: W * (0.14 + rnd() * 0.18), ry: 8 + rnd() * 11,
      v: (rnd() - 0.5) * 7, ph: rnd() * 6.283
    }));
    leaves = Array.from({ length: 10 }, () => ({ live: false }));
    fatiha.sx = W * 0.5; fatiha.sy = GY;
    rootLabel.style.left = (W * 0.5) + 'px';
    rootLabel.style.top = (GY + 12) + 'px';
    if (RM) drawTree(99, 0);
  }

  /* pointer */
  let tpx = -1e4, tpy = -1e4, lastMove = 0;
  stage.addEventListener('pointermove', e => {
    const r = stage.getBoundingClientRect();
    tpx = e.clientX - r.left; tpy = e.clientY - r.top;
    lastMove = performance.now();
  }, { passive: true });
  stage.addEventListener('pointerleave', () => { tpx = tpy = -1e4; });

  /* the plaque is the only reader: one fixed lockup, crossfaded */
  let sel = null, autoT = 0, swapT = null;
  function applyPlaque(L){
    plqAr.textContent = L.ar;
    plqEn.textContent = L.name;
    plqMeta.textContent = 'SURAH ' + String(L.num).padStart(3, '0') + ' · ' +
      L.vs + (L.vs === 1 ? ' VERSE' : ' VERSES') + ' · WORD BY WORD';
    plaque.href = slug(L.num, L.name);
  }
  function select(L, viaPointer){
    if (sel === L) return;
    sel = L;
    if (RM) { applyPlaque(L); }
    else {
      plqInner.classList.add('fade');
      clearTimeout(swapT);
      swapT = setTimeout(() => { applyPlaque(L); plqInner.classList.remove('fade'); }, 230);
    }
    stage.style.cursor = viaPointer ? 'pointer' : 'default';
  }
  stage.addEventListener('click', e => {
    const r = stage.getBoundingClientRect();
    const cx2 = e.clientX - r.left, cy2 = e.clientY - r.top;
    let best = null, bd = 1e18;
    for (const L of [fatiha, ...lights]) {
      const dx = cx2 - L.sx, dy = cy2 - L.sy, d2 = dx * dx + dy * dy;
      if (d2 < bd) { bd = d2; best = L; }
    }
    if (best && bd < 34 * 34) location.href = slug(best.num, best.name);
  });

  function windX(y, ph, t){
    if (RM) return 0;
    const hn = clamp((GY - y) / (GY - TOPY), 0, 1);
    return Math.sin(t * 0.75 + y * 0.004 + ph) * 7 * Math.pow(hn, 1.8);
  }
  function quad(s, u){
    const a = (1 - u) * (1 - u), b = 2 * (1 - u) * u, c = u * u;
    return [a * s.X0 + b * s.CX + c * s.X1, a * s.Y0 + b * s.CY + c * s.Y1];
  }
  function drawSeg(s, T, t, inLine, isRoot){
    const p = clamp((T - s.birth) / 0.6, 0, 1);
    if (p <= 0) return;
    const wArr = isRoot ? ROOTW : WIDTHS;
    const w = (wArr[s.depth] || 1) + (inLine ? 0.7 : 0);
    const alpha = isRoot ? 0.26 : (0.5 + 0.28 * (1 - s.depth / MAXD)) * (inLine ? 1.35 : 1);
    const col = inLine ? 'rgba(244,214,143,' : 'rgba(227,179,92,';
    const passes = inLine
      ? [[w + 4, 'rgba(244,214,143,.16)'], [w, col + Math.min(1, alpha) + ')']]
      : [[w, col + alpha + ')']];
    for (const [lw, style] of passes) {
      ctx.strokeStyle = style; ctx.lineWidth = lw; ctx.lineCap = 'round';
      ctx.beginPath();
      const steps = 7;
      for (let k = 0; k <= steps; k++) {
        const u = (k / steps) * p;
        let [x, y] = quad(s, u);
        if (!isRoot) x += windX(y, s.ph, t);
        k === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
  }

  function drawTree(T, t){
    ctx.clearRect(0, 0, W, H);

    /* crescent, high in the section's sky */
    ctx.globalCompositeOperation = 'lighter';
    const mx = W * 0.76, my = H * 0.13, mr = Math.min(W, H) * 0.042;
    const mg = ctx.createRadialGradient(mx, my, 0, mx, my, mr * 4);
    mg.addColorStop(0, 'rgba(240,235,215,.10)'); mg.addColorStop(1, 'rgba(240,235,215,0)');
    ctx.fillStyle = mg; ctx.beginPath(); ctx.arc(mx, my, mr * 4, 0, 6.2832); ctx.fill();
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = 'rgba(238,232,210,.85)';
    ctx.beginPath(); ctx.arc(mx, my, mr, 0, 6.2832); ctx.fill();
    ctx.globalCompositeOperation = 'destination-out';   /* punch the shadow through to the page sky */
    ctx.beginPath(); ctx.arc(mx - mr * 0.42, my - mr * 0.14, mr * 0.88, 0, 6.2832); ctx.fill();
    ctx.globalCompositeOperation = 'source-over';

    /* ground line */
    const gl = ctx.createLinearGradient(0, 0, W, 0);
    gl.addColorStop(0, 'rgba(228,209,164,0)');
    gl.addColorStop(0.5, 'rgba(228,209,164,.24)');
    gl.addColorStop(1, 'rgba(228,209,164,0)');
    ctx.strokeStyle = gl; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, GY); ctx.lineTo(W, GY); ctx.stroke();

    const lineage = sel && sel.lineage ? sel.lineage : null;
    for (const s of rootSegs) drawSeg(s, T, t, false, true);
    for (const s of segs) drawSeg(s, T, t, lineage ? lineage.has(s.id) : false, false);

    /* basin glow + Al-Fatiha at the root */
    ctx.globalCompositeOperation = 'lighter';
    const fb = RM ? 1 : 1 + 0.05 * Math.sin(t * 1.1);
    fatiha.hot = lerp(fatiha.hot, (sel === fatiha) ? 1 : 0, RM ? 1 : 0.08);
    const FR = 11 * (1 + 0.3 * fatiha.hot) * fb;
    const bg2 = ctx.createRadialGradient(W * 0.5, GY, 0, W * 0.5, GY, FR * 7);
    bg2.addColorStop(0, 'rgba(244,204,124,' + (0.28 + 0.2 * fatiha.hot) + ')');
    bg2.addColorStop(0.5, 'rgba(227,179,92,.10)');
    bg2.addColorStop(1, 'rgba(227,179,92,0)');
    ctx.fillStyle = bg2;
    ctx.beginPath(); ctx.ellipse(W * 0.5, GY, FR * 7, FR * 3.2, 0, 0, 6.2832); ctx.fill();
    const cg = ctx.createRadialGradient(W * 0.5, GY, 0, W * 0.5, GY, FR * 2);
    cg.addColorStop(0, 'rgba(255,244,216,.98)');
    cg.addColorStop(0.5, 'rgba(244,214,143,.5)');
    cg.addColorStop(1, 'rgba(244,214,143,0)');
    ctx.fillStyle = cg;
    ctx.beginPath(); ctx.arc(W * 0.5, GY, FR * 2, 0, 6.2832); ctx.fill();

    /* mist over the ground */
    if (!RM) for (const m of mist) {
      m.x += m.v / 60;
      if (m.x < -m.rx) m.x = W + m.rx; if (m.x > W + m.rx) m.x = -m.rx;
      const a = 0.045 + 0.02 * Math.sin(m.ph + t * 0.4);
      const g = ctx.createRadialGradient(m.x, m.y, 0, m.x, m.y, m.rx);
      g.addColorStop(0, 'rgba(200,200,215,' + a + ')'); g.addColorStop(1, 'rgba(200,200,215,0)');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.ellipse(m.x, m.y, m.rx, m.ry, 0, 0, 6.2832); ctx.fill();
    }

    /* canopy lights */
    for (const L of lights) {
      const wx = windX(L.seg.Y1, L.seg.ph, t);
      L.sx = L.seg.X1 + wx; L.sy = L.seg.Y1;
    }
    let near = null, nd = 1e18;
    for (const L of [fatiha, ...lights]) {
      const dx = tpx - L.sx, dy = tpy - L.sy, d2 = dx * dx + dy * dy;
      if (d2 < nd) { nd = d2; near = L; }
    }
    if (nd < 48 * 48) select(near, true);
    else if (tpx > -9000) stage.style.cursor = 'default';

    for (const L of lights) {
      const la = clamp((T - L.birth) / 0.5, 0, 1);
      if (la <= 0) continue;
      L.hot = lerp(L.hot, L === sel ? 1 : 0, RM ? 1 : 0.09);
      const tw = RM ? 0.85 : 0.72 + 0.28 * Math.sin(L.ph + t * (0.7 + (L.ph % 0.9)));
      const R = L.R * (1 + 0.5 * L.hot);
      const glowR = R * (4.6 + 2.6 * L.hot);
      const g = ctx.createRadialGradient(L.sx, L.sy, 0, L.sx, L.sy, glowR);
      g.addColorStop(0, 'rgba(244,214,143,' + ((0.30 + 0.34 * L.hot) * tw * la) + ')');
      g.addColorStop(1, 'rgba(244,214,143,0)');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(L.sx, L.sy, glowR, 0, 6.2832); ctx.fill();
      ctx.fillStyle = 'rgba(252,240,212,' + ((0.8 + 0.2 * tw) * la) + ')';
      ctx.beginPath(); ctx.arc(L.sx, L.sy, R, 0, 6.2832); ctx.fill();
      if (L.hot > 0.15) {
        const sp = R * (2.6 + 2.4 * L.hot);
        ctx.strokeStyle = 'rgba(255,240,205,' + (0.5 * L.hot * tw) + ')';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(L.sx - sp, L.sy); ctx.lineTo(L.sx + sp, L.sy);
        ctx.moveTo(L.sx, L.sy - sp); ctx.lineTo(L.sx, L.sy + sp);
        ctx.stroke();
      }
      if (L.hot > 0.03) {
        const rr = R + 7 + 20 * (1 - L.hot);
        ctx.strokeStyle = 'rgba(227,179,92,' + (0.6 * L.hot) + ')';
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(L.sx, L.sy, rr, t * 0.8, t * 0.8 + 1.6); ctx.stroke();
        ctx.beginPath(); ctx.arc(L.sx, L.sy, rr, t * 0.8 + 3.14, t * 0.8 + 4.74); ctx.stroke();
      }
    }

    /* falling light-leaves */
    if (!RM && T > 3) {
      for (const lf of leaves) {
        if (!lf.live) {
          if (Math.random() < 0.006) {
            const src = lights[(Math.random() * lights.length) | 0];
            lf.live = true; lf.x = src.sx; lf.y = src.sy; lf.vy = 14 + Math.random() * 12;
            lf.ph = Math.random() * 6.283; lf.life = 0; lf.span = 4 + Math.random() * 3; lf.s = 1.2 + Math.random() * 1.2;
          }
          continue;
        }
        lf.life += 1 / 60;
        lf.y += lf.vy / 60; lf.x += Math.sin(lf.ph + t * 1.6) * 0.5;
        if (lf.y > GY || lf.life > lf.span) { lf.live = false; continue; }
        const a = Math.min(1, lf.life / 0.5) * Math.min(1, (lf.span - lf.life) / 0.8) * 0.5;
        ctx.fillStyle = 'rgba(240,205,135,' + a + ')';
        ctx.fillRect(lf.x, lf.y, lf.s, lf.s);
      }
    }
  }

  /* idle auto-tour: the tree reads itself while you watch */
  function autoTour(now){
    if (RM) return;
    if (now - lastMove < 4200) return;
    if (now - autoT < 3600) return;
    autoT = now;
    const pool = [fatiha, ...lights];
    select(pool[(Math.random() * pool.length) | 0], false);
  }

  /* grow when the section arrives on screen */
  let treeVisible = false, grown = RM, T0g = 0;
  new IntersectionObserver(es => {
    treeVisible = es[0].isIntersecting;
    if (treeVisible && !grown) { grown = true; T0g = performance.now(); }
  }, { threshold: 0.3 }).observe(stage);

  sizeTree();
  sel = fatiha; applyPlaque(fatiha);
  if (RM) {
    stage.addEventListener('pointermove', () => drawTree(99, 0), { passive: true });
    drawTree(99, 0);
  } else {
    (function frame(now){
      requestAnimationFrame(frame);
      if (!treeVisible || !pageVisible) return;
      drawTree(grown ? (now - T0g) / 1000 : 0, now / 1000);
      autoTour(now);
    })(performance.now());
  }
  let trs; addEventListener('resize', () => { clearTimeout(trs); trs = setTimeout(sizeTree, 240); });
}

/* the dua ignites when you arrive */
(function(){
  const dua = document.querySelector('.dua');
  const fin = document.querySelector('.finale');
  if (!dua || !fin) return;
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { dua.classList.add('arrive'); io.disconnect(); }
  }), { threshold: 0.5 });
  io.observe(fin);
})();

/* ---------------------------------------------------------------
   Boot: geometry-dependent builds wait for fonts
--------------------------------------------------------------- */
let bootDone = false;
function boot(){
  if (bootDone) return; bootDone = true;
  buildConstellation();
  buildPath();
  buildMarquee();
  buildDawn();
  buildDawnStars();
  buildRiver();
  buildTree();
  buildTilt();
  buildInstrument();
  buildEmbers();
  buildMagnetic();
  buildParallax();
  if (G && window.ScrollTrigger) ScrollTrigger.refresh();
}
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(() => setTimeout(boot, 80));
  setTimeout(boot, 3600);
} else {
  addEventListener('load', boot);
  setTimeout(boot, 3600);
}

let rszAll;
addEventListener('resize', () => {
  clearTimeout(rszAll);
  rszAll = setTimeout(() => {
    fitVerse();
    if (rebuildLines) rebuildLines();
    if (rebuildPath) rebuildPath();
    if (G && window.ScrollTrigger) ScrollTrigger.refresh();
  }, 240);
});
})();
</script>
