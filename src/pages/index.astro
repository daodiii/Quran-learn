---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/primitives/Button.astro';
import CardGrid from '../components/cards/CardGrid.astro';
import SurahCard from '../components/cards/SurahCard.astro';
import ResumeBand from '../components/ResumeBand.astro';
import GoldCalligraphy from '../components/decoration/GoldCalligraphy.astro';
import AnnouncementTicker from '../components/AnnouncementTicker.astro';
import FaqSchema from '../components/seo/FaqSchema.astro';
import { getCollection } from 'astro:content';
import { testimonials } from '../data/testimonials';

const faqItems = [
  {
    question: 'How long does it take to learn Quranic Arabic grammar?',
    answer:
      'Most learners reach functional comprehension of common Quranic structures within 6 to 12 months of consistent study (around 30 minutes a day). The full curriculum here is 81 lessons across 5 levels. Levels 1 and 2 (alphabet, vowels, sentence types, and the three I’rab cases) typically take 2–3 months. Levels 3 and 4 (verb forms I–X, weak verbs, and advanced syntax) take another 4–6 months. Level 5 applies everything to the Quran itself. The journey continues for years — but you will start understanding verses you recite from your first month.',
  },
  {
    question: 'What is the difference between Sarf and Nahw?',
    answer:
      'Sarf (صَرْف) is morphology — how Arabic words are built from roots using patterns. It studies verb forms (Forms I–X), conjugations, participles, and verbal nouns. Nahw (نَحْو) is syntax — how words combine into sentences. It studies I’rab cases (Marfuʻ, Mansub, Majrur), sentence types, idafa, and grammatical roles. You need both: Sarf tells you what a word is, Nahw tells you what it does in the sentence. Levels 1–2 here focus mainly on Nahw; Level 3 introduces Sarf; Levels 4–5 weave them together.',
  },
  {
    question: 'Do I need to learn Modern Standard Arabic first?',
    answer:
      'No. You can study Quranic Arabic directly without learning Modern Standard Arabic (MSA) first. Quranic Arabic is the older, classical register of the language; MSA is the modern simplification used in newspapers and broadcasts. Their grammar overlaps heavily, but Quranic Arabic preserves richer case-ending markers, more verb forms in active use, and a different vocabulary register. If your goal is to understand the Quran in its own words, study Quranic Arabic directly — you will pick up enough MSA along the way to read modern texts if you ever need to.',
  },
  {
    question: 'What is I’rab and why does it matter?',
    answer:
      'I’rab (إِعْرَاب) is the Arabic system of case endings that mark a word’s grammatical role. The three cases are Marfuʻ (nominative — subjects), Mansub (accusative — direct objects and predicates of inna), and Majrur (genitive — after prepositions and in idafa constructions). I’rab matters because a single vowel change can flip the meaning of a verse: who is doing what to whom is encoded in the case endings. Translation strips this layer out; understanding I’rab restores the precision of the original text.',
  },
  {
    question: 'How is Quranic Arabic different from spoken Arabic dialects?',
    answer:
      'Spoken dialects (Egyptian, Levantine, Gulf, Maghrebi) drop most case endings, restructure sentences, and use vocabulary that has drifted far from the classical register. Knowing a dialect helps with pronunciation but does not give you Quranic comprehension. Quranic Arabic is closer to literary Classical Arabic than to any modern dialect. If you only know a dialect, expect Quranic Arabic to feel like a related but distinct language — the same way Latin relates to Italian.',
  },
  {
    question: 'Is this course really free?',
    answer:
      'Yes. Every lesson, every surah breakdown, every resource on this site is free, with no signup required and no ads. The goal is to make a structured, technically rigorous Quranic Arabic curriculum publicly available. Your progress is stored locally in your browser — there is no account, no email collection, and nothing tracked beyond standard analytics.',
  },
];

// Get all lessons to count them (exclude _index pages)
const allLessons = await getCollection('lessons');
const totalLessons = allLessons.filter(l => !l.id.endsWith('_index')).length;

// Get all surahs to count them
const allSurahs = await getCollection('surahs');
const totalSurahs = allSurahs.length;

// Group lessons by level for featured courses
const levelGroups = [
  {
    num: 1,
    title: 'Foundation',
    titleAr: 'الأساسيات',
    desc: 'Arabic alphabet, vowels, basic word structure, pronouns, and sentence types.',
  },
  {
    num: 2,
    title: 'Core Grammar',
    titleAr: 'القواعد الأساسية',
    desc: 'Nominal and verbal sentences, I\'rab cases, Idafah, prepositions, and adjectives.',
  },
  {
    num: 3,
    title: 'Intermediate',
    titleAr: 'القواعد المتوسطة',
    desc: 'Full verb conjugations, Verb Forms I-X, active/passive participles, passive voice.',
  },
  {
    num: 4,
    title: 'Advanced',
    titleAr: 'القواعد المتقدمة',
    desc: 'Hal, Tamyeez, conditional sentences, exception, emphasis, vocative structures.',
  },
  {
    num: 5,
    title: 'Applied Study',
    titleAr: 'التطبيق القرآني',
    desc: 'Quranic sentence patterns, recognizing I\'rab in verses, rhetorical devices.',
  },
] as const;

// Count lessons per level
const lessonCounts = await Promise.all(
  levelGroups.map(async (level) => {
    const lessons = await getCollection('lessons', ({ data }) => data.level === level.num);
    return lessons.length;
  })
);

// Curriculum-ordered manifest for the ResumeBand (continue affordance)
const sortedLessons = allLessons
  .filter(l => !l.id.endsWith('_index'))
  .sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);
const resumeManifest = sortedLessons.map(l =>
  ({ id: l.id, title: l.data.title, level: l.data.level, order: l.data.order }));
const resumeTotals = Object.fromEntries(
  levelGroups.map((level, i) => [level.num, lessonCounts[i]]));

const featuredSurahs = [
  { name: 'Al-Fatiha', nameAr: 'الفاتحة', num: 1, verses: 7, slug: '001-al-fatiha', difficulty: 'beginner' as const },
  { name: 'Al-Ikhlas', nameAr: 'الإخلاص', num: 112, verses: 4, slug: '112-al-ikhlas', difficulty: 'beginner' as const },
  { name: 'Al-Falaq', nameAr: 'الفلق', num: 113, verses: 5, slug: '113-al-falaq', difficulty: 'beginner' as const },
  { name: 'An-Nas', nameAr: 'الناس', num: 114, verses: 6, slug: '114-an-nas', difficulty: 'beginner' as const },
];

const features = [
  {
    titleAr: 'إعراب',
    title: 'I\'rab (Case Endings)',
    desc: 'Marfu\', Mansub, Majrur - understand why every word has the ending it does.',
  },
  {
    titleAr: 'أفعال',
    title: 'Verb Forms I-X',
    desc: 'All ten verb forms with patterns, meanings, and Quranic examples.',
  },
  {
    titleAr: 'جملة',
    title: 'Sentence Structure',
    desc: 'Nominal and verbal sentences, Idafah constructions, and complex clauses.',
  },
  {
    titleAr: 'قرآن',
    title: 'Applied Analysis',
    desc: 'Full grammatical breakdown of surahs with word-by-word analysis.',
  },
];
---

<BaseLayout title="Home" description="Free structured course for learning Quranic Arabic grammar. 81 lessons across 5 levels, from alphabet basics to full I'rab analysis, plus word-by-word surah breakdowns.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Quranic Grammar",
      "url": "https://www.quranic-grammar.com/",
      "description": "Learn Quranic Arabic grammar from beginner to advanced. Comprehensive lessons, verb forms, and detailed surah breakdowns.",
      "inLanguage": "en",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.quranic-grammar.com/search/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />
    <FaqSchema items={faqItems} />
  </Fragment>
  <AnnouncementTicker slot="before-header" />

  <!-- World-Class Hero Section -->
  <section class="hero-new">
    <div class="hero-overlay"></div>
    <div class="hero-shimmer" aria-hidden="true"></div>
    <div class="hero-orbs" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <div class="hero-container-new">
      <div class="hero-grid-new">
        <div class="hero-content-new">
          <h1 class="hero-title-new">
            Elevate your understanding by mastering the <span class="text-gradient-gold">language of the noble Quran</span>
          </h1>

          <div class="hero-stats">
            <div class="hero-stat">
              <span class="hero-stat-number">{levelGroups.length}</span>
              <span class="hero-stat-label">Levels</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
              <span class="hero-stat-number">{totalLessons}</span>
              <span class="hero-stat-label">Lessons</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat">
              <span class="hero-stat-number">{totalSurahs}</span>
              <span class="hero-stat-label">Surah Breakdowns</span>
            </div>
            <div class="hero-stat-divider"></div>
            <div class="hero-stat hero-stat-free">
              <span class="hero-stat-number">100%</span>
              <span class="hero-stat-label">Free</span>
            </div>
          </div>

          <div class="hero-actions-new">
            <Button href="/learn/level-1/01-arabic-script-vowels/" variant="gold" size="md" class="btn-world-class">
              Enter the Journey
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" class="icon-arrow">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/>
              </svg>
            </Button>
            <a href="#importance" class="hero-secondary-link">
              Why Grammar?
            </a>
          </div>
        </div>

        <div class="hero-visual-new">
          <GoldCalligraphy />
        </div>
      </div>
    </div>

    <div class="hero-scroll-indicator">
      <div class="mouse">
        <div class="wheel"></div>
      </div>
    </div>
  </section>

  <!-- Importance Section -->
  <section id="importance" class="importance-section mesh-bg mesh-bg-secondary">
    <div class="container">
      <div class="importance-grid">
        <div class="importance-content">
          <h2 class="importance-title">Why Quranic <span class="text-accent">Grammar?</span></h2>
          <div class="importance-narrative">
            <p>
              The Quran was revealed in "Clear Arabic" (Lisanun Arabiyyun Mubeen). Its grammar is not merely a set of rules, but the very vessel through which Allah chose to communicate His final message to humanity.
            </p>
            <p>
              Understanding <span class="text-bold">Sarf</span> (Morphology) and <span class="text-bold">Nahw</span> (Syntax) transforms your relationship with the verses. It turns a surface-level reading into a profound intellectual and spiritual experience.
            </p>
          </div>
          
          <ol class="importance-list">
            <li>
              <span class="il-num" aria-hidden="true">1</span>
              <div class="il-text">
                <h3>Preserve Meaning</h3>
                <p>A single vowel change in I'rab can alter the entire theological meaning of a verse.</p>
              </div>
            </li>
            <li>
              <span class="il-num" aria-hidden="true">2</span>
              <div class="il-text">
                <h3>Connect Heart & Mind</h3>
                <p>When you understand the grammar, the Quran speaks directly to your intellect.</p>
              </div>
            </li>
            <li>
              <span class="il-num" aria-hidden="true">3</span>
              <div class="il-text">
                <h3>Direct Dialogue</h3>
                <p>Bypass the limitations of translations and converse with the Text in its original depth.</p>
              </div>
            </li>
            <li>
              <span class="il-num" aria-hidden="true">4</span>
              <div class="il-text">
                <h3>Appreciate Eloquence</h3>
                <p>Recognize the Balaghah (Rhetoric) and divine selection of every particle and word.</p>
              </div>
            </li>
            <li>
              <span class="il-num" aria-hidden="true">5</span>
              <div class="il-text">
                <h3>Understanding the Miracles of the Quran</h3>
                <p>Why no one has been able to replicate the Quran for over 1400 years.</p>
              </div>
            </li>
          </ol>
        </div>
        <div class="importance-visual">
          <div class="visual-card">
            <div class="visual-arabic">لِسَانٌ عَرَبِيٌّ مُبِينٌ</div>
            <div class="visual-label">Clear Arabic Speech</div>
          </div>
          <div class="visual-decoration"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section mesh-bg mesh-bg-primary">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">The Learning Path</h2>
        <p class="section-subtitle">A structured journey through 5 comprehensive levels of Quranic Arabic mastery.</p>
      </div>

      <ol class="journey-band" aria-label="The five levels in order">
        {levelGroups.map((level, index) => (
          <li class="journey-node">
            <a href={`/learn/#level-${level.num}`} class="journey-link">
              <span class="journey-circle" style={`background: var(--level-${level.num}-bg); color: var(--level-${level.num}-text);`}>{level.num}</span>
              <span class="journey-name">{level.title}</span>
              <span class="journey-count">{lessonCounts[index]} lessons</span>
            </a>
          </li>
        ))}
      </ol>

      <ResumeBand manifest={resumeManifest} totals={resumeTotals} />

      <div class="section-cta">
        <Button href="/learn/" variant="gold" size="md">
          View the full curriculum
        </Button>
      </div>
    </div>
  </section>

  <!-- Featured Surahs Section -->
  <section class="section section-alt mesh-bg mesh-bg-secondary">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Surah Breakdowns</h2>
        <p class="section-subtitle">Word-by-word grammatical analysis of Quranic chapters</p>
      </div>

      <CardGrid minCardWidth={280} gap="md">
        {featuredSurahs.map(surah => (
          <SurahCard
            name={surah.name}
            nameArabic={surah.nameAr}
            number={surah.num}
            verseCount={surah.verses}
            difficulty={surah.difficulty}
            href={`/surahs/${surah.slug}/`}
          />
        ))}
      </CardGrid>

      <div class="section-cta">
        <Button href="/surahs/" variant="gold" size="sm">
          Explore All Breakdown Chapters
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" class="icon-arrow">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </Button>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section mesh-bg mesh-bg-primary">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">What You'll Master</h2>
      </div>

      <div class="features-grid">
        {features.map(feature => (
          <div class="feature-card">
            <div class="feature-icon">
              <span class="arabic">{feature.titleAr}</span>
            </div>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-desc">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  {testimonials.length > 0 && (
    <section class="section section-alt mesh-bg mesh-bg-secondary">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">What Learners Say</h2>
          <p class="section-subtitle">Hear from students on their journey to understanding the Quran.</p>
        </div>

        <div class="testimonials-grid">
          {testimonials.map((t) => (
            <div class="testimonial-card">
              <svg class="quote-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.3 2.6C6 5.1 2.4 9.9 2.4 15.2c0 3.3 2.1 5.4 4.6 5.4 2.3 0 4.2-1.8 4.2-4.1 0-2.2-1.6-3.9-3.7-4.1.4-2.6 2.5-5.3 5.3-6.8L11.3 2.6zm10.7 0c-5.3 2.5-8.9 7.3-8.9 12.6 0 3.3 2.1 5.4 4.6 5.4 2.3 0 4.2-1.8 4.2-4.1 0-2.2-1.6-3.9-3.7-4.1.4-2.6 2.5-5.3 5.3-6.8L22 2.6z"/>
              </svg>
              <p class="testimonial-text">{t.text}</p>
              <div class="testimonial-author">
                <span class="testimonial-name">{t.name}</span>
                {t.role && <span class="testimonial-role">{t.role}</span>}
              </div>
            </div>
          ))}
        </div>

        <div class="section-cta">
          <Button href="/about/#feedback" variant="gold" size="sm">
            Share Your Experience
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  <section class="section mesh-bg mesh-bg-primary" id="faq" aria-labelledby="faq-heading">
    <div class="container faq-container">
      <div class="section-header">
        <h2 id="faq-heading" class="section-title">Frequently Asked <span class="text-accent">Questions</span></h2>
        <p class="section-subtitle">Quick answers about the curriculum, prerequisites, and what to expect from your study.</p>
      </div>

      <div class="faq-list">
        {faqItems.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-question">
              <span>{item.question}</span>
              <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* New World-Class Hero Section */
  .hero-new {
    position: relative;
    padding-block: 3rem 1.5rem;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #000000 0%, #1a1a1a 40%, #0a0a0a 100%);
    color: #ffffff;
    overflow: hidden;
  }

  .hero-new::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/patterns/geometric-star.svg');
    background-size: 120px;
    opacity: 0.06;
    z-index: 0;
    pointer-events: none;
  }

  .hero-new::after {
    content: '';
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(184, 134, 11, 0.18) 0%, transparent 70%);
    animation: driftGlow 12s ease-in-out infinite alternate;
    z-index: 0;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .hero-new {
      padding-block: 2.5rem 2rem;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.6) 50%, rgba(0, 0, 0, 0.35) 100%);
    z-index: 1;
  }

  /* Diagonal gold shimmer sweep */
  .hero-shimmer {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-shimmer::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 40%,
      rgba(184, 134, 11, 0.04) 45%,
      rgba(212, 168, 73, 0.07) 50%,
      rgba(184, 134, 11, 0.04) 55%,
      transparent 60%
    );
    animation: shimmerSweep 8s ease-in-out infinite;
  }

  /* Floating gold orbs */
  .hero-orbs {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .orb-1 {
    width: 500px;
    height: 500px;
    top: -10%;
    right: -5%;
    background: radial-gradient(circle, rgba(184, 134, 11, 0.12) 0%, rgba(212, 168, 73, 0.04) 40%, transparent 70%);
    animation: floatOrb1 16s ease-in-out infinite;
  }

  .orb-2 {
    width: 350px;
    height: 350px;
    bottom: -15%;
    left: 10%;
    background: radial-gradient(circle, rgba(242, 217, 140, 0.08) 0%, rgba(184, 134, 11, 0.03) 40%, transparent 70%);
    animation: floatOrb2 20s ease-in-out infinite;
  }

  .orb-3 {
    width: 250px;
    height: 250px;
    top: 40%;
    left: 45%;
    background: radial-gradient(circle, rgba(212, 168, 73, 0.10) 0%, transparent 60%);
    animation: floatOrb3 14s ease-in-out infinite;
  }

  @keyframes shimmerSweep {
    0% { transform: translateX(-30%) translateY(-10%); }
    50% { transform: translateX(30%) translateY(10%); }
    100% { transform: translateX(-30%) translateY(-10%); }
  }

  @keyframes driftGlow {
    0% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
    50% { transform: translate(-45%, -55%) scale(1.15); opacity: 1; }
    100% { transform: translate(-55%, -45%) scale(1.05); opacity: 0.8; }
  }

  @keyframes floatOrb1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-30px, 20px) scale(1.1); }
    66% { transform: translate(15px, -15px) scale(0.95); }
  }

  @keyframes floatOrb2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(25px, -20px) scale(1.08); }
    70% { transform: translate(-10px, 15px) scale(0.92); }
  }

  @keyframes floatOrb3 {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.6; }
    50% { transform: translate(-20px, -25px) scale(1.2); opacity: 1; }
  }

  .hero-container-new {
    max-inline-size: 90rem;
    margin-inline: auto;
    padding-inline: var(--spacing-lg);
    position: relative;
    z-index: 2;
    inline-size: 100%;
  }

  .hero-grid-new {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid-new {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .hero-content-new {
    animation: fadeInUp 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Gold Calligraphy Container */
  .hero-visual-new {
    display: none;
    justify-content: center;
    align-items: center;
    align-self: start;
    perspective: 1000px;
    animation: fadeInScale 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 1024px) {
    .hero-visual-new {
      display: flex;
    }
  }

  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  .hero-title-new {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.08;
    margin-block-end: var(--spacing-md);
    letter-spacing: -0.03em;
    color: #ffffff;
    max-width: 900px;
  }

  .text-gradient-gold {
    background: linear-gradient(135deg, #F2D98C 0%, #D4A849 40%, #B8860B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(184, 134, 11, 0.4));
  }

