<canvas id="river" aria-hidden="true"></canvas>
<div id="dawnsun" aria-hidden="true"></div>

<main id="main-content">

<!-- ═══════════════ ACT I · THE NIGHT ═══════════════ -->
<section class="hero" id="top" aria-label="Introduction">
  <canvas id="gl" aria-hidden="true"></canvas>
  <canvas id="dust" aria-hidden="true"></canvas>

  <div class="hero-inner">
    <p class="basmala veiled" id="basmala" lang="ar" dir="rtl" translate="no"><span class="bl"><span class="bw" data-tr="bismi" data-en="In the name of">بِسْمِ</span> <span class="bw" data-tr="Allāhi" data-en="Allah">اللَّهِ</span> <span class="bw" data-tr="al-raḥmāni" data-en="The Most Gracious">الرَّحْمَـٰنِ</span> <span class="bw" data-tr="al-raḥīmi" data-en="The Most Merciful">الرَّحِيمِ</span></span></p>
    <div id="gloss" role="status" aria-live="polite"></div>

    <div class="ornament" aria-hidden="true" data-reveal>
      <span class="ln"></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 2l2.2 5.6L20 9l-4.6 4 1.4 6L12 15.8 7.2 19l1.4-6L4 9l5.8-1.4z" stroke-linejoin="round"/></svg>
      <span class="ln"></span>
    </div>

    <h1 class="hero-h1" id="h1"><span class="hw" data-reveal>Understand</span> <span class="hw" data-reveal>every</span> <span class="hw" data-reveal>word</span> <span style="white-space:nowrap"><span class="hw" data-reveal>you</span> <span class="hw" data-reveal>recite.</span></span></h1>

    <p class="hero-lede" data-reveal>Free, complete lessons in Quranic Arabic grammar. Learn the cases, the verb forms, and the sentence patterns, then watch them light up in the verses you already know by heart.</p>

    <div class="cta-row" data-reveal>
      <a class="btn btn-primary" href="/learn/" data-magnetic>Begin Level 1 <span class="arr" aria-hidden="true">&rarr;</span></a>
      <a class="btn btn-ghost" href="/surahs/">Explore the surahs</a>
    </div>

    <div class="hero-stats" data-reveal>
      <div class="stat"><b data-count="5">0</b><span>levels</span></div>
      <div class="stat"><b data-count="81">0</b><span>lessons</span></div>
      <div class="stat"><b data-count="38">0</b><span>surah analyses</span></div>
      <div class="stat"><b>free</b><span>no sign-up, no ads</span></div>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true"><span>scroll</span><span class="line"></span></div>
</section>

<!-- ═══════════════ ACT II · THE CONSTELLATION ═══════════════ -->
<section class="constellation" id="constellation" aria-label="A verse, analysed word by word">
  <div class="c-stage" id="cstage">
    <div class="c-head">
      <h2 data-reveal>Open the <span class="em">meaning</span> of each verse.</h2>
      <p class="sub" data-reveal>Surah Al-Ikhlas, first verse. Read it the way a grammarian reads it: word by word, role by role, until the structure appears like a constellation.</p>
    </div>

    <div class="c-field">
      <svg id="clines" aria-hidden="true"></svg>
      <p class="c-verse" id="cverse" lang="ar" dir="rtl" translate="no"><span class="cw" data-w="0">قُلْ</span><span class="cw" data-w="1">هُوَ</span><span class="cw" data-w="2">اللَّهُ</span><span class="cw" data-w="3">أَحَدٌ</span></p>
    </div>

    <div class="c-readouts" id="creadouts">
      <div class="ro" data-w="0">
        <div class="ro-top"><span class="ro-tr">qul</span><span class="ro-en">Say</span></div>
        <dl>
          <div class="row"><dt>ROLE</dt><dd><i>fiʿl amr</i>, command verb</dd></div>
          <div class="row"><dt>ROOT</dt><dd><span lang="ar" dir="rtl">ق و ل</span></dd></div>
          <div class="row"><dt>STATE</dt><dd><i>mabnī</i>, fixed form</dd></div>
        </dl>
      </div>
      <div class="ro" data-w="1">
        <div class="ro-top"><span class="ro-tr">huwa</span><span class="ro-en">He</span></div>
        <dl>
          <div class="row"><dt>ROLE</dt><dd><i>ḍamīr</i>, pronoun</dd></div>
          <div class="row"><dt>FUNCTION</dt><dd><i>mubtadaʾ</i>, subject</dd></div>
          <div class="row"><dt>CASE</dt><dd><i>marfūʿ</i></dd></div>
        </dl>
      </div>
      <div class="ro" data-w="2">
        <div class="ro-top"><span class="ro-tr">Allāhu</span><span class="ro-en">Allah</span></div>
        <dl>
          <div class="row"><dt>ROLE</dt><dd><i>ism ʿalam</i>, proper noun</dd></div>
          <div class="row"><dt>CASE</dt><dd><i>marfūʿ</i></dd></div>
          <div class="row"><dt>MARK</dt><dd>ḍamma on the final letter</dd></div>
        </dl>
      </div>
      <div class="ro" data-w="3">
        <div class="ro-top"><span class="ro-tr">aḥadun</span><span class="ro-en">One</span></div>
        <dl>
          <div class="row"><dt>ROLE</dt><dd>noun</dd></div>
          <div class="row"><dt>FUNCTION</dt><dd><i>khabar</i>, predicate</dd></div>
          <div class="row"><dt>CASE</dt><dd><i>marfūʿ</i>, with <i>tanwīn</i></dd></div>
        </dl>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════ ACT III · THE PATH ═══════════════ -->
<section class="act path" id="pathsec" aria-label="The five levels">
  <span class="plate pr" aria-hidden="true">III</span>
  <div class="act-inner">
    <h2 data-reveal>From the alphabet to full <span class="em">iʿrāb.</span></h2>
    <p class="sub" data-reveal>Five levels, eighty-one lessons, each one built on the last. Start with letters and vowels; finish reading Quranic passages with a grammarian's eye.</p>

    <div class="path-wrap">
