  <style is:global>
/* ============================================================
   NIGHT SKY TOKENS · نور على نور
   ============================================================ */
:root{
  --bg-0:#05070e;
  --bg-1:#090d19;
  --bg-2:#0e1425;
  --ink:#f4edda;
  --ink-dim:rgba(244,237,218,.66);
  --ink-faint:rgba(244,237,218,.42);
  --gold:#e3b35c;
  --gold-bright:#f4d68f;
  --gold-deep:#a97e35;
  --gold-glow:rgba(227,179,92,.5);
  --hairline:rgba(228,209,164,.14);
  --hairline-soft:rgba(228,209,164,.07);
  --card:#0c1120;
  --btn-ink:#221503;
  --ease-out:cubic-bezier(.23,1,.32,1);
  --ease-io:cubic-bezier(.77,0,.175,1);
  --font-display:'Marcellus',serif;
  --font-body:'Geist',sans-serif;
  --font-mono:'Geist Mono',monospace;
  --font-quran:'Amiri Quran','Amiri',serif;
  --font-ar:'Amiri',serif;
  --pad-x:clamp(20px,5vw,72px);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{
  background:var(--bg-0);
  color:var(--ink);
  font-family:var(--font-body);
  font-weight:400;
  font-size:16px;
  line-height:1.7;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
::selection{background:rgba(227,179,92,.28);color:var(--ink)}
html{scrollbar-color:rgba(227,179,92,.35) var(--bg-0);scrollbar-width:thin}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--gold);outline-offset:4px;border-radius:2px}
[lang="ar"]{font-family:var(--font-ar)}
.q{font-family:var(--font-quran);font-weight:400}

/* ---------- reveal gating: hidden states exist ONLY under .js ---------- */
.js [data-reveal]{opacity:0;transform:translateY(26px);filter:blur(10px)}
.js [data-reveal].on{opacity:1;transform:none;filter:blur(0);transition:opacity .85s var(--ease-out),transform .85s var(--ease-out),filter .85s var(--ease-out)}
@media (prefers-reduced-motion:reduce){
  .js [data-reveal]{opacity:1;transform:none;filter:none}
}

/* ============================================================
   LOAD VEIL
   ============================================================ */
#veil{position:fixed;inset:0;background:var(--bg-0);z-index:200;display:grid;place-items:center;transition:opacity 1s var(--ease-out),visibility 1s}
#veil.gone{opacity:0;visibility:hidden}
#veil svg{width:34px;height:34px;opacity:.85;animation:veilstar 2.2s var(--ease-io) infinite}
@keyframes veilstar{0%,100%{opacity:.25;transform:scale(.92) rotate(0deg)}50%{opacity:.95;transform:scale(1) rotate(45deg)}}
@media (prefers-reduced-motion:reduce){#veil{display:none}}

/* ============================================================
   NAV
   ============================================================ */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:22px var(--pad-x);
  transition:background .5s var(--ease-out),padding .5s var(--ease-out),border-color .5s;
  border-bottom:1px solid transparent;
}
.nav.scrolled{background:rgba(5,7,14,.72);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:14px var(--pad-x);border-bottom-color:var(--hairline-soft)}
.brand{display:flex;align-items:center;gap:12px;font-family:var(--font-display);font-size:15px;letter-spacing:.34em;text-transform:uppercase;color:var(--ink)}
.brand svg{width:19px;height:19px;flex:none}
.brand .star-path{transform-origin:center;transition:transform 1.2s var(--ease-out)}
.brand:hover .star-path{transform:rotate(45deg)}
.nav-links{display:flex;gap:clamp(18px,3vw,44px);align-items:center}
.nav-links a{font-size:14.5px;color:var(--ink-dim);letter-spacing:.02em;position:relative;padding:4px 0;transition:color .35s}
.nav-links a::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:var(--gold);transform:scaleX(0);transform-origin:right;transition:transform .5s var(--ease-out)}
.nav-links a:hover{color:var(--ink)}
.nav-links a:hover::after{transform:scaleX(1);transform-origin:left}
.nav-cta{font-size:13.5px;letter-spacing:.06em;color:var(--gold-bright);border:1px solid rgba(227,179,92,.38);border-radius:999px;padding:9px 22px;transition:background .4s,color .4s,border-color .4s,transform .16s var(--ease-out)}
.nav-cta:hover{background:var(--gold);color:var(--btn-ink);border-color:var(--gold)}
.nav-cta:active{transform:scale(.97)}
@media (max-width:860px){.nav-links{display:none}}
@media (max-width:480px){
  .nav{padding-left:16px;padding-right:16px}
  .brand span{font-size:12.5px;letter-spacing:.2em}
  .nav-cta{padding:8px 16px;font-size:12.5px;flex:none}
}

/* ============================================================
   HERO · ACT I
   ============================================================ */
.hero{
  position:relative;min-height:100dvh;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  overflow:hidden;
  padding:88px var(--pad-x) 60px;
  /* CSS nebula fallback painted under the GL canvas: mobile, no-JS, no-WebGL */
  background:
    radial-gradient(130% 90% at 50% 118%, rgba(169,126,53,.20) 0%, transparent 55%),
    radial-gradient(90% 65% at 78% -12%, rgba(35,84,92,.34) 0%, transparent 60%),
    radial-gradient(75% 60% at 12% 8%, rgba(43,32,84,.30) 0%, transparent 58%),
    radial-gradient(52% 42% at 50% 74%, rgba(227,179,92,.10) 0%, transparent 65%),
    var(--bg-0);
}
#gl,#dust{position:absolute;inset:0;width:100%;height:100%;display:block}
#gl{z-index:0}
#dust{z-index:2;pointer-events:none}
.hero::after{ /* bottom fade into page canvas */
  content:"";position:absolute;left:0;right:0;bottom:0;height:26vh;z-index:3;pointer-events:none;
  background:linear-gradient(180deg,transparent, var(--bg-0) 88%);
}
.hero-inner{position:relative;z-index:4;text-align:center;max-width:1280px;width:100%;display:flex;flex-direction:column;align-items:center}

/* one unbroken monumental line, fitted by JS */
.basmala{
  direction:rtl;
  font-family:var(--font-quran);
  white-space:nowrap;
  font-size:96px;
  line-height:1.75;
  color:var(--ink);
  text-shadow:0 0 28px rgba(227,179,92,.18);
}
@media (max-width:700px){
  .basmala{white-space:normal;font-size:clamp(40px,11.5vw,52px) !important;line-height:1.62}
}
.ornament{display:flex;align-items:center;gap:18px;margin:20px 0 0;width:min(420px,60vw)}
.ornament .ln{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(227,179,92,.5))}
.ornament .ln:last-child{background:linear-gradient(90deg,rgba(227,179,92,.5),transparent)}
.ornament svg{width:15px;height:15px;color:var(--gold);flex:none}
.js .basmala.veiled{opacity:0;filter:blur(14px)}
.basmala{transition:opacity 1.3s var(--ease-out),filter 1.3s var(--ease-out)}
.bw{position:relative;transition:text-shadow .6s var(--ease-out);border-radius:6px}
@media (hover:hover) and (pointer:fine){
  .bw:hover{text-shadow:0 0 34px rgba(244,214,143,.65)}
}
#gloss{
  position:absolute;z-index:6;pointer-events:none;
  font-family:var(--font-mono);font-size:12.5px;letter-spacing:.05em;color:var(--gold-bright);
  background:rgba(9,12,24,.88);border:1px solid var(--hairline);border-radius:8px;
  padding:7px 14px;white-space:nowrap;
  opacity:0;transform:translate(-50%,8px);
  transition:opacity .4s var(--ease-out),transform .4s var(--ease-out);
}
#gloss.show{opacity:1;transform:translate(-50%,0)}
#gloss .g-en{color:var(--ink-dim);font-family:var(--font-body)}

.hero-h1{
  font-family:var(--font-display);
  font-weight:400;
  font-size:clamp(28px,4vw,52px);
  line-height:1.14;
  letter-spacing:.005em;
  max-width:19ch;
  margin-top:26px;
}
.hero-h1 .hw{display:inline-block}
.hero-lede{
  margin-top:18px;color:var(--ink-dim);
  font-size:clamp(15.5px,1.35vw,18px);font-weight:300;
  max-width:56ch;line-height:1.85;
}
.cta-row{display:flex;gap:16px;margin-top:32px;flex-wrap:wrap;justify-content:center}
.btn{
  display:inline-flex;align-items:center;gap:10px;
  border-radius:999px;font-size:15px;letter-spacing:.04em;
  padding:16px 34px;cursor:pointer;
  transition:transform .16s var(--ease-out),background .4s,color .4s,border-color .4s,box-shadow .5s;
  will-change:transform;
}
.btn:active{transform:scale(.97)}
.btn-primary{
  background:linear-gradient(180deg,var(--gold-bright),var(--gold) 55%,#cf9b45);
  color:var(--btn-ink);font-weight:500;
  box-shadow:0 10px 44px -14px var(--gold-glow),inset 0 1px 0 rgba(255,244,214,.7);
}
.btn-primary:hover{box-shadow:0 14px 58px -12px rgba(227,179,92,.65),inset 0 1px 0 rgba(255,244,214,.7)}
.btn-ghost{border:1px solid var(--hairline);color:var(--ink-dim)}
.btn-ghost:hover{border-color:rgba(227,179,92,.5);color:var(--ink)}
.btn .arr{transition:transform .45s var(--ease-out)}
.btn:hover .arr{transform:translateX(4px)}

.hero-stats{
  display:flex;gap:clamp(26px,4.5vw,74px);
  margin-top:clamp(22px,3.6vh,42px);
  flex-wrap:wrap;justify-content:center;
}
.stat{display:flex;flex-direction:column;align-items:center;gap:4px}
.stat b{font-family:var(--font-mono);font-weight:500;font-size:clamp(21px,2vw,27px);color:var(--gold-bright);letter-spacing:.02em}
.stat span{font-size:13px;color:var(--ink-faint);letter-spacing:.04em}
.stat + .stat{position:relative}
@media (min-width:640px){
  .stat + .stat::before{content:"";position:absolute;left:calc(clamp(26px,4.5vw,74px) / -2);top:12%;height:76%;width:1px;background:var(--hairline-soft)}
}

.scroll-cue{
  position:absolute;bottom:30px;left:50%;transform:translateX(-50%);z-index:5;
  display:flex;flex-direction:column;align-items:center;gap:10px;
  color:var(--ink-faint);font-family:var(--font-mono);font-size:11px;letter-spacing:.32em;
}
.scroll-cue .line{width:1px;height:56px;background:var(--hairline);position:relative;overflow:hidden}
.scroll-cue .line::after{content:"";position:absolute;left:0;top:-40%;width:100%;height:40%;background:linear-gradient(180deg,transparent,var(--gold-bright));animation:cuedrip 2.4s var(--ease-io) infinite}
@keyframes cuedrip{0%{top:-40%}70%,100%{top:110%}}
@media (prefers-reduced-motion:reduce){.scroll-cue .line::after{animation:none;top:30%}}
@media (max-height:940px){.scroll-cue{display:none}}

/* ============================================================
   SHARED SECTION CHROME · plate numerals
   ============================================================ */
section{position:relative}
.act{padding:clamp(90px,14vh,170px) var(--pad-x);overflow:clip}
.act-inner{max-width:1200px;margin:0 auto;position:relative}
.plate{
  position:absolute;z-index:0;pointer-events:none;user-select:none;
  font-family:var(--font-display);font-size:clamp(140px,26vw,380px);line-height:1;
  color:transparent;-webkit-text-stroke:1px rgba(228,209,164,.07);
  top:-.18em;
}
.plate.pr{right:-.06em}.plate.pl{left:-.06em}
h2{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(30px,4vw,54px);line-height:1.16;letter-spacing:.004em;
  max-width:22ch;position:relative;z-index:1;
}
h2 .em{color:var(--gold)}
.sub{
  margin-top:18px;color:var(--ink-dim);font-weight:300;
  font-size:clamp(15px,1.25vw,17.5px);max-width:58ch;line-height:1.85;position:relative;z-index:1;
}

/* ============================================================
   ACT II · CONSTELLATION SCROLLYTELLING
   ============================================================ */
.constellation{background:linear-gradient(180deg,var(--bg-0),var(--bg-1) 30%,var(--bg-0))}
.c-stage{min-height:100dvh;display:flex;flex-direction:column;justify-content:center;padding:84px var(--pad-x) 36px}
.c-head{max-width:1200px;margin:0 auto 3vh;width:100%}
.c-field{position:relative;max-width:1200px;margin:0 auto;width:100%;flex:0 1 auto}
.c-verse{
  direction:rtl;display:flex;justify-content:center;gap:clamp(16px,3.2vw,50px);
  font-family:var(--font-quran);font-size:clamp(38px,5.8vw,84px);line-height:1.75;
  position:relative;z-index:2;flex-wrap:nowrap;
}
.cw{position:relative;transition:text-shadow .7s var(--ease-out),color .7s var(--ease-out)}
.js .cw{opacity:.16;filter:blur(4px)}
.cw.lit{color:var(--ink);text-shadow:0 0 26px rgba(244,214,143,.42),0 0 70px rgba(227,179,92,.15)}
#clines{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:visible}
#clines path{fill:none;stroke:var(--gold);stroke-width:1.1;opacity:.55;filter:drop-shadow(0 0 5px rgba(227,179,92,.6))}
#clines circle{fill:var(--gold-bright);filter:drop-shadow(0 0 6px rgba(244,214,143,.9))}
.c-readouts{
  direction:rtl;
  display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(10px,1.6vw,22px);
  max-width:1200px;margin:clamp(18px,3.5vh,34px) auto 0;position:relative;z-index:2;
}
.ro{
  direction:ltr;
  border:1px solid var(--hairline-soft);border-radius:14px;
  background:linear-gradient(180deg,rgba(14,20,37,.62),rgba(9,13,25,.32));
  padding:clamp(14px,1.8vw,24px);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
}
.js .ro{opacity:0;transform:translateY(34px)}
.ro-top{display:flex;align-items:baseline;justify-content:space-between;gap:10px;border-bottom:1px solid var(--hairline-soft);padding-bottom:10px;margin-bottom:12px}
.ro-tr{font-family:var(--font-mono);font-size:13px;color:var(--gold-bright);letter-spacing:.08em}
.ro-en{font-size:13px;color:var(--ink-dim);font-weight:300}
.ro dl{display:grid;gap:7px}
.ro .row{display:flex;justify-content:space-between;gap:12px;align-items:baseline}
.ro dt{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.16em;color:var(--ink-faint)}
.ro dd{font-size:13px;color:var(--ink);text-align:right;font-weight:300}
.ro dd [lang="ar"]{font-size:16px}
.ro dd i{color:var(--gold);font-style:normal}
@media (max-width:899px){
  .c-stage{min-height:0}
  .c-verse{flex-wrap:wrap;row-gap:0;font-size:clamp(46px,13vw,84px)}
  .c-readouts{grid-template-columns:1fr 1fr}
  #clines{display:none}
  .js .cw{opacity:1;filter:none}
}
@media (max-width:560px){.c-readouts{grid-template-columns:1fr}}

/* ============================================================
   ACT III · THE PATH (five levels)
   ============================================================ */
.path-wrap{position:relative;max-width:1200px;margin:clamp(50px,8vh,90px) auto 0}
#lpath{position:absolute;left:0;top:0;width:100%;height:100%;overflow:visible;pointer-events:none}
#lpath path{fill:none;stroke:rgba(227,179,92,.5);stroke-width:1.2}
#lpath .lp-glow{stroke:rgba(227,179,92,.16);stroke-width:5;filter:blur(4px)}
.levels{display:flex;flex-direction:column;gap:clamp(60px,10vh,120px);position:relative;z-index:1}
.level{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(18px,4vw,64px);
  align-items:center;
}
.level:nth-child(even){grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)}
.level:nth-child(even) .lv-copy{order:2}
.level:nth-child(even) .lv-art{order:1;justify-content:flex-start}
.lv-art{display:flex;justify-content:flex-end;align-items:center;gap:22px}
.level:nth-child(odd) .lv-art{flex-direction:row-reverse}
.lv-ar{
  direction:rtl;font-family:var(--font-ar);font-weight:400;
  font-size:clamp(38px,5.4vw,82px);line-height:1.4;color:transparent;
  -webkit-text-stroke:1px rgba(228,209,164,.34);
  transition:color .9s var(--ease-out),-webkit-text-stroke-color .9s;
  min-width:0;
}
.level:nth-child(even) .lv-ar{text-align:left}
.level:hover .lv-ar,.level.pass .lv-ar{color:rgba(244,237,218,.9);-webkit-text-stroke-color:transparent}
.lv-copy h3{font-family:var(--font-display);font-weight:400;font-size:clamp(23px,2.3vw,32px);line-height:1.2}
.lv-copy h3 small{display:block;font-family:var(--font-mono);font-size:12.5px;color:var(--gold);letter-spacing:.18em;margin-top:8px}
.lv-copy p{color:var(--ink-dim);font-weight:300;font-size:15px;margin-top:12px;max-width:44ch}
.lv-node{width:11px;height:11px;flex:none;position:relative}
.lv-node svg{position:absolute;inset:-7px;width:25px;height:25px;color:var(--gold)}
@media (max-width:767px){
  .level,.level:nth-child(even){grid-template-columns:1fr;gap:14px}
  .level .lv-copy,.level:nth-child(even) .lv-copy{order:2}
  .level .lv-art,.level:nth-child(even) .lv-art{order:1;justify-content:flex-start;flex-direction:row}
  .lv-ar{font-size:clamp(36px,10vw,52px);text-align:left}
}

/* ============================================================
   MARQUEE BAND
   ============================================================ */
.band{
  padding:clamp(70px,10vh,120px) 0;overflow:hidden;position:relative;
  border-top:1px solid var(--hairline-soft);border-bottom:1px solid var(--hairline-soft);
  background:var(--bg-1);
}
.mq{display:flex;white-space:nowrap;will-change:transform}
.mq-ar{
  direction:rtl;font-family:var(--font-ar);font-size:clamp(64px,10vw,150px);line-height:1.5;
  color:transparent;-webkit-text-stroke:1px rgba(228,209,164,.22);
}
.mq-ar .solid{color:rgba(227,179,92,.75);-webkit-text-stroke-color:transparent}
.mq-la{font-family:var(--font-mono);font-size:clamp(13px,1.3vw,16px);letter-spacing:.34em;color:var(--ink-faint);margin-top:26px}
.mq span{padding:0 clamp(22px,3vw,46px);flex:none}
.mq .dot{color:var(--gold);padding:0}

/* ============================================================
   ACT IV · ATLAS (surah cards)
   ============================================================ */
.atlas{background:linear-gradient(180deg,var(--bg-0),var(--bg-1) 55%,var(--bg-0))}
#starfield{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:.9}
.atlas-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap}
.atlas-count{text-align:right}
.atlas-count b{font-family:var(--font-mono);font-weight:500;font-size:clamp(44px,5vw,72px);color:var(--gold-bright);display:block;line-height:1}
.atlas-count span{font-size:13px;color:var(--ink-faint);letter-spacing:.04em}
.cards{
  display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(14px,1.8vw,26px);
  margin-top:clamp(46px,7vh,80px);perspective:1400px;
}
.cards > a:nth-child(2){transform:translateY(26px)}
.cards > a:nth-child(3){transform:translateY(8px)}
.cards > a:nth-child(4){transform:translateY(38px)}
.card{
  --mx:50%;--my:50%;
  position:relative;border-radius:18px;overflow:hidden;
  background:linear-gradient(165deg,#101728,#0a0f1d 70%);
  border:1px solid var(--hairline-soft);
  padding:clamp(20px,2.2vw,30px);
  min-height:clamp(240px,26vw,340px);
  display:flex;flex-direction:column;justify-content:space-between;
  transition:border-color .5s;
  transform-style:preserve-3d;
  will-change:transform;
}
.card::before{ /* cursor spotlight */
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:radial-gradient(340px circle at var(--mx) var(--my),rgba(227,179,92,.13),transparent 65%);
  opacity:0;transition:opacity .5s;
}
.card:hover::before{opacity:1}
.card:hover{border-color:rgba(227,179,92,.35)}
.card-num{font-family:var(--font-mono);font-size:12px;letter-spacing:.24em;color:var(--ink-faint);display:flex;justify-content:space-between;align-items:center}
.card-num svg{width:14px;height:14px;color:var(--gold);opacity:.8}
.card-ar{direction:rtl;font-family:var(--font-quran);font-size:clamp(44px,4.6vw,66px);color:var(--ink);text-align:center;line-height:1.7}
.card-foot{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.card-en{font-family:var(--font-display);font-size:16.5px;letter-spacing:.03em}
.card-vs{font-family:var(--font-mono);font-size:11.5px;color:var(--ink-faint);letter-spacing:.1em}
.atlas-link{
  display:inline-flex;align-items:center;gap:12px;margin-top:clamp(40px,6vh,64px);
  font-size:15px;color:var(--gold-bright);letter-spacing:.03em;
}
.atlas-link .ln{width:52px;height:1px;background:var(--gold);transform-origin:left;transition:transform .5s var(--ease-out)}
.atlas-link:hover .ln{transform:scaleX(1.5)}
@media (max-width:899px){.cards{grid-template-columns:1fr 1fr}.cards > a{transform:none !important}}
@media (max-width:520px){.cards{grid-template-columns:1fr}}

/* ============================================================
   ACT V · INSTRUMENT (word lookup)
   ============================================================ */
.instrument .act-inner{max-width:1080px}
.instrument.act{padding-top:clamp(64px,9vh,110px);padding-bottom:clamp(64px,9vh,110px)}
.panel{
  position:relative;margin-top:clamp(28px,4.5vh,48px);
  border-radius:20px;border:1px solid var(--hairline);
  background:
    radial-gradient(120% 130% at 85% -20%, rgba(35,84,92,.13) 0%, transparent 55%),
    linear-gradient(180deg,#0b101f,#080c17);
  padding:clamp(20px,2.6vw,40px);
  overflow:hidden;
}
.panel::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;box-shadow:inset 0 1px 0 rgba(244,237,218,.05)}
.p-corner{position:absolute;width:22px;height:22px;color:var(--gold);opacity:.75}
.p-corner.tl{top:12px;left:12px}.p-corner.tr{top:12px;right:12px;transform:rotate(90deg)}
.p-corner.br{bottom:12px;right:12px;transform:rotate(180deg)}.p-corner.bl{bottom:12px;left:12px;transform:rotate(270deg)}
.p-head{display:flex;justify-content:space-between;align-items:center;font-family:var(--font-mono);font-size:11.5px;letter-spacing:.26em;color:var(--ink-faint);border-bottom:1px solid var(--hairline-soft);padding-bottom:16px}
.p-head .live{display:inline-flex;align-items:center;gap:8px}
.p-head .live::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px var(--gold);animation:pulse 2.6s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}
@media (prefers-reduced-motion:reduce){.p-head .live::before{animation:none}}
.p-body{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.25fr);gap:clamp(24px,4vw,56px);padding-top:clamp(18px,2.5vw,30px);align-items:center}
.p-word{text-align:center}
.p-word .ar{direction:rtl;font-family:var(--font-quran);font-size:clamp(60px,6.5vw,96px);line-height:1.4;color:var(--ink);text-shadow:0 0 60px rgba(227,179,92,.25)}
.p-word .tr{font-family:var(--font-mono);font-size:14px;color:var(--gold-bright);letter-spacing:.28em;margin-top:6px}
.p-word .gl{color:var(--ink-dim);font-weight:300;font-size:14.5px;margin-top:10px}
.p-root{display:flex;justify-content:center;gap:34px;margin-top:20px;position:relative}
.p-root::before{content:"";position:absolute;top:50%;left:15%;right:15%;height:1px;background:linear-gradient(90deg,transparent,rgba(227,179,92,.4),transparent)}
.p-root b{
  position:relative;width:48px;height:48px;border-radius:50%;
  border:1px solid rgba(227,179,92,.4);background:var(--bg-1);
  display:grid;place-items:center;
  font-family:var(--font-ar);font-weight:400;font-size:22px;color:var(--gold-bright);
  box-shadow:0 0 24px -6px rgba(227,179,92,.35);
}
.p-root-label{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.3em;color:var(--ink-faint);text-align:center;margin-top:10px}
.p-data{display:grid;gap:0}
.p-row{display:flex;justify-content:space-between;align-items:baseline;gap:18px;padding:11px 0;border-bottom:1px solid var(--hairline-soft)}
.p-row:first-child{padding-top:0}
.p-row dt{font-family:var(--font-mono);font-size:11px;letter-spacing:.22em;color:var(--ink-faint);flex:none}
.p-row dd{font-family:var(--font-mono);font-size:14px;color:var(--ink);text-align:right}
.p-row dd b{color:var(--gold-bright);font-weight:500}
.p-row dd .chip{display:inline-block;border:1px solid var(--hairline);border-radius:6px;padding:2px 9px;margin-left:6px;font-size:12px;color:var(--ink-dim)}
.p-cta{display:flex;justify-content:flex-end;margin-top:16px}
@media (max-width:820px){.p-body{grid-template-columns:1fr}.p-cta{justify-content:center}}

/* ============================================================
   ACT VI · WHY GRAMMAR
   ============================================================ */
.why .act-inner{max-width:980px;text-align:center}
.why-verse{direction:rtl;font-family:var(--font-quran);font-size:clamp(40px,6.5vw,84px);line-height:1.8;color:var(--ink)}
.why-tr{color:var(--ink-dim);font-weight:300;font-size:15.5px;margin-top:18px}
.why-tr i{color:var(--gold);font-style:normal}
.reasons{margin-top:clamp(46px,7vh,80px);text-align:left;position:relative}
#spot{position:absolute;inset:-60px;pointer-events:none;opacity:0;transition:opacity .6s;
  background:radial-gradient(240px circle at var(--sx,50%) var(--sy,50%),rgba(227,179,92,.09),transparent 70%)}
.reasons:hover #spot{opacity:1}
.reason{
  display:flex;align-items:baseline;gap:clamp(16px,3vw,40px);
  padding:clamp(20px,2.6vw,30px) 8px;border-bottom:1px solid var(--hairline-soft);
  transition:padding-left .5s var(--ease-out);
}
.reason:first-child{border-top:1px solid var(--hairline-soft)}
.reason:hover{padding-left:22px}
.reason i{font-family:var(--font-mono);font-style:normal;font-size:12px;color:var(--gold);letter-spacing:.2em;flex:none}
.reason p{font-family:var(--font-display);font-size:clamp(19px,2.4vw,30px);line-height:1.35;color:var(--ink-dim);transition:color .5s}
.reason:hover p{color:var(--ink)}
.reason p b{font-weight:400;color:var(--ink)}
.reason:hover p b{color:var(--gold-bright)}

/* ============================================================
   FINALE + FOOTER
   ============================================================ */
.finale{
  position:relative;overflow:hidden;text-align:center;
  padding:clamp(120px,20vh,220px) var(--pad-x) clamp(90px,14vh,150px);
  background:
    radial-gradient(90% 70% at 50% 108%, rgba(169,126,53,.16) 0%, transparent 60%),
    radial-gradient(60% 50% at 50% 100%, rgba(227,179,92,.07) 0%, transparent 70%),
    var(--bg-0);
}
#embers{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.finale-inner{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center}
.dua{direction:rtl;font-family:var(--font-quran);font-size:clamp(52px,8vw,110px);line-height:1.85}
.dua-tr{color:var(--ink-dim);font-weight:300;font-size:clamp(15px,1.4vw,18px);margin-top:clamp(34px,4.5vh,52px)}
.dua-ref{font-family:var(--font-mono);font-size:11.5px;letter-spacing:.3em;color:var(--ink-faint);margin-top:10px}
.finale-line{color:var(--ink-dim);font-weight:300;font-size:16px;max-width:44ch;margin-top:clamp(30px,5vh,50px)}
.finale .cta-row{margin-top:36px}
footer{border-top:1px solid var(--hairline-soft);padding:56px var(--pad-x) 42px;background:var(--bg-0)}
.foot-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;align-items:flex-start}
.foot-brand{display:flex;flex-direction:column;gap:14px;max-width:34ch}
.foot-brand p{font-size:13.5px;color:var(--ink-faint);font-weight:300;line-height:1.75}
.foot-nav{display:flex;gap:clamp(30px,5vw,80px)}
.foot-nav a{display:block;font-size:14px;color:var(--ink-dim);padding:5px 0;transition:color .35s}
.foot-nav a:hover{color:var(--gold-bright)}
.foot-meta{width:100%;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:46px;padding-top:22px;border-top:1px solid var(--hairline-soft);font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;color:var(--ink-faint)}

/* Roomier tap targets on touch */
@media (pointer:coarse){.nav-cta,.btn{padding-top:15px;padding-bottom:15px}}

/* ═══ FINAL CUT · dawn sky + river of light + tree of Juz ʿAmma ═══ */
#dawnbg{position:fixed;inset:0;z-index:0;pointer-events:none;background:var(--bg-0)}
#dawnstars{position:fixed;inset:0;z-index:0;pointer-events:none}
#river{position:fixed;inset:0;z-index:0;pointer-events:none}
#dawnsun{position:fixed;left:50%;bottom:-30vh;width:130vmin;height:60vmin;transform:translateX(-50%);z-index:0;pointer-events:none;border-radius:50% 50% 0 0;background:radial-gradient(55% 90% at 50% 100%, rgba(244,196,110,.8) 0%, rgba(227,150,70,.34) 42%, transparent 72%);opacity:0;filter:blur(10px)}
main{position:relative;z-index:1}
.constellation{background:transparent}
.atlas{background:transparent}
.band{background:rgba(9,13,25,.42)}
.finale{background:transparent}
footer{background:transparent;position:relative;z-index:1;border-top-color:rgba(228,209,164,.12)}
.tree-stage{position:relative;margin-top:clamp(36px,5vh,60px);height:clamp(430px,58vh,600px)}
#treecv{position:absolute;inset:0;width:100%;height:100%;display:block}
.tree-root-label{
  position:absolute;transform:translateX(-50%);pointer-events:none;
  font-family:var(--font-quran);font-size:18px;color:rgba(244,237,218,.6);white-space:nowrap;
}
.plaque-row{display:flex;justify-content:center;margin-top:4px}
.plaque{
  display:inline-flex;align-items:center;gap:clamp(14px,1.6vw,24px);
  padding:10px 24px 11px 20px;max-width:92vw;
  border:1px solid var(--hairline);border-radius:999px;
  background:rgba(8,11,22,.66);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  transition:border-color .4s;white-space:nowrap;
}
.plaque:hover{border-color:rgba(227,179,92,.4)}
.plq-inner{display:inline-flex;align-items:center;gap:clamp(14px,1.6vw,24px);transition:opacity .24s ease}
.plq-inner.fade{opacity:.15}
.plq-ar{direction:rtl;font-family:var(--font-quran);font-size:clamp(22px,2vw,28px);line-height:1.4;color:var(--ink)}
.plq-div{width:1px;height:28px;background:var(--hairline)}
.plq-body{display:flex;flex-direction:column;line-height:1.35;text-align:left}
.plq-en{font-family:var(--font-display);font-weight:400;font-size:15px;letter-spacing:.03em}
.plq-meta{font-family:var(--font-mono);font-size:10px;letter-spacing:.2em;color:var(--ink-faint)}
.plq-go{font-size:13px;color:var(--gold-bright);letter-spacing:.03em;display:inline-flex;align-items:center;gap:7px}
.plq-go .arr{transition:transform .45s var(--ease-out)}
.plaque:hover .plq-go .arr{transform:translateX(4px)}
.tree-hint{margin-top:14px;font-size:13.5px;color:var(--ink-faint);font-weight:300;text-align:center}
@media (max-width:640px){.plq-body,.plq-div{display:none}}
@media (max-width:767px){.tree-stage{height:clamp(380px,52vh,520px)}}
@media (prefers-reduced-motion:reduce){.plq-inner{transition:none}}
.level.pass .lv-node::after{content:"";position:absolute;inset:-10px;border:1px solid rgba(227,179,92,.55);border-radius:50%;animation:nodeping 1.3s var(--ease-out) 1 both}
@keyframes nodeping{0%{transform:scale(.4);opacity:1}100%{transform:scale(1.9);opacity:0}}
@media (prefers-reduced-motion:reduce){.level.pass .lv-node::after{animation:none;opacity:0}}
.dua.arrive{animation:duapulse 2.6s var(--ease-out) 1 forwards}
@keyframes duapulse{0%{text-shadow:0 0 0 rgba(244,214,143,0)}30%{text-shadow:0 0 64px rgba(244,214,143,.7)}100%{text-shadow:0 0 26px rgba(244,214,143,.28)}}
@media (prefers-reduced-motion:reduce){.dua.arrive{animation:none}}
@media (max-width:767px){#dawnstars,#river{display:none}}

/* accessibility: skip link (visually hidden until focused) */
.skip-link{position:fixed;left:16px;top:-60px;z-index:300;background:var(--gold);color:var(--btn-ink);font-size:14px;font-weight:500;padding:10px 18px;border-radius:8px;transition:top .2s}
.skip-link:focus{top:14px}
  </style>
</head>
