    p.x = Math.random() * W;
    p.y = H * 0.6 + Math.random() * H * 0.5;
    p.vy = -(6 + Math.random() * 16);
    p.vx = (Math.random() - 0.5) * 5;
    p.s = 0.5 + Math.random() * 1.3;
    p.life = 0; p.span = 6 + Math.random() * 8;
    p.ph = Math.random() * Math.PI * 2;
    return p;
  }
  function size(){
    W = c.width = sec.clientWidth; H = c.height = sec.clientHeight;
    const N = LITE ? 26 : 64;
    parts = Array.from({ length: N }, () => spawn({}));
  }
  size();
  let vis = false, prev = performance.now();
  new IntersectionObserver(es => { vis = es[0].isIntersecting; }, { rootMargin: '40px' }).observe(sec);
  (function frame(now){
    requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
    if (!vis || !pageVisible) return;
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'lighter';
    const t = now / 1000;
    for (const p of parts) {
      p.life += dt;
      if (p.y < -12 || p.life > p.span) spawn(p);
      p.x += (p.vx + Math.sin(t * 1.4 + p.ph) * 4) * dt;
      p.y += p.vy * dt;
      const ramp = Math.min(1, p.life / 1.6) * Math.min(1, (p.span - p.life) / 1.6);
      const a = ramp * (0.12 + 0.26 * (0.5 + 0.5 * Math.sin(p.ph + t * 3)));
      ctx.fillStyle = 'rgba(240,200,130,' + a + ')';
      ctx.fillRect(p.x, p.y, p.s, p.s);
    }
  })(prev);
  let rs; addEventListener('resize', () => { clearTimeout(rs); rs = setTimeout(size, 220); });
}

