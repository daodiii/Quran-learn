---
/**
 * Home page. Light only, standalone (no BaseLayout): the shared header still carries the
 * old theme toggle and serif fonts, so this page has its own lean header until the site
 * shell is redone.
 * The hero is a product tour: a window with four working tools that plays a short demo
 * of each, then hands control to the visitor. Every tool renders its first state here,
 * so the page reads without JavaScript; src/scripts/home.ts adds the behaviour.
 */
import { getCollection } from 'astro:content';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/fonts.css';
import '../styles/home.css';
import { readFileSync } from 'node:fs';
import { LESSON_STEPS, DECODER, DUA, LOOKUP_KEYS, ROOT_KEYS, ROOTS, lookupResult, decoderReadout, rootStats, barHeight, surahLine, readerText, readerCard, type ReaderSurah } from '../lib/home-tools';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);
const surahs = (await getCollection('surahs')).sort((a, b) => a.data.surahNumber - b.data.surahNumber);
const firstOf = (level: number) => lessons.find((l) => l.data.level === level)!;

// Each level's card shows a small sample of what it teaches (spec), and the surah its checkpoint reads (cp).
const LEVELS = [
  { name: 'Foundation', end: 'Read the letters and vowel marks of any verse.', cp: 'Al-Ikhlas',
    spec: '<div class="row"><span class="tile"><span class="ar">بَ</span><small lang="en">ba</small></span><span class="tile"><span class="ar">بِ</span><small lang="en">bi</small></span><span class="tile"><span class="ar">بُ</span><small lang="en">bu</small></span></div><span class="line" lang="en">One letter, three vowels</span>' },
  { name: 'Core grammar', end: 'Name the parts of a sentence and say why a word ends the way it does.', cp: 'Al-Kawthar',
    spec: '<div class="row sm"><span class="tile on"><span class="ar">كِتَابٌ</span><small lang="en">rafʿ</small></span><span class="tile"><span class="ar">كِتَابًا</span><small lang="en">naṣb</small></span><span class="tile"><span class="ar">كِتَابٍ</span><small lang="en">jarr</small></span></div><span class="line" lang="en">“A book”, in its three cases</span>' },
  { name: 'Intermediate', end: 'Recognise a verb, its person and its form.', cp: 'Al-ʿAsr',
    spec: '<div class="lbls"><span><span class="ar v">قَالَ</span><small lang="en">he said</small></span><span><span class="ar v">يَقُولُ</span><small lang="en">he says</small></span><span><span class="ar v">قُلْ</span><small lang="en">say!</small></span></div><span class="line" lang="en">One root, <bdi class="rootl" lang="ar" dir="rtl">ق و ل</bdi>, three verbs</span>' },
  { name: 'Advanced', end: 'Follow long and careful sentences.', cp: 'Ad-Duha',
    spec: '<div class="lbls"><span><span class="ar p">لَآ</span><small lang="en">no</small></span><span><span class="ar k">إِلَٰهَ</span><small lang="en">god</small></span><span><span class="ar p">إِلَّا</span><small lang="en">except</small></span><span><span class="ar k">ٱللَّهُ</span><small lang="en">Allah</small></span></div><span class="line" lang="en">Negation, then exception</span>' },
  { name: 'Applied study', end: 'Read a passage and explain every word.', cp: 'Luqman’s counsel',
    spec: '<span class="ar big">بِسْمِ ٱللَّهِ</span><span class="line" lang="en">bi: a preposition · ismi: genitive, after bi<br>llāhi: genitive, the second half of an iḍāfah</span>' },
].map((l, i) => ({ ...l, level: i + 1, count: lessons.filter((x) => x.data.level === i + 1).length, href: `/learn/${firstOf(i + 1).id}/` }));

const startHref = LEVELS[0].href;
const readerHref = LEVELS[1].href;
// For the "continue where you left off" button: lesson ids and titles, in course order.
const courseOrder = lessons.map((l) => [l.id, l.data.title]);

const knowledge = rootStats('knowledge');
// The reader opens on Al-Ikhlas, the Level 1 checkpoint (generated by npm run home:data).
const reader: ReaderSurah = JSON.parse(readFileSync('public/data/home-reader/112.json', 'utf8'));
const title = 'Quranic Grammar · Learn the language of the Quran, free';
const description = 'Free lessons in the Arabic of the Quran, from the alphabet to reading a verse and knowing what every word does. With a word lookup, a verse decoder and a root map.';
const canonicalURL = new URL('/', Astro.site);
const ogImageURL = new URL('/images/og-default.jpg', Astro.site);

const TABS = [
  { k: 'lesson', name: 'Lessons', d: 'One idea at a time, then check it', url: 'quranic-grammar.com/learn/level-2/nominal-sentence', icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20"/>' },
  { k: 'lookup', name: 'Word lookup', d: 'Any English word, in the Quran', url: 'quranic-grammar.com/resources/word-lookup', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  { k: 'decoder', name: 'Verse decoder', d: 'Tap a word, see its grammar', url: 'quranic-grammar.com/surahs', icon: '<path d="M4 7h16M4 12h10M4 17h7"/><circle cx="18" cy="16" r="3"/>' },
  { k: 'roots', name: 'Roots', d: 'One root across the whole Quran', url: 'quranic-grammar.com/resources/word-lookup', icon: '<path d="M5 20V10M10 20V4M15 20v-7M20 20V8"/>' },
];
const step = LESSON_STEPS[1];
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <!-- Google Analytics (GA4) and Ahrefs. Queued now, loaded shortly after the page has
       finished loading, so they never compete with the first screen on a slow phone. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1MSBYYQT5Z');
    addEventListener('load', function () {
      setTimeout(function () {
        var g = document.createElement('script'); g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=G-1MSBYYQT5Z'; document.head.appendChild(g);
        var a = document.createElement('script'); a.async = true; a.src = 'https://analytics.ahrefs.com/analytics.js'; a.setAttribute('data-key', 'sW/uZfxMauSpqoKnSL6i6g'); document.head.appendChild(a);
      }, 1500);
    });
  </script>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fbfcfd" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL.href} />
  <meta property="og:site_name" content="Quranic Grammar" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Quranic Grammar RSS" href="/rss.xml" />
  <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Quranic Grammar',
    url: 'https://www.quranic-grammar.com/',
    description,
    inLanguage: 'en',
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: 'https://www.quranic-grammar.com/search/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' },
  })} />
</head>
<body>
<a href="#main-content" class="skip">Skip to main content</a>
<header class="site">
  <a class="brand" href="/" aria-label="Quranic Grammar, home">
    <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="9" fill="oklch(18% 0.03 240)"/><path d="M9 19h14" stroke="#fff" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="12" r="2.6" fill="oklch(79% 0.14 72)"/><circle cx="16" cy="24.5" r="1.6" fill="#fff"/></svg>
    <span>Quranic Grammar</span>
  </a>
  <nav aria-label="Primary"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/">Resources</a><a href="/about/">About</a></nav>
  <div class="right">
    <a class="btn small primary start" href="/learn/">Start learning</a>
    <details class="menu">
      <summary aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
      <div class="menu-panel"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/">Resources</a><a href="/about/">About and feedback</a></div>
    </details>
  </div>
</header>

<main id="main-content">
<section class="hero" aria-labelledby="hero-h">
  <p class="welcome" aria-live="polite"><span>Welcome back.</span><span id="welcome-next"></span></p>
  <h1 id="hero-h" class="rise">Learn the language of the Quran.</h1>
  <p class="lede rise" style="--d:.08s">Short, clear lessons that take you from the Arabic alphabet to reading a verse and knowing what every word does. Free, for everyone.</p>
  <div class="cta rise" style="--d:.16s">
    <a class="btn primary" id="primary-cta" href={startHref}>Start with the alphabet</a>
    <a class="btn" href={readerHref}>I can already read Arabic</a>
  </div>
  <p class="fine rise" style="--d:.2s">No sign-up. No ads. Works on any phone.</p>

  <div class="stagebg rise" style="--d:.28s">
    <div class="app" id="app">
      <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="url" id="url" aria-hidden="true">{TABS[0].url}</span><span class="pad"></span></div>
      <div class="body">
        <div class="tabs" role="tablist" aria-label="Try the tools">
          {TABS.map((t, i) => (
            <button class="tab" role="tab" type="button" id={`t-${t.k}`} aria-controls={`p-${t.k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-k={t.k} data-url={t.url}>
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} /></span>
              <b>{t.name}</b><span class="d">{t.d}</span><i class="timer" aria-hidden="true"></i>
            </button>
          ))}
        </div>
        <div class="panels">
          <!-- Lesson: L2.01, three steps -->
          <div class="panel on" role="tabpanel" id="p-lesson" aria-labelledby="t-lesson" data-k="lesson">
            <h2 class="vh">A lesson: the nominal sentence</h2>
            <div class="tool" id="w-lesson">
              <div class="ls" data-ghost>
                <div class="ls-bar" aria-hidden="true"><i class="done"></i><i class="now"></i><i></i></div>
                <p class="ls-crumb">Level 2 · The nominal sentence</p>
                <div class="ls-body">
                  <div><p class="ls-step">Step 2 of 3</p><h3 class="ls-h">{step.h}</h3><p class="ls-p" set:html={step.p} /><p class="ls-fb" aria-live="polite"></p></div>
                  <div class="ls-stage"><div class="ls-tiles" dir="rtl" lang="ar">
                    <button class="tile" type="button" data-k="he" tabindex="-1"><span class="ar">هُوَ</span><span class="en" lang="en">he</span></button>
                    <span class="tile ghost" aria-hidden="true"><b dir="ltr">is</b><span class="en">English only</span></span>
                    <button class="tile" type="button" data-k="first" tabindex="-1"><span class="ar">ٱلْأَوَّلُ</span><span class="en" lang="en">the First</span></button>
                  </div><p class="ls-ref">Al-Hadid 57:3</p></div>
                </div>
                <div class="ls-nav js-only"><button class="ls-back" type="button">Back</button><span class="ls-count">2 / 3</span><button class="ls-next" type="button">Next</button></div>
              </div>
            </div>
          </div>
          <!-- Word lookup -->
          <div class="panel" role="tabpanel" id="p-lookup" aria-labelledby="t-lookup" data-k="lookup">
            <h2>Word lookup</h2><p class="ln">Start from a word you already know.</p>
            <div class="tool" id="w-lookup">
              <form class="lk-form js-only" role="search" action="/resources/word-lookup/">
                <label class="vh" for="lk-q">Search the Quran by an English word</label>
                <div class="lk-bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="lk-q" type="search" autocomplete="off" spellcheck="false" placeholder="Type an English word" enterkeyhint="search"></div>
                <p class="lk-hint">Press Enter to search every word of the Quran.</p>
              </form>
              <div class="lk-chips js-only" role="group" aria-label="Try a word">{LOOKUP_KEYS.map((k) => <button class="chip" type="button" aria-pressed={k === 'knowledge' ? 'true' : 'false'}>{k}</button>)}</div>
              <div class="lk-out" aria-live="polite" set:html={lookupResult('knowledge')} />
              <a class="full-link" href="/resources/word-lookup/">Open the full word lookup →</a>
            </div>
          </div>
          <!-- Verse decoder -->
          <div class="panel" role="tabpanel" id="p-decoder" aria-labelledby="t-decoder" data-k="decoder">
            <h2>Verse decoder · Taha 20:114</h2><p class="ln">Every word of every surah, explained.</p>
            <div class="tool" id="w-decoder">
              <div class="dc-v" lang="ar" role="group" aria-label="The words of the dua. Choose one.">
                {DECODER.map((w, i) => <button class={`dc-w ${w.t}`} type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${w.m}, ${w.type}`}><span class="ar" set:html={w.ar} /></button>)}
              </div>
              <dl class="dc-out" aria-live="polite" set:html={decoderReadout(0)} />
              <p class="dc-note">“My Lord, increase me in knowledge.” Taha 20:114.</p>
            </div>
          </div>
          <!-- Roots -->
          <div class="panel" role="tabpanel" id="p-roots" aria-labelledby="t-roots" data-k="roots">
            <h2>Roots</h2><p class="ln">Learn one root, recognise it everywhere.</p>
            <div class="tool" id="w-roots">
              <div class="rt-head"><div class="rt-big"><span class="rt-n">{knowledge.total}</span><small class="rt-s">times · {ROOTS.knowledge.gloss} · in {knowledge.surahs} of 114 surahs</small></div><span class="rt-root" lang="ar" dir="rtl">{ROOTS.knowledge.ar}</span></div>
              <div class="rt-rib" role="img" aria-label="Where the root for knowledge appears, surah by surah, from Al-Fatiha on the right">
                {knowledge.per.map((c, s) => <i class:list={[{ z: !c, sel: s === 1 }]} data-s={s} style={`height:${barHeight(c, knowledge.max)}`}></i>)}
              </div>
              <div class="rt-ends" aria-hidden="true"><span>Surah 1</span><span>Surah 114</span></div>
              <p class="rt-read" aria-live="polite" set:html={surahLine('knowledge', 1)} />
              <div class="lk-chips js-only" role="group" aria-label="Choose a root">{ROOT_KEYS.map((k) => <button class="chip" type="button" aria-pressed={k === 'knowledge' ? 'true' : 'false'}>{k}</button>)}</div>
            </div>
          </div>
          <button class="replay" type="button" id="replay">Play the tour again</button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <!-- The course map: one card per level, with a small sample of what it teaches.
       The bar under each card has a segment per lesson; src/scripts/home.ts fills them from saved progress. -->
  <section class="sec" aria-labelledby="levels-h">
    <div class="sec-head"><div><p class="eyebrow">The course</p><h2 id="levels-h">Five levels, from letters to reading.</h2></div><p>Each level ends with a surah you read on your own. Your progress stays on your phone, no account needed.</p></div>
    <ol class="track">
      {LEVELS.map((l) => (
        <li class="card" data-level={l.level}>
          <span class="here">You are here</span>
          <div class="c-top"><span class="c-lvl">Level {l.level}</span><span>{l.count} lessons</span></div>
          <h3>{l.name}</h3>
          <div class="spec" lang="ar" aria-hidden="true" set:html={l.spec} />
          <p class="c-end">{l.end}</p>
          <div class="segs" aria-hidden="true">{Array.from({ length: l.count }, () => <i></i>)}</div>
          <div class="c-foot"><span class="cp">Ends with {l.cp}</span><span class="pct"></span></div>
          <a class="cover" href={l.href}><span class="vh">Level {l.level}, {l.name}: start</span></a>
        </li>
      ))}
    </ol>
  </section>

  <!-- The reader: Al-Ikhlas renders here; other surahs load from public/data/home-reader/<n>.json. -->
  <section class="sec" aria-labelledby="surahs-h">
    <div class="sec-head"><div><p class="eyebrow">Read along</p><h2 id="surahs-h">The short surahs, word by word.</h2></div><p>Al-Fatiha and every surah of Juz ʿAmma. Tap any word to see what it means, where it comes from and what it does in the verse.</p></div>
    <div class="rd-stage">
      <div class="rd-win" id="reader">
        <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="url" id="rd-url" aria-hidden="true">quranic-grammar.com/surahs/{reader.id}</span><span class="pad"></span></div>
        <div class="rd-body">
          <nav class="rd-side" aria-label="Surahs">
            <div class="rd-find js-only"><label class="vh" for="rd-q">Find a surah</label><input id="rd-q" type="search" placeholder="Find a surah" autocomplete="off" spellcheck="false"></div>
            <ul class="rd-list">
              {surahs.map((s) => (
                <li data-find={`${s.data.surahNumber} ${s.data.name}`}><a href={`/surahs/${s.id}/`} data-n={s.data.surahNumber} aria-current={s.data.surahNumber === reader.number ? 'true' : undefined}>
                  <span class="n">{s.data.surahNumber}</span><span class="en">{s.data.name}<small>{s.data.verseCount} ayahs</small></span><span class="ar" lang="ar" dir="rtl">{s.data.nameArabic}</span>
                </a></li>
              ))}
            </ul>
          </nav>
          <div class="rd-main">
            <div class="rd-read" id="rd-read" set:html={readerText(reader)} />
            <div class="rd-card"><div class="in" id="rd-card" aria-live="polite" set:html={readerCard(reader.ayahs[0].words[0])} /></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-label="How the site works">
    <div class="bento">
      <div><b>Sources on every lesson.</b><p>Each lesson shows where its facts come from.</p><ul class="chips-s"><li>Quranic Arabic Corpus</li><li>al-Ajurrumiyyah</li><li>Madinah books</li><li>Tanzil text</li></ul></div>
      <div><b>Free, for everyone.</b><p>No sign-up, no ads, nothing to buy. It works on any phone.</p></div>
      <div><b>Found a mistake?</b><p>Every page has a way to report it, and we fix it. <a href="/about/#feedback">Send feedback</a></p></div>
    </div>
  </section>
</div>

<section class="close" aria-labelledby="close-h">
  <div class="in">
    <h2 class="vh" id="close-h">A dua to begin</h2>
    <ul class="dua" lang="ar" dir="rtl">
      {DUA.map((w, i) => <li><button type="button" aria-pressed="false" data-g={i}><span class="ar">{w.ar}</span><small lang="en">{w.en}</small></button></li>)}
    </ul>
    <p class="gloss js-only" id="gloss" aria-live="polite">Tap a word.</p>
    <p class="mean">“My Lord, increase me in knowledge.”</p>
    <p class="ref">Taha 20:114</p>
    <div class="cta"><a class="btn primary" href={startHref}>Start with the alphabet</a><a class="btn" href="/learn/">See the whole course</a></div>
  </div>
</section>
</main>

<footer class="foot">
  <div class="in">
    <nav aria-label="Footer"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/">Resources</a><a href="/about/">About and feedback</a><a href="/rss.xml">RSS</a></nav>
    <p>Word data from the <a href="https://corpus.quran.com/">Quranic Arabic Corpus</a> (Kais Dukes, GPL). Quran text after <a href="https://tanzil.net/">Tanzil</a>. English meanings on this site are our own plain-English wording, not a translation.</p>
  </div>
</footer>
<CookieBanner tone="light" />
<script type="application/json" id="rd-data" is:inline set:html={JSON.stringify(reader).replace(/<\//g, '<\\/')}></script>
<script type="application/json" id="course-order" is:inline set:html={JSON.stringify(courseOrder).replace(/<\//g, '<\\/')}></script>
<script>
  import '../scripts/home';
</script>
</body>
</html>
