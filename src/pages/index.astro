---
/**
 * Home page. Light only, standalone (no BaseLayout): the shared header still carries the
 * old theme toggle and serif fonts, so this page has its own lean header until the site
 * shell is redone.
 * The hero is a product tour: a window with four working tools that plays a short demo
 * of each, then hands control to the visitor. Every tool renders its first state here,
 * so the page reads without JavaScript; src/scripts/home.ts adds the behaviour.
 */
import { getCollection } from 'astro:content';
import SiteNav from '../components/SiteNav.astro';
import SiteFoot from '../components/SiteFoot.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/fonts.css';
import '../styles/home.css';
import { readFileSync } from 'node:fs';
import { testimonials } from '../data/testimonials';
import { LESSON_STEPS, DECODER, DUA, LOOKUP_KEYS, ROOT_KEYS, ROOTS, lookupResult, decoderReadout, rootStats, barHeight, surahLine, readerText, readerCard, verbCells, verbDetail, verbDefaultForm, type VerbRoot, type ReaderSurah } from '../lib/home-tools';

const lessons = (await getCollection('lessons')).sort((a, b) => a.data.level - b.data.level || a.data.order - b.data.order);
const surahs = (await getCollection('surahs')).sort((a, b) => a.data.surahNumber - b.data.surahNumber);
// The resources hub (/resources/): every guide in the collection, plus the two live tools.
const guides = (await getCollection('resources')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const verbData = JSON.parse(readFileSync('public/data/verb-forms.json', 'utf8'));
const verbRoots: number = verbData.meta.roots;
// The verb generator on the bench shows three real roots; the page embeds them so the client can switch.
const benchVerbs = ['نزل', 'علم', 'كتب'].map((r) => verbData.roots.find((x: VerbRoot) => x.root === r)).filter(Boolean) as VerbRoot[];
// Four guides are shown as sheets; the rest form a reading path, in a suggested order (short titles and lines are ours).
const SHEET_IDS = ['case-endings-chart', 'pronoun-charts', 'verb-forms-master-reference', '200-most-used-words'];
const PATH: [string, string, string][] = [
  ['quran-arabic-vs-msa', 'Quranic vs Modern Standard Arabic', 'Decide which Arabic to study first, from your goal.'],
  ['learning-roadmap', 'Learning Roadmap', 'The phases from beginner to Quranic analysis.'],
  ['arabic-in-7-principles', 'Arabic in 7 Principles', 'The always-open reference card.'],
  ['glossary', 'Grammar Glossary', 'Every term, in Arabic and plain English.'],
  ['root-system', 'Root System Guide', 'How words grow from three letters.'],
  ['verb-conjugation-tables', 'Conjugation Tables', 'All ten forms, every person and tense.'],
];
for (const id of [...SHEET_IDS, ...PATH.map((x) => x[0])]) if (!guides.some((g) => g.id === id)) throw new Error(`home library: resource "${id}" is missing from the collection`);
// A guide added to the collection later appears at the end of the path with its own title and description.
const extraGuides = guides.filter((g) => ![...SHEET_IDS, ...PATH.map((x) => x[0])].includes(g.id));
const railGuides: [string, string, string][] = [...PATH, ...extraGuides.map((g) => [g.id, g.data.title, g.data.description ?? ''] as [string, string, string])];
const firstOf = (level: number) => lessons.find((l) => l.data.level === level)!;

// Each level's card shows a small sample of what it teaches (spec), and the surah its checkpoint reads (cp).
const LEVELS = [
  { name: 'Foundation', end: 'Read the letters and vowel marks of any verse.', cp: 'Al-Ikhlas',
    spec: '<div class="row"><span class="tile"><span class="ar">بَ</span><small lang="en">ba</small></span><span class="tile"><span class="ar">بِ</span><small lang="en">bi</small></span><span class="tile"><span class="ar">بُ</span><small lang="en">bu</small></span></div><span class="line" lang="en">One letter, three vowels</span>' },
  { name: 'Core grammar', end: 'Name the parts of a sentence and say why a word ends the way it does.', cp: 'Al-Kawthar',
    spec: '<div class="row sm"><span class="tile on"><span class="ar">كِتَابٌ</span><small lang="en">rafʿ</small></span><span class="tile"><span class="ar">كِتَابًا</span><small lang="en">naṣb</small></span><span class="tile"><span class="ar">كِتَابٍ</span><small lang="en">jarr</small></span></div><span class="line" lang="en">“A book”, in its three cases</span>' },
  { name: 'Intermediate', end: 'Recognise a verb, its person and its form.', cp: 'Al-ʿAsr',
    spec: '<div class="lbls"><span><span class="ar v">قَالَ</span><small lang="en">he said</small></span><span><span class="ar v">يَقُولُ</span><small lang="en">he says</small></span><span><span class="ar v">قُلْ</span><small lang="en">say!</small></span></div><span class="line" lang="en">One root, <bdi class="rootl" lang="ar" dir="rtl">ق و ل</bdi>, three verbs</span>' },
  { name: 'Advanced', end: 'Follow long and careful sentences.', cp: 'Ad-Duha',
    spec: '<div class="lbls"><span><span class="ar p">لَآ</span><small lang="en">no</small></span><span><span class="ar k">إِلَٰهَ</span><small lang="en">god</small></span><span><span class="ar p">إِلَّا</span><small lang="en">except</small></span><span><span class="ar k">ٱللَّهُ</span><small lang="en">Allah</small></span></div><span class="line" lang="en">Negation, then exception</span>' },
  { name: 'Applied study', end: 'Read a passage and explain every word.', cp: 'Luqman’s counsel',
    spec: '<span class="ar big">بِسْمِ ٱللَّهِ</span><span class="line" lang="en">bi: a preposition · ismi: genitive, after bi<br>llāhi: genitive, the second half of an iḍāfah</span>' },
].map((l, i) => ({ ...l, level: i + 1, count: lessons.filter((x) => x.data.level === i + 1).length, href: `/learn/${firstOf(i + 1).id}/` }));

const startHref = LEVELS[0].href;
// For the "continue where you left off" button: lesson ids and titles, in course order.
const courseOrder = lessons.map((l) => [l.id, l.data.title]);

const knowledge = rootStats('knowledge');
// The reader opens on Al-Ikhlas, the Level 1 checkpoint (generated by npm run home:data).
const reader: ReaderSurah = JSON.parse(readFileSync('public/data/home-reader/112.json', 'utf8'));
const title = 'Quranic Grammar · Learn the language of the Quran, free';
const description = 'Free lessons in the Arabic of the Quran, from the alphabet to reading a verse and knowing what every word does. With a word lookup, a verse decoder and a root map.';
const canonicalURL = new URL('/', Astro.site);
const ogImageURL = new URL('/images/og-default.jpg', Astro.site);

const TABS = [
  { k: 'lesson', name: 'Lessons', d: 'One idea at a time, then check it', url: 'quranic-grammar.com/learn/level-2/nominal-sentence', icon: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20"/>' },
  { k: 'lookup', name: 'Word lookup', d: 'Any English word, in the Quran', url: 'quranic-grammar.com/resources/find', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  { k: 'decoder', name: 'Verse decoder', d: 'Tap a word, see its grammar', url: 'quranic-grammar.com/surahs', icon: '<path d="M4 7h16M4 12h10M4 17h7"/><circle cx="18" cy="16" r="3"/>' },
  { k: 'roots', name: 'Roots', d: 'One root across the whole Quran', url: 'quranic-grammar.com/resources/find', icon: '<path d="M5 20V10M10 20V4M15 20v-7M20 20V8"/>' },
];
const step = LESSON_STEPS[1];
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <!-- Google Analytics (GA4) and Ahrefs. Queued now, loaded shortly after the page has
       finished loading, so they never compete with the first screen on a slow phone. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1MSBYYQT5Z');
    addEventListener('load', function () {
      setTimeout(function () {
        var g = document.createElement('script'); g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=G-1MSBYYQT5Z'; document.head.appendChild(g);
        var a = document.createElement('script'); a.async = true; a.src = 'https://analytics.ahrefs.com/analytics.js'; a.setAttribute('data-key', 'sW/uZfxMauSpqoKnSL6i6g'); document.head.appendChild(a);
      }, 1500);
    });
  </script>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fbfcfd" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL.href} />
  <meta property="og:site_name" content="Quranic Grammar" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Quranic Grammar RSS" href="/rss.xml" />
  <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Quranic Grammar',
    url: 'https://www.quranic-grammar.com/',
    description,
    inLanguage: 'en',
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: 'https://www.quranic-grammar.com/search/?q={search_term_string}' }, 'query-input': 'required name=search_term_string' },
  })} />
</head>
<body>
<a href="#main-content" class="skip">Skip to main content</a>
<SiteNav />

<main id="main-content">
<section class="hero" aria-labelledby="hero-h">
  <p class="welcome" aria-live="polite"><span>Welcome back.</span><span id="welcome-next"></span></p>
  <h1 id="hero-h" class="rise">Learn the language of the Quran.</h1>
  <p class="lede rise" style="--d:.08s">Short, clear lessons that take you from the Arabic alphabet to reading a verse and knowing what every word does. Free, for everyone.</p>
  <div class="cta rise" style="--d:.16s">
    <a class="btn primary" id="primary-cta" href="/learn/">Start learning</a>
    <a class="btn" href="/resources/">Explore the free resources</a>
  </div>
  <p class="fine rise" style="--d:.2s">No sign-up. No ads. Works on any phone.</p>

  <div class="stagebg rise" style="--d:.28s">
    <div class="app" id="app">
      <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="url" id="url" aria-hidden="true">{TABS[0].url}</span><span class="pad"></span></div>
      <div class="body">
        <div class="tabs" role="tablist" aria-label="Try the tools">
          {TABS.map((t, i) => (
            <button class="tab" role="tab" type="button" id={`t-${t.k}`} aria-controls={`p-${t.k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-k={t.k} data-url={t.url}>
              <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} /></span>
              <b>{t.name}</b><span class="d">{t.d}</span><i class="timer" aria-hidden="true"></i>
            </button>
          ))}
        </div>
        <div class="panels">
          <!-- Lesson: L2.01, three steps -->
          <div class="panel on" role="tabpanel" id="p-lesson" aria-labelledby="t-lesson" data-k="lesson">
            <h2 class="vh">A lesson: the nominal sentence</h2>
            <div class="tool" id="w-lesson">
              <div class="ls" data-ghost>
                <div class="ls-bar" aria-hidden="true"><i class="done"></i><i class="now"></i><i></i></div>
                <p class="ls-crumb">Level 2 · The nominal sentence</p>
                <div class="ls-body">
                  <div><p class="ls-step">Step 2 of 3</p><h3 class="ls-h">{step.h}</h3><p class="ls-p" set:html={step.p} /><p class="ls-fb" aria-live="polite"></p></div>
                  <div class="ls-stage"><div class="ls-tiles" dir="rtl" lang="ar">
                    <button class="tile" type="button" data-k="he" tabindex="-1"><span class="ar">هُوَ</span><span class="en" lang="en">he</span></button>
                    <span class="tile ghost" aria-hidden="true"><b dir="ltr">is</b><span class="en">English only</span></span>
                    <button class="tile" type="button" data-k="first" tabindex="-1"><span class="ar">ٱلْأَوَّلُ</span><span class="en" lang="en">the First</span></button>
                  </div><p class="ls-ref">Al-Hadid 57:3</p></div>
                </div>
                <div class="ls-nav js-only"><button class="ls-back" type="button">Back</button><span class="ls-count">2 / 3</span><button class="ls-next" type="button">Next</button></div>
              </div>
            </div>
          </div>
          <!-- Word lookup -->
          <div class="panel" role="tabpanel" id="p-lookup" aria-labelledby="t-lookup" data-k="lookup">
            <h2>Word lookup</h2><p class="ln">Start from a word you already know.</p>
            <div class="tool" id="w-lookup">
              <form class="lk-form js-only" role="search" action="/resources/find/">
                <label class="vh" for="lk-q">Search the Quran by an English word</label>
                <div class="lk-bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="lk-q" type="search" autocomplete="off" spellcheck="false" placeholder="Type an English word" enterkeyhint="search"></div>
                <p class="lk-hint">Press Enter to search every word of the Quran.</p>
              </form>
              <div class="lk-chips js-only" role="group" aria-label="Try a word">{LOOKUP_KEYS.map((k) => <button class="chip" type="button" aria-pressed={k === 'knowledge' ? 'true' : 'false'}>{k}</button>)}</div>
              <div class="lk-out" aria-live="polite" set:html={lookupResult('knowledge')} />
              <a class="full-link" href="/resources/find/">Open the full finder →</a>
            </div>
          </div>
          <!-- Verse decoder -->
          <div class="panel" role="tabpanel" id="p-decoder" aria-labelledby="t-decoder" data-k="decoder">
            <h2>Verse decoder · Taha 20:114</h2><p class="ln">Every word of every surah, explained.</p>
            <div class="tool" id="w-decoder">
              <div class="dc-v" lang="ar" role="group" aria-label="The words of the dua. Choose one.">
                {DECODER.map((w, i) => <button class={`dc-w ${w.t}`} type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${w.m}, ${w.type}`}><span class="ar" set:html={w.ar} /></button>)}
              </div>
              <dl class="dc-out" aria-live="polite" set:html={decoderReadout(0)} />
              <p class="dc-note">“My Lord, increase me in knowledge.” Taha 20:114.</p>
            </div>
          </div>
          <!-- Roots -->
          <div class="panel" role="tabpanel" id="p-roots" aria-labelledby="t-roots" data-k="roots">
            <h2>Roots</h2><p class="ln">Learn one root, recognise it everywhere.</p>
            <div class="tool" id="w-roots">
              <div class="rt-head"><div class="rt-big"><span class="rt-n">{knowledge.total}</span><small class="rt-s">times · {ROOTS.knowledge.gloss} · in {knowledge.surahs} of 114 surahs</small></div><span class="rt-root" lang="ar" dir="rtl">{ROOTS.knowledge.ar}</span></div>
              <div class="rt-rib" role="img" aria-label="Where the root for knowledge appears, surah by surah, from Al-Fatiha on the right">
                {knowledge.per.map((c, s) => <i class:list={[{ z: !c, sel: s === 1 }]} data-s={s} style={`height:${barHeight(c, knowledge.max)}`}></i>)}
              </div>
              <div class="rt-ends" aria-hidden="true"><span>Surah 1</span><span>Surah 114</span></div>
              <p class="rt-read" aria-live="polite" set:html={surahLine('knowledge', 1)} />
              <div class="lk-chips js-only" role="group" aria-label="Choose a root">{ROOT_KEYS.map((k) => <button class="chip" type="button" aria-pressed={k === 'knowledge' ? 'true' : 'false'}>{k}</button>)}</div>
            </div>
          </div>
          <button class="replay" type="button" id="replay">Play the tour again</button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <!-- The course map: one card per level, with a small sample of what it teaches.
       The bar under each card has a segment per lesson; src/scripts/home.ts fills them from saved progress. -->
  <section class="sec" aria-labelledby="levels-h">
    <div class="sec-head"><h2 id="levels-h">Five levels, from letters to reading.</h2></div>
    <ol class="track">
      {LEVELS.map((l) => (
        <li class="card" data-level={l.level}>
          <span class="here">You are here</span>
          <div class="c-top"><span class="c-lvl">Level {l.level}</span><span>{l.count} lessons</span></div>
          <h3>{l.name}</h3>
          <div class="spec" lang="ar" aria-hidden="true" set:html={l.spec} />
          <p class="c-end">{l.end}</p>
          <div class="segs" aria-hidden="true">{Array.from({ length: l.count }, () => <i></i>)}</div>
          <div class="c-foot"><span class="cp">Ends with {l.cp}</span><span class="pct"></span></div>
          <a class="cover" href={l.href}><span class="vh">Level {l.level}, {l.name}: start</span></a>
        </li>
      ))}
    </ol>
  </section>

  <!-- The reader: Al-Ikhlas renders here; other surahs load from public/data/home-reader/<n>.json. -->
  <section class="sec" aria-labelledby="surahs-h">
    <div class="sec-head"><h2 id="surahs-h">The short surahs, word by word.</h2></div>
    <div class="rd-stage">
      <div class="rd-win" id="reader">
        <div class="bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="url" id="rd-url" aria-hidden="true">quranic-grammar.com/surahs/{reader.id}</span><span class="pad"></span></div>
        <div class="rd-body">
          <nav class="rd-side" aria-label="Surahs">
            <div class="rd-find js-only"><label class="vh" for="rd-q">Find a surah</label><input id="rd-q" type="search" placeholder="Find a surah" autocomplete="off" spellcheck="false"></div>
            <ul class="rd-list">
              {surahs.map((s) => (
                <li data-find={`${s.data.surahNumber} ${s.data.name}`}><a href={`/surahs/${s.id}/`} data-n={s.data.surahNumber} aria-current={s.data.surahNumber === reader.number ? 'true' : undefined}>
                  <span class="n">{s.data.surahNumber}</span><span class="en">{s.data.name}<small>{s.data.verseCount} ayahs</small></span><span class="ar" lang="ar" dir="rtl">{s.data.nameArabic}</span>
                </a></li>
              ))}
            </ul>
          </nav>
          <div class="rd-main">
            <div class="rd-read" id="rd-read" set:html={readerText(reader)} />
            <div class="rd-card"><div class="in" id="rd-card" aria-live="polite" set:html={readerCard(reader.ayahs[0].words[0])} /></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The library (/resources/): four of the charts as sheets, the two live tools running, and the other guides as a reading path.
       Every guide in the resources collection is reachable from here; one that is added later lands at the end of the path. -->
  <section class="sec lib" aria-labelledby="lib-h">
    <div class="sec-head"><h2 id="lib-h">Free tools to keep open while you read.</h2></div>
    <div class="desk">
      <ul class="sheets" tabindex="0" aria-label="Four reference charts">
      <li><a class="sheet" href="/resources/case-endings-chart/" aria-label="Case Endings Chart: open the full version">
        <div class="sh-head"><small>CHART</small><h3>Case Endings Chart</h3></div>
        <div class="sh-body" aria-hidden="true">
          <table class="tb"><thead><tr><th>Case</th><th>Ending</th><th>Example</th></tr></thead><tbody>
            <tr><td><b>Doer</b><br><em>rafʿ</em></td><td>-un</td><td><span class="ar" lang="ar" dir="rtl">كِتَابٌ</span></td></tr>
            <tr><td><b>Receiver</b><br><em>naṣb</em></td><td>-an</td><td><span class="ar" lang="ar" dir="rtl">كِتَابًا</span></td></tr>
            <tr><td><b>“Of” word</b><br><em>jarr</em></td><td>-in</td><td><span class="ar" lang="ar" dir="rtl">كِتَابٍ</span></td></tr>
            <tr><td><b>Two, doer</b><br><em>dual</em></td><td>-āni</td><td><span class="ar" lang="ar" dir="rtl">كِتَابَانِ</span></td></tr>
            <tr><td><b>Two, other</b><br><em>dual</em></td><td>-ayni</td><td><span class="ar" lang="ar" dir="rtl">كِتَابَيْنِ</span></td></tr>
          </tbody></table>
          <p>Also: sound plurals, broken plurals and the five nouns.</p>
        </div>
        <div class="sh-foot"><span>Open the full chart</span><span aria-hidden="true">→</span></div>
      </a></li>
      <li><a class="sheet" href="/resources/pronoun-charts/" aria-label="Pronoun Reference Charts: open the full version">
        <div class="sh-head"><small>CHART</small><h3>Pronoun Reference Charts</h3></div>
        <div class="sh-body" aria-hidden="true">
          <table class="tb"><thead><tr><th>Who</th><th>Arabic</th><th>Says</th></tr></thead><tbody>
            <tr><td><b>I</b></td><td><span class="ar" lang="ar" dir="rtl">أَنَا</span></td><td><em>anaa</em></td></tr>
            <tr><td><b>we</b></td><td><span class="ar" lang="ar" dir="rtl">نَحْنُ</span></td><td><em>nahnu</em></td></tr>
            <tr><td><b>you (m)</b></td><td><span class="ar" lang="ar" dir="rtl">أَنْتَ</span></td><td><em>anta</em></td></tr>
            <tr><td><b>he</b></td><td><span class="ar" lang="ar" dir="rtl">هُوَ</span></td><td><em>huwa</em></td></tr>
            <tr><td><b>she</b></td><td><span class="ar" lang="ar" dir="rtl">هِيَ</span></td><td><em>hiya</em></td></tr>
            <tr><td><b>they (m)</b></td><td><span class="ar" lang="ar" dir="rtl">هُمْ</span></td><td><em>hum</em></td></tr>
          </tbody></table>
          <p>Also: attached pronouns, “this/that” and “who/which”.</p>
        </div>
        <div class="sh-foot"><span>Open the full chart</span><span aria-hidden="true">→</span></div>
      </a></li>
      <li><a class="sheet" href="/resources/verb-forms-master-reference/" aria-label="Verb Forms Master Reference: open the full version">
        <div class="sh-head"><small>CHEAT SHEET</small><h3>Verb Forms Master Reference</h3></div>
        <div class="sh-body" aria-hidden="true">
          <table class="tb"><thead><tr><th>Form</th><th>Pattern</th><th>Adds</th></tr></thead><tbody>
            <tr><td><b>I</b></td><td><span class="ar" lang="ar" dir="rtl">فَعَلَ</span></td><td><em>basic action</em></td></tr>
            <tr><td><b>II</b></td><td><span class="ar" lang="ar" dir="rtl">فَعَّلَ</span></td><td><em>intensify, cause</em></td></tr>
            <tr><td><b>III</b></td><td><span class="ar" lang="ar" dir="rtl">فَاعَلَ</span></td><td><em>do with or toward someone</em></td></tr>
            <tr><td><b>IV</b></td><td><span class="ar" lang="ar" dir="rtl">أَفْعَلَ</span></td><td><em>cause something</em></td></tr>
            <tr><td><b>V</b></td><td><span class="ar" lang="ar" dir="rtl">تَفَعَّلَ</span></td><td><em>reflexive of II</em></td></tr>
            <tr><td><b>X</b></td><td><span class="ar" lang="ar" dir="rtl">اِسْتَفْعَلَ</span></td><td><em>seek, request</em></td></tr>
          </tbody></table>
          <p>All ten forms, with Quranic examples and the root-family tree.</p>
        </div>
        <div class="sh-foot"><span>Open the full sheet</span><span aria-hidden="true">→</span></div>
      </a></li>
      <li><a class="sheet" href="/resources/200-most-used-words/" aria-label="200 Most Common Quranic Words: open the full version">
        <div class="sh-head"><small>WORD LIST</small><h3>200 Most Common Quranic Words</h3></div>
        <div class="sh-body" aria-hidden="true">
          <div class="grid" lang="ar" dir="rtl">
            <div><span class="ar">وَ</span><small lang="en">and</small></div><div><span class="ar">فِي</span><small lang="en">in</small></div><div><span class="ar">مِنْ</span><small lang="en">from</small></div>
            <div><span class="ar">مَا</span><small lang="en">what, not</small></div><div><span class="ar">لَا</span><small lang="en">no, not</small></div><div><span class="ar">إِنَّ</span><small lang="en">indeed</small></div>
            <div><span class="ar">عَلَىٰ</span><small lang="en">on</small></div><div><span class="ar">إِلَىٰ</span><small lang="en">to</small></div><div><span class="ar">بِ</span><small lang="en">with, by</small></div>
            <div><span class="ar">هُوَ</span><small lang="en">he, it</small></div><div><span class="ar">هُمْ</span><small lang="en">they</small></div><div><span class="ar">كَانَ</span><small lang="en">was, is</small></div>
          </div>
          <p>Particles, verbs and nouns: 200 words, about half of all Quranic text.</p>
        </div>
        <div class="sh-foot"><span>Open the full list</span><span aria-hidden="true">→</span></div>
      </a></li>
      </ul>
    </div>

    <div class="bench" id="bench">
      <div class="bench-top"><h3>Two tools you can use right now.</h3><p>No account, nothing to install. Type a word, or pick a root, and read the answer in the Quran's own words.</p></div>
      <div class="wins">
        <section class="w" aria-labelledby="w1-h">
          <div class="w-bar"><i aria-hidden="true"><b></b><b></b><b></b></i><span class="u" aria-hidden="true">quranic-grammar.com/resources/find</span><a href="/resources/find/" aria-label="Open the word finder">Open →</a></div>
          <div class="w-body" id="w-bench">
            <h4 id="w1-h">Word lookup</h4>
            <form class="lk-form js-only" role="search" action="/resources/find/">
              <label class="vh" for="lb-q">Search the Quran by an English word</label>
              <div class="lk-bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input id="lb-q" type="search" autocomplete="off" spellcheck="false" placeholder="Type an English word" enterkeyhint="search"></div>
              <p class="lk-hint">Press Enter to search every word of the Quran.</p>
            </form>
            <div class="lk-chips js-only" role="group" aria-label="Try a word">{LOOKUP_KEYS.map((k) => <button class="chip" type="button" aria-pressed={k === 'mercy' ? 'true' : 'false'}>{k}</button>)}</div>
            <div class="lk-out" aria-live="polite" set:html={lookupResult('mercy')} />
          </div>
        </section>
        <section class="w" aria-labelledby="w2-h">
          <div class="w-bar"><i aria-hidden="true"><b></b><b></b><b></b></i><span class="u" aria-hidden="true">quranic-grammar.com/resources/find</span><a href="/resources/find/" aria-label="Open the word and verb finder">Open →</a></div>
          <div class="w-body" id="w-verbs">
            <h4 id="w2-h">Verb form generator</h4>
            <p class="w-sub">{verbRoots} verbal roots, each moving through the ten forms. Every verb shown is in the Quran; greyed forms are not.</p>
            <div class="chipset js-only" role="group" aria-label="Pick a root">{benchVerbs.map((r, i) => <button type="button" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Root ${r.translit}`}><span class="ar" lang="ar" dir="rtl">{r.root.split('').join(' ')}</span></button>)}</div>
            <div class="cells" role="group" aria-label="The ten verb forms" set:html={verbCells(benchVerbs[0], verbDefaultForm(benchVerbs[0]))} />
            <p class="det" aria-live="polite" set:html={verbDetail(benchVerbs[0], verbDefaultForm(benchVerbs[0]))} />
          </div>
        </section>
      </div>

      <div class="path">
        <h4>{PATH.length + extraGuides.length} guides, <span>in an order that helps most.</span></h4>
        <ol class="rail">
          {railGuides.map(([id, title, line], i) => (
            <li><a href={`/resources/${id}/`}>{i === 0 && <span class="go">START HERE</span>}<b>{title}</b><span class="d">{line}</span></a></li>
          ))}
        </ol>
      </div>
      <div class="bench-foot"><a class="btn primary" href="/resources/">Open all resources</a></div>
    </div>
  </section>

  <!-- Learner quotes, after the reader so a visitor has seen the product first. Each card takes one of three tints.
       The quotes live in src/data/testimonials.ts. -->
  <section class="sec" aria-labelledby="voices-h">
    <div class="sec-head"><h2 id="voices-h">It finally makes sense.</h2></div>
    <div class="stack">
      {testimonials.map((t, i) => (
        <figure class={`sc k${(i % 3) + 1}`} style={`--i:${i}`}>
          <div class="sc-t">
            <blockquote><p>{t.text}</p></blockquote>
            <figcaption class="who"><span class="mono" aria-hidden="true">{t.name.charAt(0)}</span><span><b>{t.name}</b>{t.role && <small>{t.role}</small>}</span></figcaption>
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section class="sec" aria-labelledby="trust-h">
    <div class="sec-head"><h2 id="trust-h">Sourced, free and open to correction.</h2></div>
    <div class="trio">
      <article class="tc">
        <h3>Sources on every lesson.</h3>
        <p>Each lesson shows where its facts come from.<span class="js-only"> Tap a source to see what it feeds.</span></p>
        <div class="well">
          <div class="les" id="les">
            <div class="les-row" lang="ar" dir="rtl">
              <span class="les-w"><span class="ar">هُوَ</span><small lang="en">he</small><span class="tag" lang="en">mubtadaʾ</span></span>
              <span class="les-w"><span class="ar">ٱلْأَوَّلُ</span><small lang="en">the First</small><span class="tag" lang="en">khabar</span></span>
            </div>
            <p class="les-ref">Sample lesson footer · Al-Hadid 57:3</p>
            <ul class="fn">
              <li><button type="button" data-h="1" aria-pressed="false"><sup>1</sup><span><b>Tanzil</b> · the Quran text</span></button></li>
              <li><button type="button" data-h="2" aria-pressed="false"><sup>2</sup><span><b>Quranic Arabic Corpus</b> · word data and roots</span></button></li>
              <li><button type="button" data-h="3" aria-pressed="false"><sup>3</sup><span><b>al-Ajurrumiyyah</b> · classical grammar</span></button></li>
              <li><button type="button" data-h="0" aria-pressed="false"><sup>4</sup><span><b>Madinah books</b> · textbook</span></button></li>
            </ul>
          </div>
        </div>
      </article>

      <article class="tc">
        <h3>Free, for everyone.</h3>
        <p>No sign-up, no ads, nothing to buy. It works on any phone.</p>
        <div class="well rc">
          <div class="rcp" role="img" aria-label="A receipt: every level, the word lookup, the verse decoder and the surah reader are free. Total: free.">
            <h4>QURANIC GRAMMAR · YOUR ORDER</h4>
            <ul aria-hidden="true">
              {LEVELS.map((l) => <li><span>Level {l.level} · {l.name}</span><span>Free</span></li>)}
              <li><span>Word lookup and verse decoder</span><span>Free</span></li>
              <li><span>Surah reader</span><span>Free</span></li>
            </ul>
            <div class="tot" aria-hidden="true"><span>Total</span><b>Free</b></div>
            <p class="fine" aria-hidden="true">No sign-up. No ads. Thank you for reading.</p>
          </div>
        </div>
      </article>

      <article class="tc">
        <h3>Found a mistake?</h3>
        <p>Every page has a way to report it, and we fix it.</p>
        <div class="well fx js-only" id="fx" data-ref={`${reader.name} ${reader.number}:1`}>
          <p class="fx-hint">Try it: tap a word to report it.</p>
          <div class="fx-verse" lang="ar" dir="rtl">
            {reader.ayahs[0].words.slice(0, 3).map((w) => <button class="fx-w" type="button" aria-pressed="false" data-ar={w.ar}><span class="ar">{w.ar}</span><small lang="en">{w.s}</small></button>)}
          </div>
          <p class="fx-ref">{reader.name} {reader.number}:1</p>
          <div class="fx-pan">
            <p>What looks wrong?</p>
            <div class="fx-opts" role="group" aria-label="What looks wrong?"><button type="button" aria-pressed="true">Meaning</button><button type="button" aria-pressed="false">Grammar label</button><button type="button" aria-pressed="false">Arabic text</button><button type="button" aria-pressed="false">Something else</button></div>
            <a class="fx-send" href="/about/#feedback">Continue to the form</a>
          </div>
        </div>
        <a class="link" href="/about/#feedback">Send feedback →</a>
      </article>
    </div>
  </section>
</div>

<section class="close" aria-labelledby="close-h">
  <div class="in">
    <h2 class="vh" id="close-h">A dua to begin</h2>
    <ul class="dua" lang="ar" dir="rtl">
      {DUA.map((w, i) => <li><button type="button" aria-pressed="false" data-g={i}><span class="ar">{w.ar}</span><small lang="en">{w.en}</small></button></li>)}
    </ul>
    <p class="gloss js-only" id="gloss" aria-live="polite">Tap a word.</p>
    <p class="mean">“My Lord, increase me in knowledge.”</p>
    <p class="ref">Taha 20:114</p>
    <div class="cta"><a class="btn primary" href={startHref}>Start with the alphabet</a><a class="btn" href="/learn/">See the whole course</a></div>
  </div>
</section>
</main>

<SiteFoot dua={false} />
<CookieBanner tone="light" />
<script type="application/json" id="rd-data" is:inline set:html={JSON.stringify(reader).replace(/<\//g, '<\\/')}></script>
<script type="application/json" id="vf-data" is:inline set:html={JSON.stringify(benchVerbs).replace(/<\//g, '<\\/')}></script>
<script type="application/json" id="course-order" is:inline set:html={JSON.stringify(courseOrder).replace(/<\//g, '<\\/')}></script>
<script>
  import '../scripts/home';
</script>
</body>
</html>
