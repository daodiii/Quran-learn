---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/primitives/Container.astro';
---

<BaseLayout
  title="Search"
  description="Search lessons, surahs, and resources across the Quranic Grammar site."
>
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </Fragment>
  <Container maxWidth="lg">
    <header class="search-header">
      <h1 class="search-title">Search</h1>
      <p class="search-subtitle">
        Find lessons, surah breakdowns, and resources across the site.
      </p>
    </header>

    <div id="search" class="search-shell"></div>
    <p id="search-fallback" class="search-unavailable" hidden>
      Search index is being built — try again after the next deploy.
    </p>

    <noscript>
      <p class="search-noscript">
        Search requires JavaScript. Browse the
        <a href="/learn/">curriculum</a> or the
        <a href="/surahs/">surah index</a> instead.
      </p>
    </noscript>
  </Container>

  <!--
    Pagefind UI ships from /pagefind/pagefind-ui.js, generated post-build by
    `pagefind --site dist`. Loaded as a plain <script> (not a Vite dynamic
    import) so the bundler doesn't try to resolve it at build time.
  -->
  <script is:inline src="/pagefind/pagefind-ui.js" onload="window.__bootPagefind && window.__bootPagefind()"></script>
  <script is:inline onerror="document.getElementById('search-fallback')?.removeAttribute('hidden')">
    window.__bootPagefind = function () {
      try {
        new window.PagefindUI({
          element: '#search',
          showImages: false,
          resetStyles: false,
          showSubResults: true,
          excerptLength: 30,
          autofocus: true,
        });
      } catch (e) {
        var el = document.getElementById('search-fallback');
        if (el) el.removeAttribute('hidden');
      }
    };
    // If pagefind-ui.js failed to load (e.g. dev/preview before indexing), reveal fallback.
    window.addEventListener('load', function () {
      if (!window.PagefindUI) {
        var el = document.getElementById('search-fallback');
        if (el) el.removeAttribute('hidden');
      }
    });
  </script>
</BaseLayout>

<style>
  .search-header {
    padding-block: var(--spacing-2xl) var(--spacing-lg);
    text-align: center;
  }
  .search-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-text-primary, var(--text-primary));
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 var(--spacing-sm);
  }
  .search-subtitle {
    color: var(--color-text-secondary, var(--text-secondary));
    margin: 0;
  }
  .search-shell {
    margin-block: var(--spacing-xl) var(--spacing-3xl);
  }
  .search-noscript,
  .search-unavailable {
    text-align: center;
    color: var(--color-text-secondary, var(--text-secondary));
    padding-block: var(--spacing-xl);
  }

  /* Pagefind UI variables — match site palette */
  .search-shell :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--accent-gold, #b8860b);
    --pagefind-ui-text: var(--text-primary, #1a1147);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--border-primary, rgba(0, 0, 0, 0.1));
    --pagefind-ui-tag: var(--bg-secondary, #f5f5f5);
    --pagefind-ui-border-radius: var(--radius-lg, 12px);
    --pagefind-ui-font: var(--font-display);
    --pagefind-ui-border-width: 1px;
  }
</style>
