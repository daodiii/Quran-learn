---
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/primitives/Container.astro';

// Build-time read of the shipped dataset: prerenders the root index + chips
// (SEO, graceful no-JS); the client script fetches the same JSON on demand.
const data = JSON.parse(readFileSync('public/data/verb-forms.json', 'utf8'));
const triRoots = data.roots.filter((r: any) => !r.quad);
const quadRoots = data.roots.filter((r: any) => r.quad);
const topRoots = triRoots.slice(0, 18);

const LETTER_ORDER = [...'ءبتثجحخدذرزسشصضطظعغفقكلمنهوي'];
const byLetter = LETTER_ORDER.map(letter => ({
  letter,
  roots: triRoots
    .filter((r: any) => r.root.startsWith(letter))
    .sort((a: any, b: any) => a.root.localeCompare(b.root, 'ar')),
})).filter(g => g.roots.length > 0);

const QUERY_EXAMPLES = [
  { q: 'guide', note: 'by meaning', latin: true },
  { q: 'send down', note: 'by meaning', latin: true },
  { q: 'nzl', note: 'by sound', latin: true },
  { q: 'نصر', note: 'Arabic root' },
];

const FORMS = [
  { n: 1,  past: 'فَعَلَ',       present: 'يَفْعَلُ',      shift: 'basic action' },
  { n: 2,  past: 'فَعَّلَ',      present: 'يُفَعِّلُ',     shift: 'intensify, cause' },
  { n: 3,  past: 'فَاعَلَ',      present: 'يُفَاعِلُ',     shift: 'do with or toward someone' },
  { n: 4,  past: 'أَفْعَلَ',     present: 'يُفْعِلُ',      shift: 'cause something' },
  { n: 5,  past: 'تَفَعَّلَ',     present: 'يَتَفَعَّلُ',    shift: 'reflexive of II' },
  { n: 6,  past: 'تَفَاعَلَ',     present: 'يَتَفَاعَلُ',    shift: 'mutual, gradual' },
  { n: 7,  past: 'اِنْفَعَلَ',    present: 'يَنْفَعِلُ',     shift: 'passive result' },
  { n: 8,  past: 'اِفْتَعَلَ',    present: 'يَفْتَعِلُ',     shift: 'do for oneself' },
  { n: 9,  past: 'اِفْعَلَّ',     present: 'يَفْعَلُّ',      shift: 'colors and defects' },
  { n: 10, past: 'اِسْتَفْعَلَ',  present: 'يَسْتَفْعِلُ',   shift: 'seek, request' },
];
const ROMAN = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'];
---

<BaseLayout
  title="Verb Form Generator"
  description={`Explore all ${data.meta.roots} verbal roots of the Quran across the ten Arabic verb forms: real attested verbs with meanings, occurrence counts, and verse references.`}
>
  <Container size="md" class="vf-container">
    <header class="vf-header">
      <h1 class="vf-title">Verb Form Generator</h1>
      <p class="vf-intro">
        Pick any of the <strong>{data.meta.roots} verbal roots</strong> used in the
        Quran and watch it move through the ten verb forms. Every word shown is a
        real Quranic verb; greyed forms are not used in the Quran for that root.
      </p>
    </header>

    <div class="vf-search-wrap">
      <label class="sr-only" for="vf-search">Search roots by Arabic, transliteration, or meaning</label>
      <input id="vf-search" class="vf-search" type="search" name="root-search"
        autocomplete="off" spellcheck="false"
        placeholder="Search: نزل · nzl · send down…"
        role="combobox" aria-autocomplete="list" aria-controls="vf-suggestions" aria-expanded="false" />
      <div id="vf-suggestions" class="vf-suggestions" role="listbox" aria-label="Matching roots" hidden></div>
    </div>

    <div class="vf-qchips" role="group" aria-labelledby="vf-qchips-label">
      <span class="vf-qchips-label" id="vf-qchips-label">Works with</span>
      {QUERY_EXAMPLES.map(e => (
        <button class:list={['vf-qchip', { 'vf-qchip-latin': e.latin }]} data-q={e.q}>
          {e.latin ? <span>{e.q}</span> : <span lang="ar" dir="rtl">{e.q}</span>}
          <span class="vf-qchip-note">{e.note}</span>
        </button>
      ))}
    </div>

    <div class="vf-chips" aria-label="Most frequent roots">
      {topRoots.map((r: any) => (
        <button class="vf-chip" data-root={r.root}>
          <span lang="ar" dir="rtl">{[...r.root].join(' · ')}</span>
          <span class="vf-chip-count">{r.totalCount}×</span>
        </button>
      ))}
    </div>

    <section id="vf-result" class="vf-result" aria-live="polite" hidden></section>

    <section class="vf-index">
      <h2 class="vf-index-title">All roots by first letter</h2>
      {byLetter.map(group => (
        <details class="vf-letter">
          <summary>
            <span lang="ar" dir="rtl" class="vf-letter-ar">{group.letter}</span>
            <span class="vf-letter-count">{group.roots.length} roots</span>
          </summary>
          <div class="vf-letter-roots">
            {group.roots.map((r: any) => (
              <button class="vf-root-link" data-root={r.root} lang="ar" dir="rtl">
                {[...r.root].join('·')}
              </button>
            ))}
          </div>
        </details>
      ))}
      {quadRoots.length > 0 && (
        <details class="vf-letter">
          <summary>
            <span class="vf-letter-ar" lang="ar" dir="rtl">رباعي</span>
            <span class="vf-letter-count">four-letter roots · {quadRoots.length}</span>
          </summary>
          <div class="vf-letter-roots">
            {quadRoots.map((r: any) => (
              <button class="vf-root-link" data-root={r.root} lang="ar" dir="rtl">
                {[...r.root].join('·')}
              </button>
            ))}
          </div>
        </details>
      )}
    </section>

    <footer class="vf-attribution">
      <p class="vf-crosslink">Looking at a full word instead of a root?
        Try <a href="/resources/word-lookup/">Word Lookup</a>.</p>
      Morphological data: <a href="https://corpus.quran.com" rel="noopener">Quranic
      Arabic Corpus</a> (Kais Dukes, GNU GPL). English glosses © Quranic Grammar.
    </footer>
  </Container>
</BaseLayout>

<script id="vf-forms-meta" type="application/json" set:html={JSON.stringify({ FORMS, ROMAN })} />

<script>
  import { prepareVerbs, searchVerbs } from '../../../lib/verb-search.ts';
  import type { PreparedVerbs } from '../../../lib/verb-search.ts';

  const { FORMS, ROMAN } = JSON.parse(
    document.getElementById('vf-forms-meta')?.textContent || '{}');

  // All dynamic rendering builds real DOM nodes; dataset strings only ever
  // land in textContent or attribute values. No HTML strings anywhere.
  type Kid = Node | string | null | undefined;
  function h(tag: string, attrs: Record<string, string> = {}, ...kids: Kid[]): HTMLElement {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    for (const kid of kids) {
      if (kid === null || kid === undefined) continue;
      node.append(typeof kid === 'string' ? document.createTextNode(kid) : kid);
    }
    return node;
  }
  const scrollBehavior = (): ScrollBehavior =>
    matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  // Wraps matched ranges in <mark>; real nodes only (no innerHTML).
  function marked(text: string, ranges: [number, number][] | null): HTMLElement {
    const span = h('span', {});
    if (!ranges?.length) { span.append(text); return span; }
    let pos = 0;
    for (const [s, e] of ranges) {
      if (s > pos) span.append(text.slice(pos, s));
      span.append(h('mark', {}, text.slice(s, e)));
      pos = e;
    }
    if (pos < text.length) span.append(text.slice(pos));
    return span;
  }

  const resultEl = document.getElementById('vf-result')!;
  let DATA: any = null;
  let VPREP: PreparedVerbs | null = null;
  let loading: Promise<any> | null = null;
  function loadData() {
    if (DATA) return Promise.resolve(DATA);
    loading ??= fetch('/data/verb-forms.json')
      .then(res => { if (!res.ok) throw new Error(String(res.status)); return res.json(); })
      .then(json => { DATA = json; VPREP = prepareVerbs(json.roots); return DATA; })
      .catch(err => {
        loading = null;
        resultEl.replaceChildren(h('p', { class: 'vf-load-error' },
          'The verb data could not be loaded. Check your connection and try again.'));
        resultEl.hidden = false;
        throw err;
      });
    return loading;
  }

  function entryNode(e: any, wazn?: string): HTMLElement {
    const pair = e.present ? `${e.past} / ${e.present}` : String(e.past);
    const exampleHref = `https://quran.com/${encodeURIComponent(String(e.example).replace(':', '/'))}`;
    return h('div', { class: 'vf-entry' },
      h('div', { class: 'vf-entry-en' },
        e.meaning === null
          ? h('p', { class: 'vf-meaning' }, h('em', {}, 'meaning coming soon'))
          : h('p', { class: 'vf-meaning' }, String(e.meaning)),
        h('p', { class: 'vf-translit', translate: 'no' }, String(e.translit ?? '')),
        h('p', { class: 'vf-meta-line' },
          h('span', { class: 'vf-count' }, `${Number(e.count)}× in the Quran`),
          h('a', { class: 'vf-example', href: exampleHref, target: '_blank', rel: 'noopener' },
            `e.g. ${e.example}`))),
      h('div', { class: 'vf-entry-ar' },
        h('p', { class: 'vf-verb', lang: 'ar', dir: 'rtl' }, pair),
        wazn ? h('p', { class: 'vf-wazn', lang: 'ar', dir: 'rtl' }, wazn) : null));
  }

  function rowNode(i: number, cls: string, head: Kid[], body: Kid[]): HTMLElement {
    const row = h('li', { class: `vf-row ${cls}`, style: `--i:${i}` }, ...head);
    if (body.length) row.append(h('div', { class: 'vf-row-body' }, ...body));
    return row;
  }

  function renderRoot(root: any) {
    const formKeys = Object.keys(root.forms);
    const formsUsed = formKeys.filter(f => Number(f) <= 10).length;
    const rareKeys = formKeys.filter(f => Number(f) > 10).sort();
    const rows: HTMLElement[] = [];
    let i = 0;

    if (root.quad) {
      for (const [f, list] of Object.entries<any>(root.forms)) {
        rows.push(rowNode(i++, 'vf-row-attested',
          [h('span', { class: 'vf-badge vf-badge-gold' }, `Q${f}`)],
          (list as any[]).map((e) => entryNode(e))));
      }
    } else {
      for (const fm of FORMS) {
        const list = root.forms[String(fm.n)];
        if (!list) {
          rows.push(rowNode(i++, 'vf-row-empty',
            [h('span', { class: 'vf-badge' }, ROMAN[fm.n - 1]),
             h('p', { class: 'vf-empty-note' }, 'not used in the Quran for this root'),
             h('span', { class: 'vf-pattern', lang: 'ar', dir: 'rtl' }, `${fm.past} / ${fm.present}`)],
            []));
        } else {
          rows.push(rowNode(i++, 'vf-row-attested',
            [h('span', { class: 'vf-badge vf-badge-gold' }, ROMAN[fm.n - 1]),
             h('p', { class: 'vf-shift' }, fm.shift)],
            (list as any[]).map((e, j) => entryNode(e, j === 0 ? fm.past : undefined))));
        }
      }
      for (const f of rareKeys) {
        rows.push(rowNode(i++, 'vf-row-attested',
          [h('span', { class: 'vf-badge vf-badge-gold' }, ROMAN[Number(f) - 1] ?? f),
           h('p', { class: 'vf-shift' }, 'rare form, beyond the classical ten')],
          (root.forms[f] as any[]).map((e) => entryNode(e))));
      }
    }

    resultEl.replaceChildren(
      h('div', { class: 'vf-root-header' },
        h('p', { class: 'vf-root-letters', lang: 'ar', dir: 'rtl' }, [...root.root].join(' · ')),
        h('p', { class: 'vf-root-stats' },
          `${root.translit} · ${root.quad ? 'four-letter root' : `${formsUsed} of 10 forms`} · ${Number(root.totalCount)}× in the Quran`)),
      h('ol', { class: 'vf-grid' }, ...rows));
    resultEl.hidden = false;
    setSugHidden(true);
    history.replaceState(null, '', `#root=${encodeURIComponent(root.root)}`);
    resultEl.scrollIntoView({ behavior: scrollBehavior(), block: 'start' });
  }

  async function selectRoot(rootStr: string) {
    const data = await loadData().catch(() => null);
    if (!data) return;
    const root = data.roots.find((r: any) => r.root === rootStr);
    if (root) renderRoot(root);
  }

  const searchEl = document.getElementById('vf-search') as HTMLInputElement;
  const sugEl = document.getElementById('vf-suggestions')!;
  function setSugHidden(hidden: boolean) {
    sugEl.hidden = hidden;
    searchEl?.setAttribute('aria-expanded', String(!hidden));
  }

  async function runSearch(q: string) {
    if (q.length < 2) { setSugHidden(true); return; }
    const data = await loadData().catch(() => null);
    if (!data || !VPREP) return;
    const matches = searchVerbs(VPREP, q, 12);
    const rows = matches.length
      ? matches.map((m) =>
          h('button', { class: 'vf-sug', role: 'option', 'data-root': m.root.root },
            h('span', { class: 'vf-sug-en' },
              h('span', { class: 'vf-sug-meaning' },
                marked(m.meaning ?? '', m.reason === 'meaning' ? m.ranges : null)),
              h('span', { class: 'vf-sug-sub', translate: 'no' },
                `${m.root.translit} · form ${m.root.quad ? `Q${m.formNo}` : ROMAN[Number(m.formNo) - 1] ?? m.formNo} · ${m.root.totalCount}×`)),
            h('span', { lang: 'ar', dir: 'rtl' }, [...m.root.root].join(' · '))))
      : [h('p', { class: 'vf-sug-none' },
          'no roots match; try nzl, نصر, or a meaning like guide')];
    // role="listbox" may only hold option children; when the sole child is the
    // non-option "no roots" note, drop the role so the ARIA tree stays valid.
    if (matches.length) sugEl.setAttribute('role', 'listbox');
    else sugEl.removeAttribute('role');
    sugEl.replaceChildren(...rows);
    setSugHidden(false);
  }
  searchEl?.addEventListener('input', () => runSearch(searchEl.value.trim()));

  document.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('[data-root]') as HTMLElement | null;
    if (btn) { selectRoot(btn.dataset.root!); return; }
    const qchip = (ev.target as HTMLElement).closest('[data-q]') as HTMLElement | null;
    if (qchip) { searchEl.value = qchip.dataset.q!; searchEl.focus(); runSearch(qchip.dataset.q!); return; }
    if (!(ev.target as HTMLElement).closest('.vf-search-wrap')) setSugHidden(true);
  });
  searchEl?.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') (sugEl.querySelector('[data-root]') as HTMLElement | null)?.click();
    if (ev.key === 'Escape') setSugHidden(true);
    if (ev.key === 'ArrowDown') {
      (sugEl.querySelector('[data-root]') as HTMLElement | null)?.focus();
      ev.preventDefault();
    }
  });
  sugEl?.addEventListener('keydown', (ev) => {
    const items = [...sugEl.querySelectorAll('[data-root]')] as HTMLElement[];
    const i = items.indexOf(document.activeElement as HTMLElement);
    if (ev.key === 'ArrowDown' && i < items.length - 1) { items[i + 1].focus(); ev.preventDefault(); }
    if (ev.key === 'ArrowUp') { (i > 0 ? items[i - 1] : searchEl).focus(); ev.preventDefault(); }
    if (ev.key === 'Escape') { setSugHidden(true); searchEl.focus(); }
  });
  const hash = new URLSearchParams(location.hash.slice(1));
  const initialRoot = hash.get('root');
  if (initialRoot) selectRoot(initialRoot);
</script>

<style is:global>
  .vf-container { padding-block: var(--spacing-2xl) var(--spacing-3xl); }
  .vf-header { text-align: center; margin-block-end: var(--spacing-2xl); }
  .vf-title { font-size: 2.25rem; font-weight: 700; color: var(--color-text-primary);
    letter-spacing: -0.02em; margin-block-end: var(--spacing-md); text-wrap: balance; }
  .vf-intro { font-size: 1.125rem; line-height: 1.6; color: var(--color-text-secondary);
    max-inline-size: 620px; margin-inline: auto; }

  .vf-search-wrap { position: relative; max-inline-size: 480px; margin-inline: auto; }
  .vf-search { inline-size: 100%; padding: var(--spacing-sm) var(--spacing-md);
    font-size: 1.125rem; font-family: inherit;
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary); border-radius: var(--radius-md);
    color: var(--color-text-primary);
    transition: border-color 160ms var(--vf-ease); }
  .vf-search:focus { outline: 2px solid var(--color-border-focus); outline-offset: 1px; }
  .vf-suggestions { position: absolute; inset-inline: 0; top: calc(100% + 4px);
    background: var(--color-background-elevated);
    border: 1px solid var(--color-border-primary); border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14); z-index: 20; overflow: hidden; }
  .vf-sug { display: flex; align-items: center; justify-content: space-between;
    gap: var(--spacing-sm); inline-size: 100%; padding: var(--spacing-sm) var(--spacing-md);
    background: none; border: 0; cursor: pointer; font-family: inherit;
    color: var(--color-text-primary); font-size: 1rem; text-align: start;
    transition: background-color 120ms var(--vf-ease); }
  .vf-sug:active { background: var(--color-background-tertiary); }
  .vf-sug:focus-visible { outline: 2px solid var(--color-border-focus); outline-offset: -2px; }
  .vf-sug [lang="ar"] { font-family: var(--font-arabic); font-size: 1.5rem;
    line-height: 1.8; flex-shrink: 0; }
  .vf-sug-en { min-inline-size: 0; }
  .vf-sug-meaning { display: block; margin: 0; color: var(--color-text-primary);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vf-sug-sub { display: block; margin: 0; font-size: 0.8rem;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums; font-style: italic; }
  .vf-sug-meaning mark { background: color-mix(in oklab, var(--accent-gold) 30%, transparent);
    color: inherit; border-radius: 2px; padding: 0 0.08em; }
  .vf-count, .vf-chip-count { font-variant-numeric: tabular-nums; }
  .vf-sug-none { padding: var(--spacing-sm) var(--spacing-md);
    color: var(--color-text-tertiary); margin: 0; font-size: 0.95rem; }

  .vf-chips { display: flex; flex-wrap: wrap; gap: var(--spacing-xs);
    justify-content: center; margin-block: var(--spacing-lg) var(--spacing-2xl); }
  .vf-chip { display: inline-flex; align-items: baseline; gap: 0.4em;
    padding: 0.35em 0.8em; background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary); border-radius: var(--radius-full);
    cursor: pointer; color: var(--color-text-primary); font-family: var(--font-arabic);
    font-size: 1.25rem;
    transition: border-color 160ms var(--vf-ease), transform 160ms var(--vf-ease); }
  .vf-chip:active { transform: scale(0.97); }
  .vf-chip, .vf-root-link, .vf-sug, .vf-letter summary, .vf-qchip { touch-action: manipulation; }
  .vf-chip:focus-visible, .vf-root-link:focus-visible {
    outline: 2px solid var(--color-border-focus); outline-offset: 1px; }
  .vf-chip-count { font-family: var(--font-sans); font-size: 0.75rem;
    color: var(--color-text-tertiary); }

  .vf-qchips { display: flex; flex-wrap: wrap; gap: var(--spacing-xs);
    justify-content: center; margin-block: var(--spacing-md) 0; }
  .vf-qchips-label { align-self: center; font-size: 0.8rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--color-text-tertiary); }
  .vf-qchip { display: inline-flex; align-items: baseline; gap: 0.5em;
    padding: 0.35em 0.8em; background: var(--color-background-secondary);
    border: 1px solid var(--color-border-primary); border-radius: var(--radius-full);
    cursor: pointer; color: var(--color-text-primary);
    font-family: var(--font-arabic); font-size: 1.25rem;
    transition: border-color 160ms var(--vf-ease), transform 160ms var(--vf-ease); }
  .vf-qchip-latin { font-family: var(--font-sans); font-size: 1rem; }
  .vf-qchip:active { transform: scale(0.97); }
  .vf-qchip:focus-visible { outline: 2px solid var(--color-border-focus); outline-offset: 1px; }
  .vf-qchip-note { font-family: var(--font-sans); font-size: 0.75rem;
    color: var(--color-text-tertiary); }

  .vf-result { margin-block-end: var(--spacing-3xl); scroll-margin-top: 90px; }
  .vf-load-error { text-align: center; color: var(--color-text-secondary);
    border: 1px solid var(--color-border-primary); border-radius: var(--radius-md);
    padding: var(--spacing-lg); }
  .vf-root-header { text-align: center; margin-block: var(--spacing-xl); }
  .vf-root-letters { font-family: var(--font-arabic); font-size: 2.75rem; line-height: 1.4;
    color: var(--color-text-primary); margin: 0 0 var(--spacing-xs); }
  .vf-root-stats { color: var(--color-text-secondary); margin: 0; }

  .vf-grid { list-style: none; margin: 0; padding: 0;
    border: 1px solid var(--color-border-primary); border-radius: var(--radius-lg);
    overflow: hidden; }
  .vf-row { padding: var(--spacing-md) var(--spacing-lg);
    display: grid; grid-template-columns: 3.2em minmax(0, 1fr);
    column-gap: var(--spacing-md); align-items: start; }
  .vf-row + .vf-row { border-block-start: 1px solid var(--color-border-secondary); }
  .vf-row-attested { background: var(--color-background-secondary); }
  .vf-row-empty { opacity: 0.55; grid-template-columns: 3.2em minmax(0, 1fr) auto;
    align-items: center; }
  .vf-badge { display: inline-grid; place-items: center; min-inline-size: 2.4em;
    padding: 0.15em 0.5em; border-radius: var(--radius-sm); font-size: 0.85rem;
    font-weight: 700; letter-spacing: 0.06em;
    background: var(--color-background-tertiary); color: var(--color-text-secondary); }
  /* optical nudge — aligns badge with first text line in start-aligned rows */
  .vf-row:not(.vf-row-empty) .vf-badge { margin-block-start: 0.3em; }
  .vf-badge-gold { background: color-mix(in oklab, var(--accent-gold) 16%, transparent);
    color: var(--accent-gold); }
  .vf-shift { font-size: 0.85rem; color: var(--color-text-tertiary);
    font-style: italic; margin: 0.3em 0 0; }
  .vf-row-body { grid-column: 2; }
  .vf-empty-note { margin: 0; font-size: 0.9rem; color: var(--color-text-tertiary); }
  .vf-pattern { font-family: var(--font-arabic); font-size: 1.25rem;
    line-height: 1.8; color: var(--color-text-tertiary); }
  .vf-entry { display: grid; grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--spacing-lg); align-items: center;
