---
/**
 * Retired: the Verb Form Generator is now /resources/find/. This page only forwards visitors, so old links and
 * bookmarks keep working. "#root=نزل" arrives at the finder as "#root=نزل" and opens that root.
 */
const target = new URL('/resources/find/', Astro.site);
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verb Form Generator has moved | Quranic Grammar</title>
  <link rel="canonical" href={target.href} />
  <noscript><meta http-equiv="refresh" content="0;url=/resources/find/" /></noscript>
  <script is:inline>
    (function () { location.replace('/resources/find/' + location.hash); })();
  </script>
</head>
<body>
  <p>The Verb Form Generator has moved. <a href="/resources/find/">Go to Find a Word or Verb</a>.</p>
</body>
</html>
