---
/**
 * /resources/: the hub. Light only, standalone (no BaseLayout), like home, learn and the guides.
 * Two tools lead; the guides follow in groups by what you are trying to do. The cards live in
 * src/data/resource-hub.ts, and the page fails the build if a guide in the collection has no card or a card
 * has no guide. Counts are never typed in here.
 */
import { getCollection } from 'astro:content';
import CookieBanner from '../../components/CookieBanner.astro';
import '../../styles/fonts.css';
import '../../styles/guide.css';
import '../../styles/hub.css';
import { HUB_GROUPS } from '../../data/resource-hub';

const resources = await getCollection('resources');
const guideCards = HUB_GROUPS.flatMap((g) => g.cards).filter((c) => c.kind === 'guide');
for (const r of resources) if (!guideCards.some((c) => c.id === r.id)) throw new Error(`resources hub: guide "${r.id}" has no card in src/data/resource-hub.ts`);
for (const c of guideCards) if (!resources.some((r) => r.id === c.id)) throw new Error(`resources hub: card "${c.id}" is not a guide in src/content/resources`);
const toolCount = HUB_GROUPS.flatMap((g) => g.cards).filter((c) => c.kind === 'tool').length;
const guideCount = resources.length;

const title = 'Resources | Quranic Grammar';
const description = 'Free tools and guides for Quranic Arabic: look up a word, generate verb forms, and keep the case endings, pronouns, verb tables and the 200 most common words open next to any lesson.';
const canonicalURL = new URL('/resources/', Astro.site);
const ogImageURL = new URL('/images/og-default.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-1MSBYYQT5Z" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1MSBYYQT5Z');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#fbfcfd" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL.href} />
  <meta property="og:site_name" content="Quranic Grammar" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Quranic Grammar RSS" href="/rss.xml" />
  <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="sW/uZfxMauSpqoKnSL6i6g" async is:inline></script>
</head>
<body class="guide hub" style="--hue:178">
<a href="#main-content" class="skip">Skip to main content</a>
<header class="site">
  <a class="brand" href="/" aria-label="Quranic Grammar, home">
    <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="9" fill="oklch(18% 0.03 240)"/><path d="M9 19h14" stroke="#fff" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="12" r="2.6" fill="oklch(79% 0.14 72)"/><circle cx="16" cy="24.5" r="1.6" fill="#fff"/></svg>
    <span>Quranic Grammar</span>
  </a>
  <nav aria-label="Primary"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/" aria-current="page">Resources</a><a href="/about/">About</a></nav>
  <details class="menu">
    <summary aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
    <div class="menu-panel"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/">Resources</a><a href="/about/">About and feedback</a></div>
  </details>
</header>

<main id="main-content">
  <section class="g-hero hub-hero" aria-labelledby="hub-h">
    <div class="g-hero-grid">
      <div>
        <p class="eyebrow">Free, no sign-up</p>
        <h1 class="g-h1" id="hub-h">Look it up while you read</h1>
        <p class="g-dek">Two tools and {guideCount} guides for Quranic Arabic. Keep them open next to any lesson, or next to the Quran itself.</p>
        <div class="find" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <label class="vh" for="hub-q">Find a resource</label>
          <input id="hub-q" type="search" placeholder="Find a resource, e.g. cases" autocomplete="off" />
        </div>
      </div>
      <ul class="g-stats" aria-label="What is here" style="margin:0">
        <li><b data-hub-tools>{toolCount}</b>live tools</li>
        <li><b data-hub-guides>{guideCount}</b>guides</li>
        <li><b>Free</b>always open</li>
      </ul>
    </div>
  </section>

  <div class="groups" id="groups">
    {HUB_GROUPS.map((g) => (
      <section class:list={['grp', { tools: g.id === 'tools' }]} aria-labelledby={`g-${g.id}`} style={`--h:${g.hue}`}>
        <div class="g-head"><h2 id={`g-${g.id}`}>{g.title}</h2><p>{g.line}</p></div>
        <div class="cards">
          {g.cards.map((c) => (
            <a class="card" href={c.href} data-k={c.keys} data-testid={`resource-${c.id}`}>
              <div class="kind"><span class:list={['tag', { live: c.kind === 'tool' }]}>{c.kind === 'tool' ? 'Live tool' : 'Guide'}</span></div>
              <h3>{c.title}</h3>
              <div class="peek" aria-hidden="true" set:html={c.peek} />
              <p>{c.blurb}</p>
              <span class="go">{c.kind === 'tool' ? 'Open the tool' : 'Read the guide'} <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
            </a>
          ))}
        </div>
      </section>
    ))}
    <div class="empty" id="hub-none" hidden><b>No resource matches that.</b><p>Try a shorter word, or <a href="/search/">search the whole site</a>.</p></div>
  </div>
</main>

<footer class="foot">
  <div class="in">
    <nav aria-label="Footer"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/">Resources</a><a href="/about/">About and feedback</a><a href="/rss.xml">RSS</a></nav>
    <p>Word data and counts from the <a href="https://corpus.quran.com/">Quranic Arabic Corpus</a> (Kais Dukes, GPL). Quran text after <a href="https://tanzil.net/">Tanzil</a>.</p>
  </div>
</footer>
<CookieBanner tone="light" />
<script>
  import '../../scripts/hub';
</script>
</body>
</html>
