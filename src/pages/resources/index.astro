<script>
// @ts-nocheck
import { initCapacitor } from '../../scripts/capacitor-init';
initCapacitor();

(function(){
'use strict';
document.documentElement.classList.add('js');
var RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
var hidden=false;
document.addEventListener('visibilitychange',function(){hidden=document.hidden;});
var veil=document.getElementById('veil');
addEventListener('load',function(){setTimeout(function(){veil.classList.add('gone');},RM?0:320);});
setTimeout(function(){veil.classList.add('gone');},2600);
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target);}});},{threshold:.1});
document.querySelectorAll('[data-reveal]').forEach(function(el,i){el.style.transitionDelay=(i%5*90)+'ms';io.observe(el);});
addEventListener('scroll',function(){document.getElementById('nav').classList.toggle('scrolled',scrollY>40);},{passive:true});

/* ---------- boot sequence ---------- */
var mods=[].slice.call(document.querySelectorAll('.mod'));
var booted=0,bootStarted=false;
mods.sort(function(a,b){return +a.dataset.boot-+b.dataset.boot;});
function bootAll(){
  if(bootStarted)return; /* load can fire after the 2400ms fallback (render-blocking fonts gate it) — boot once */
  bootStarted=true;
  mods.forEach(function(m,i){
    var delay=RM?0:500+i*260;
    setTimeout(function(){
      m.classList.add('booting');
      setTimeout(function(){m.classList.remove('booting');m.classList.add('on');booted++;},RM?0:520);
    },delay);
  });
}
addEventListener('load',bootAll);
setTimeout(bootAll,2400);

/* ---------- master heartbeat: 1.2s ---------- */
var BEAT=1200,beatN=0;
var beatlamp=document.getElementById('beatlamp');
var subs=[];   /* {every, phase, fn} */
function onBeat(every,phase,fn){subs.push({every:every,phase:phase,fn:fn});}
setInterval(function(){
  if(hidden||RM)return;
  beatN++;
  beatlamp.classList.add('on');
  mods.forEach(function(m){if(m.classList.contains('on'))m.classList.add('beat');});
  setTimeout(function(){
    beatlamp.classList.remove('on');
    mods.forEach(function(m){m.classList.remove('beat');});
  },200);
  subs.forEach(function(s){if((beatN+s.phase)%s.every===0)s.fn();});
},BEAT);

/* swap helper */
function swap(el,apply){
  var host=el.closest('.demo')||el.parentElement;
  host.classList.add('swapping');
  setTimeout(function(){apply();host.classList.remove('swapping');},330);
}
function statik(el,txt){el.textContent=txt;}

/* ---------- demos on the beat ---------- */
var ROMANS=['I','II','III','IV','V','VI','VII','VIII','IX','X'];
var PATS=['فَعَلَ','فَعَّلَ','فَاعَلَ','أَفْعَلَ','تَفَعَّلَ','تَفَاعَلَ','اِنْفَعَلَ','اِفْتَعَلَ','اِفْعَلَّ','اِسْتَفْعَلَ'];
var MEANS=['BASE MEANING·THE BARE ROOT','INTENSIVE · CAUSATIVE·DOUBLED MIDDLE','RECIPROCAL·LONG FIRST VOWEL','CAUSATIVE·HAMZA PREFIX','REFLEXIVE OF II·TA- PREFIX','MUTUAL ACTION·TA- + LONG VOWEL','PASSIVE-LIKE·IN- PREFIX','REFLEXIVE·-TA- INFIX','COLORS &amp; DEFECTS·DOUBLED LAM','SEEKING·ISTA- PREFIX'];
var fr=document.getElementById('fr'),fp=document.getElementById('fp'),fm=document.getElementById('fm');
var fi=0;
onBeat(2,0,function(){
  fi=(fi+1)%10;
  swap(fr,function(){
    fr.textContent=ROMANS[fi];fp.textContent=PATS[fi];
    fm.textContent='';
    MEANS[fi].replace(/&amp;/g,'&').split('·').forEach(function(l,k){if(k)fm.appendChild(document.createElement('br'));fm.appendChild(document.createTextNode(l.trim()));});
  });
});
if(RM){statik(fr,'II');statik(fp,PATS[1]);}

/* lookup typing (own rhythm) */
var lq=document.getElementById('lq'),lchips=document.getElementById('lchips');
(function loop(){
  if(RM){lq.textContent='قَالَ';lchips.classList.add('on');return;}
  var Wd='قَالَ',i=0;lq.textContent='';lchips.classList.remove('on');
  var t=setInterval(function(){
    if(hidden)return;
    i++;lq.textContent=Wd.slice(0,i);
    if(i>=Wd.length){clearInterval(t);setTimeout(function(){lchips.classList.add('on');},300);setTimeout(loop,5600);}
  },230);
})();

/* ticker */
var TICK=[['مِن','FROM'],['فِي','IN'],['عَلَى','UPON'],['مَا','WHAT · NOT'],['لَا','NO · NOT'],['إِنَّ','INDEED'],['كُلّ','EVERY'],['يَوْم','DAY']];
var list=document.getElementById('tickerlist');
TICK.concat(TICK).forEach(function(w){
  var li=document.createElement('li');
  var b=document.createElement('b');b.setAttribute('lang','ar');b.setAttribute('dir','rtl');b.textContent=w[0];
  var s=document.createElement('span');s.textContent=w[1];
  li.appendChild(b);li.appendChild(s);list.appendChild(li);
});

/* case cycler */
var CASES=[['كِتَابٌ','RAFʿ — SUBJECT'],['كِتَابًا','NASB — OBJECT'],['كِتَابٍ','JARR — AFTER PREPOSITIONS']];
var cw=document.getElementById('cw'),cl=document.getElementById('cl'),ci=0;
onBeat(2,1,function(){ci=(ci+1)%3;swap(cw,function(){cw.textContent=CASES[ci][0];cl.textContent=CASES[ci][1];});});

/* glossary */
var TERMS=[['إعراب','IʿRĀB — CASE ANALYSIS'],['مُبْتَدَأ','MUBTADAʾ — SUBJECT'],['خَبَر','KHABAR — PREDICATE'],['فَاعِل','FĀʿIL — DOER']];
var gt=document.getElementById('gt'),gd=document.getElementById('gd'),gi=0;
onBeat(3,0,function(){gi=(gi+1)%TERMS.length;swap(gt,function(){gt.textContent=TERMS[gi][0];gd.textContent=TERMS[gi][1];});});

/* root births */
var BORN=[['كِتَاب','KITĀB — BOOK'],['كَاتِب','KĀTIB — WRITER'],['مَكْتُوب','MAKTŪB — WRITTEN'],['يَكْتُبُ','YAKTUBU — HE WRITES']];
var rb=document.getElementById('rb'),rl=document.getElementById('rl'),ri=0;
onBeat(3,1,function(){ri=(ri+1)%BORN.length;swap(rb,function(){rb.textContent=BORN[ri][0];rl.textContent=BORN[ri][1];});});

/* conj scan — every beat */
var conjCells=[].slice.call(document.querySelectorAll('#conj i')),cj=0;
onBeat(1,0,function(){cj=(cj+1)%conjCells.length;conjCells.forEach(function(c,k){c.classList.toggle('hot',k===cj);});});
conjCells[0].classList.add('hot');

/* roadmap — every beat */
var steps=[].slice.call(document.querySelectorAll('#road2 .st')),rs=0;
onBeat(1,0,function(){rs=(rs+1)%(steps.length+2);steps.forEach(function(s,j){s.classList.toggle('hot',j<=rs&&rs<steps.length);});});
steps[0].classList.add('hot');

/* seven */
var AR7=['١','٢','٣','٤','٥','٦','٧'];
var sn=document.getElementById('sn'),si=0;
onBeat(2,0,function(){si=(si+1)%7;swap(sn,function(){sn.textContent=AR7[si];});});

/* vfm */
var vr=document.getElementById('vr'),vm=document.getElementById('vm'),vi=1;
onBeat(2,1,function(){vi=(vi+1)%10;swap(vr,function(){vr.textContent=ROMANS[vi];vm.textContent=MEANS[vi].replace(/&amp;/g,'&').split('·')[1].trim();});});

/* msa */
var msa=document.getElementById('msa'),mnote=document.getElementById('mnote');
var MN=['SAME ROOTS · DIFFERENT REGISTER','QURANIC KEEPS FULL IʿRĀB'];
var mi=0;
onBeat(3,2,function(){mi++;msa.classList.toggle('flip');swap(mnote,function(){mnote.textContent=MN[mi%2];});});
})();
</script>

