---
/**
 * Retired: Word Lookup is now /resources/find/. This page only forwards visitors, so old links, bookmarks and
 * the "?q=" links on vocabulary lists keep working. "#q=word" and "?q=word" both arrive as "#q=word".
 */
const target = new URL('/resources/find/', Astro.site);
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Word Lookup has moved | Quranic Grammar</title>
  <link rel="canonical" href={target.href} />
  <noscript><meta http-equiv="refresh" content="0;url=/resources/find/" /></noscript>
  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q');
      location.replace('/resources/find/' + (q ? '#q=' + encodeURIComponent(q) : location.hash));
    })();
  </script>
</head>
<body>
  <p>Word Lookup has moved. <a href="/resources/find/">Go to Find a Word or Verb</a>.</p>
</body>
</html>
