  <meta name="twitter:image" content={ogImageURL.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Quranic Grammar RSS" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:ital,wght@0,400;0,700;1,400&family=Marcellus&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <!-- Keep the stored theme in sync for the rest of the site (this page is always night) -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="sW/uZfxMauSpqoKnSL6i6g" async is:inline></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(courseSchema).replace(/<\//g, '<\\/')} />
  <style is:global>
/* ============================================================
   THE SKY TOUR · learn section page
   body, canvas, driver, cards, intro, finale, rail + catalog
   :root / reset / a / nav / btn / footer are from night.css
   ============================================================ */

body{background:var(--bg-0);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden}

#driver{position:relative}
#view{position:sticky;top:0;height:100svh;overflow:hidden;background:radial-gradient(1200px 760px at 60% -12%,#0d1430 0%,transparent 60%),linear-gradient(180deg,#05070e,#070b16)}
#skycv{position:absolute;inset:0;display:block}
#dawn{position:absolute;inset:0;opacity:0;pointer-events:none;background:radial-gradient(1300px 800px at 50% 116%,rgba(244,180,92,.42) 0%,rgba(200,110,50,.16) 40%,transparent 70%)}

/* cards */
.card{position:absolute;left:var(--pad-x);bottom:clamp(24px,6vh,64px);z-index:6;max-width:min(480px,86vw);opacity:0;transform:translateY(18px);pointer-events:none;transition:none}
.card .rn{font-family:var(--font-mono);font-size:10px;letter-spacing:.4em;color:var(--gold);text-transform:uppercase}
.card h2{font-family:var(--font-display);font-weight:400;font-size:clamp(30px,3.8vw,52px);line-height:1.1;margin-top:8px;display:flex;gap:16px;align-items:baseline;flex-wrap:wrap}
.card h2 [lang="ar"]{font-size:.62em;color:var(--gold)}
.card p{color:var(--ink-dim);font-weight:300;font-size:clamp(14px,1.3vw,16.5px);line-height:1.75;margin-top:10px;text-shadow:0 2px 24px rgba(5,7,14,.9)}
.card .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.card .chips span{font-family:var(--font-mono);font-size:9px;letter-spacing:.18em;color:var(--ink-dim);text-transform:uppercase;border:1px solid var(--hairline);border-radius:999px;padding:5px 12px}
.card .ct{font-family:var(--font-mono);font-size:10px;letter-spacing:.26em;color:var(--gold-bright);text-transform:uppercase;margin-top:14px}

/* intro + finale */
#intro{position:absolute;inset:0;display:grid;place-items:center;text-align:center;z-index:6;pointer-events:none}
#intro h1{font-family:var(--font-display);font-weight:400;font-size:clamp(42px,6vw,84px);line-height:1.08;max-width:15ch}
#intro h1 em{font-style:normal;color:var(--gold-bright)}
#intro .dek{color:var(--ink-dim);font-weight:300;font-size:clamp(15px,1.4vw,18px);max-width:50ch;margin:18px auto 0;line-height:1.8}
#intro .cue{margin-top:32px;display:flex;flex-direction:column;align-items:center;gap:10px;font-family:var(--font-mono);font-size:10px;letter-spacing:.4em;color:var(--ink-faint);text-transform:uppercase}
#intro .cue .line{width:1px;height:44px;background:linear-gradient(180deg,transparent,var(--gold));position:relative;overflow:hidden}
#intro .cue .line::after{content:'';position:absolute;left:0;top:-40%;width:100%;height:40%;background:var(--gold-bright);animation:cuedrop 2.2s var(--ease-io) infinite}
@keyframes cuedrop{0%{top:-40%}70%,100%{top:110%}}
@media (prefers-reduced-motion:reduce){#intro .cue .line::after{animation:none}}
#finale{position:absolute;inset:0;display:grid;place-items:center;text-align:center;z-index:6;opacity:0;pointer-events:none}
#finale h2{font-family:var(--font-display);font-weight:400;font-size:clamp(34px,4.8vw,64px);line-height:1.14;max-width:20ch}
#finale h2 em{font-style:normal;color:var(--gold-bright)}
#finale .ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-top:38px}
#finale.live{pointer-events:auto}

/* progress rail */
#rail{position:absolute;right:clamp(14px,2.4vw,34px);top:50%;transform:translateY(-50%);z-index:7;display:flex;flex-direction:column;gap:16px}
#rail span{width:8px;height:8px;border-radius:50%;border:1px solid rgba(228,209,164,.4);transition:background .5s,border-color .5s,box-shadow .5s;position:relative}
#rail span.hot{background:var(--gold-bright);border-color:var(--gold-bright);box-shadow:0 0 12px var(--gold-glow)}
#rail span i{position:absolute;right:18px;top:50%;transform:translateY(-50%);font-style:normal;font-family:var(--font-mono);font-size:8.5px;letter-spacing:.26em;color:var(--ink-faint);text-transform:uppercase;white-space:nowrap;opacity:0;transition:opacity .4s}
#rail span.hot i{opacity:1;color:var(--gold-bright)}
@media (max-width:900px){#rail{display:none}}

/* flat fallback (reduced motion / small screens) — paired with html:not(.js) mirrors */
.flat #driver, html:not(.js) #driver{height:auto!important}
.flat #view, html:not(.js) #view{position:static;height:56svh}
.flat .card,.flat #intro,.flat #finale,
html:not(.js) .card, html:not(.js) #intro, html:not(.js) #finale{position:static;opacity:1!important;transform:none!important;pointer-events:auto;max-width:720px;margin:40px auto;padding:0 var(--pad-x)}
.flat #intro, html:not(.js) #intro{display:block;text-align:left;padding-top:30px}
.flat #rail, html:not(.js) #rail{display:none}

/* Token shim so LessonRow / ReadingTrack / ResumeBand render on midnight
   without importing the themed global.css. Values map site tokens → night tokens. */
:root{
  --text-primary:var(--ink);--text-secondary:var(--ink-dim);--text-tertiary:var(--ink-faint);
  --text-inverse:#221503;
  --bg-secondary:rgba(228,209,164,.05);--border-primary:var(--hairline);
  --accent-gold:var(--gold);--accent-gold-light:rgba(227,179,92,.1);--accent-primary:var(--gold-bright);
  --radius-md:10px;--radius-lg:14px;--radius-full:999px;
  --space-md:16px;--space-lg:24px;--space-xl:36px;
  --font-display:'Marcellus',serif;--font-arabic:'Amiri',serif;
  --level-1-bg:rgba(227,179,92,.14);--level-1-text:var(--gold-bright);
  --level-2-bg:rgba(227,179,92,.14);--level-2-text:var(--gold-bright);
  --level-3-bg:rgba(227,179,92,.14);--level-3-text:var(--gold-bright);
  --level-4-bg:rgba(227,179,92,.14);--level-4-text:var(--gold-bright);
  --level-5-bg:rgba(227,179,92,.14);--level-5-text:var(--gold-bright);
}

/* Catalog section */
.catalog{position:relative;z-index:8;background:linear-gradient(180deg,#05070e,#070a13);border-top:1px solid var(--hairline-soft)}
.catalog-inner{max-width:880px;margin:0 auto;padding:clamp(60px,9vh,110px) var(--pad-x) 30px}
.catalog-title{font-family:var(--font-display);font-weight:400;font-size:clamp(28px,3.4vw,44px);line-height:1.15}
.catalog-sub{color:var(--ink-dim);font-weight:300;margin-top:8px}
.catalog .level-section{margin-top:clamp(44px,7vh,72px);scroll-margin-top:90px}
.catalog .level-header{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;border-bottom:1px solid var(--hairline);padding-bottom:10px}
.catalog .level-title{font-family:var(--font-display);font-weight:400;font-size:clamp(21px,2.4vw,28px);display:flex;align-items:baseline;gap:14px}
.catalog .level-number{font-family:var(--font-mono);font-size:11px;letter-spacing:.3em;color:var(--gold);text-transform:uppercase}
.catalog .level-arabic{font-family:var(--font-ar);font-size:20px;color:var(--gold)}
.catalog .level-desc{color:var(--ink-dim);font-weight:300;max-width:60ch;margin-top:10px}
.catalog .level-links{display:flex;gap:12px;font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin-top:6px}
.catalog .level-links a{color:var(--gold-bright)}
.catalog .level-links a:hover{text-decoration:underline}
.catalog .cluster{margin-top:26px}
.catalog .cluster-title{font-family:var(--font-mono);font-size:10px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-dim);font-weight:400;margin-bottom:6px}
.catalog .cluster-note{font-size:13px;color:var(--ink-faint);margin-bottom:6px}
.catalog .cluster-rows{display:flex;flex-direction:column}
.catalog-jump{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.catalog-jump a{display:inline-flex;align-items:baseline;gap:8px;border:1px solid var(--hairline);border-radius:999px;padding:8px 16px;font-family:var(--font-mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-dim);transition:border-color .35s,color .35s}
.catalog-jump a:hover{border-color:rgba(227,179,92,.5);color:var(--ink)}
.catalog-jump b{font-weight:500;color:var(--gold-bright)}
.catalog-jump [data-jump-count]{color:var(--ink-faint)}

/* ============================================================
   Clickable-star tooltip (desktop) — floats the lesson title
   under the cursor when hovering a star in the constellation.
   ============================================================ */
#startip{position:fixed;z-index:20;pointer-events:none;opacity:0;transform:translateY(4px);transition:opacity .18s var(--ease-out),transform .18s var(--ease-out);padding:8px 13px;border:1px solid var(--hairline);border-radius:11px;background:rgba(8,11,20,.9);backdrop-filter:blur(10px);box-shadow:0 12px 40px rgba(3,5,12,.6);max-width:250px}
#startip.on{opacity:1;transform:none}
#startip .tl{font-family:var(--font-mono);font-size:8.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold-bright)}
#startip .tt{font-family:var(--font-display);font-size:14.5px;color:var(--ink);margin-top:3px;line-height:1.25}

/* ============================================================
   MOBILE — the constellation flythrough can't read at 375px, so
   below 760px the sky becomes a calm fixed backdrop and the five
   levels are presented as tappable cards, each with its own
   little constellation. Desktop is untouched.
   ============================================================ */
.m-levels{display:none}
@media (max-width:760px){
  #driver{height:auto!important}
  /* Beat the .flat / html:not(.js) rules (same specificity, later source order)
     so #view becomes a fixed starfield backdrop instead of a 56svh in-flow block. */
  .flat #view, html:not(.js) #view{position:fixed;inset:0;height:100svh;z-index:0}
  #skycv{position:absolute;inset:0}
  #intro,#finale,#rail,#dawn,.card{display:none!important}
  .m-levels{display:block}
  .catalog{position:relative;z-index:2}
}
.m-levels{position:relative;z-index:2;padding:calc(72px + env(safe-area-inset-top) + 5vh) var(--pad-x) 8vh}
.m-intro h1{font-family:var(--font-display);font-weight:400;font-size:clamp(34px,10.5vw,48px);line-height:1.05}
.m-intro h1 em{font-style:normal;color:var(--gold-bright)}
.m-intro p{color:var(--ink-dim);font-weight:300;font-size:15px;line-height:1.7;margin-top:15px;max-width:33ch;text-shadow:0 2px 24px rgba(5,7,14,.9)}
.m-cards{list-style:none;display:flex;flex-direction:column;gap:12px;margin-top:32px}
.m-card{position:relative;display:grid;grid-template-columns:54px 1fr auto;align-items:center;gap:15px;padding:16px 17px 19px;border:1px solid var(--hairline);border-radius:16px;background:linear-gradient(158deg,rgba(228,209,164,.06),rgba(228,209,164,.012));overflow:hidden;touch-action:manipulation;-webkit-tap-highlight-color:transparent;opacity:0;transform:translateY(15px);animation:m-rise .7s var(--ease-out) forwards;animation-delay:calc(var(--i)*80ms + 180ms)}
.m-card:active{transform:scale(.985)}
@keyframes m-rise{to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.m-card{animation:none;opacity:1;transform:none}}
.m-glyph{width:54px;height:54px;overflow:visible}
.m-glyph .l{stroke:rgba(227,179,92,.38);stroke-width:1;fill:none;stroke-linejoin:round;stroke-linecap:round}
.m-glyph .s{fill:#cdd6ef}
.m-glyph .cp{fill:var(--gold-bright);filter:drop-shadow(0 0 4px var(--gold-glow))}
.m-body{min-width:0}
.m-rn{font-family:var(--font-mono);font-size:9.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--gold)}
.m-title{font-family:var(--font-display);font-weight:400;font-size:21px;line-height:1.15;margin-top:3px;display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.m-title .ar{font-size:.78em;color:var(--gold)}
.m-meta{font-family:var(--font-mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-faint);margin-top:8px}
.m-meta [data-mct].done{color:var(--gold-bright)}
.m-go{font-family:var(--font-display);font-size:21px;color:var(--ink-faint);transition:color .3s var(--ease-out),transform .3s var(--ease-out)}
.m-card:active .m-go{color:var(--gold-bright);transform:translateX(3px)}
.m-bar{position:absolute;left:0;right:0;bottom:0;height:2px;background:rgba(228,209,164,.08)}
.m-bar i{display:block;height:100%;width:100%;transform:scaleX(var(--p,0));transform-origin:left;background:linear-gradient(90deg,var(--gold),var(--gold-bright));box-shadow:0 0 10px var(--gold-glow);transition:transform .9s var(--ease-out)}
.m-cta{margin-top:28px}
.m-cta .btn{width:100%;justify-content:center}
  </style>
</head>
<body>

<a href="#main-content" class="skip-link">Skip to main content</a>

<div id="veil" aria-hidden="true">
  <svg viewBox="0 0 40 40" fill="none"><path d="M20 2l3.4 10.2L34 8.8l-6.8 8.6L38 20l-10.8 2.6L34 31.2l-10.6-3.4L20 38l-3.4-10.2L6 31.2l6.8-8.6L2 20l10.8-2.6L6 8.8l10.6 3.4z" fill="#e3b35c"/></svg>
</div>

<header class="nav">
  <a class="brand" href="/" aria-label="Quranic Grammar, home">
    <svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 2l3.4 10.2L34 8.8l-6.8 8.6L38 20l-10.8 2.6L34 31.2l-10.6-3.4L20 38l-3.4-10.2L6 31.2l6.8-8.6L2 20l10.8-2.6L6 8.8l10.6 3.4z" fill="#e3b35c"/></svg>
    Quranic Grammar
  </a>
  <nav class="nav-links" aria-label="Primary">
    <a class="active" href="/learn/" aria-current="page">LEARN</a><a href="/surahs/">SURAHS</a><a href="/resources/">RESOURCES</a><a href="/about/">ABOUT</a>
  </nav>
</header>

<main id="main-content">

<div id="driver">
  <div id="view">
    <canvas id="skycv" aria-hidden="true"></canvas>
    <div id="dawn" aria-hidden="true"></div>

    <div id="intro">
      <div>
        <h1>Five levels, <em>one mission</em>.</h1>
        <p class="dek">Understand every word of the Quran you recite. Eighty-one lessons run from the alphabet to full verse analysis<span data-dek-progress></span>.</p>
        <div class="cue" aria-hidden="true"><span>Scroll to begin</span><span class="line"></span></div>
      </div>
    </div>

    <div class="card" data-stop="1">
      <span class="rn">Level 1 · {totals[1]} lessons</span>
      <h2>Foundation <span lang="ar" dir="rtl">الأساسيات</span></h2>
      <p>Read Arabic script with confidence: the alphabet, every vowel mark, and the three kinds of word. It ends with you reading Surah Al-Ikhlas in the original.</p>
      <div class="chips"><span>Reading essentials</span><span>Word basics</span><span>Sentences &amp; cases</span><span>Checkpoint: Al-Ikhlas</span></div>
      <div class="ct" data-ct>Not started</div>
    </div>

    <div class="card" data-stop="2">
      <span class="rn">Level 2 · {totals[2]} lessons</span>
      <h2>Core Grammar <span lang="ar" dir="rtl">القواعد الأساسية</span></h2>
      <p>How every Arabic sentence works: the three cases, possession, description, and the particles that transform meaning. It ends with Surah Al-Kawthar.</p>
      <div class="chips"><span>Sentence types</span><span>The three cases</span><span>Possession &amp; description</span><span>Checkpoint: Al-Kawthar</span></div>
      <div class="ct" data-ct>Not started</div>
    </div>

    <div class="card" data-stop="3">
      <span class="rn">Level 3 · {totals[3]} lessons</span>
      <h2>Intermediate <span lang="ar" dir="rtl">القواعد المتوسطة</span></h2>
      <p>The verb system in full: all ten forms, the five moods, and every pronoun the Quran uses. At the end, you parse each word of Surah Al-ʿAsr yourself.</p>
      <div class="chips"><span>Roots &amp; Form I</span><span>Conjugation &amp; moods</span><span>Pronouns</span><span>Forms II–X</span><span>Checkpoint: Al-ʿAsr</span></div>
      <div class="ct" data-ct>Not started</div>
    </div>

    <div class="card" data-stop="4">
      <span class="rn">Level 4 · {totals[4]} lessons</span>
