          <a class="btn btn-ghost" href="#curriculum">Browse all 81 lessons</a>
        </div>
      </div>
    </div>

    <div id="rail" aria-hidden="true">
      <span data-s="0"><i>Start</i></span>
      <span data-s="1"><i>Foundation</i></span>
      <span data-s="2"><i>Core Grammar</i></span>
      <span data-s="3"><i>Intermediate</i></span>
      <span data-s="4"><i>Advanced</i></span>
      <span data-s="5"><i>Applied Study</i></span>
      <span data-s="6"><i>Begin</i></span>
    </div>
  </div>
</div>

