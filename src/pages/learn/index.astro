---
import { metaTitle, metaDescription } from '../../lib/seo';
/**
 * /learn: every lesson, in the order it is taught. Light only, standalone (no BaseLayout), like home.
 * The whole list is plain HTML, so it reads and links without JavaScript; src/scripts/learn.ts adds
 * saved progress, the filter, the level rail and the phone fold.
 * Lessons come from the collection, grouped by src/data/curriculum-map.ts; the words around them are in
 * src/data/learn-copy.ts. Counts are never typed in here.
 */
import { getCollection } from 'astro:content';
import SiteNav from '../../components/SiteNav.astro';
import SiteFoot from '../../components/SiteFoot.astro';
import CookieBanner from '../../components/CookieBanner.astro';
import LessonMovedNote from '../../components/LessonMovedNote.astro';
import '../../styles/fonts.css';
import '../../styles/learn.css';
import { CURRICULUM_MAP, clusterForLesson } from '../../data/curriculum-map';
import { READING_TRACK } from '../../data/reading-track';
import { LEVEL_COPY, LEARN_PAGE } from '../../data/learn-copy';
import { normalize } from '../../lib/learn';

const lessons = await getCollection('lessons');
const surahs = await getCollection('surahs');

// Drift guard, both directions, fails the build: every lesson file belongs to a topic group, and every
// number a group lists is a real lesson file.
for (const l of lessons) clusterForLesson(l.data.level, l.data.order);
const byKey = new Map(lessons.map((l) => [`${l.data.level}:${l.data.order}`, l]));
for (const { level, clusters } of CURRICULUM_MAP) {
  for (const c of clusters) for (const order of c.lessons) {
    if (!byKey.has(`${level}:${order}`)) throw new Error(`learn: level ${level} lesson ${order} (group "${c.title}") has no file in src/content/lessons/`);
  }
}

const surahName = (slug: string) => {
  const s = surahs.find((x) => x.id === slug);
  if (!s) throw new Error(`learn: reading-track slug "${slug}" is not a surah`);
  return s.data.name;
};

const levels = CURRICULUM_MAP.map(({ level, clusters }) => {
  const copy = LEVEL_COPY[level];
  const groups = clusters.map((c) => ({
    title: c.title,
    note: c.note ?? '',
    essential: !!c.essential,
    checkpoint: !!c.checkpoint,
    lessons: c.lessons.map((order) => {
      const l = byKey.get(`${level}:${order}`)!;
      return {
        id: l.id, order, title: l.data.title, description: l.data.description ?? '',
        // What the filter matches, folded the same way as the visitor's query (see src/lib/learn.ts).
        search: normalize([l.data.title, l.data.description ?? '', c.title, `level ${level}`].join(' ')),
      };
    }),
  }));
  const reading = READING_TRACK.filter((e) => e.afterLevel === level).map((e) => ({ href: `/surahs/${e.slug}/`, name: surahName(e.slug) }));
  return { level, ...copy, groups, count: groups.reduce((n, g) => n + g.lessons.length, 0), reading };
});

const total = levels.reduce((n, l) => n + l.count, 0);
const firstId = levels[0].groups[0].lessons[0].id;

const title = LEARN_PAGE.title;
const description = `Browse all ${total} Quranic Arabic grammar lessons across ${levels.length} levels, in the order they are taught. From the alphabet and vowels to verb forms, case endings and reading whole passages.`;
const canonicalURL = new URL('/learn/', Astro.site);
const ogImageURL = new URL('/images/og-default.jpg', Astro.site);

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': 'https://www.quranic-grammar.com/learn/#course',
  name: 'Quranic Arabic Grammar',
  description: `A structured course for learning Quranic Arabic grammar from beginner to advanced, ${total} lessons across ${levels.length} levels.`,
  url: 'https://www.quranic-grammar.com/learn/',
  provider: { '@type': 'Organization', name: 'Quranic Grammar', url: 'https://www.quranic-grammar.com/' },
  numberOfCredits: 0,
  isAccessibleForFree: true,
  inLanguage: 'en',
  hasCourseInstance: levels.map((l) => ({ '@type': 'CourseInstance', name: `Level ${l.level}: ${l.title}`, description: l.blurb, courseMode: 'online' })),
};

const ICON = {
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>',
  chev: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>',
  arrow: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"/></svg>',
};
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <!-- Google Analytics (GA4) and Ahrefs, queued now and loaded later (see below). -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    try { if (localStorage.getItem('qg-cookie-consent') === 'accepted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
    gtag('js', new Date());
    gtag('config', 'G-1MSBYYQT5Z');
    // Load them on the first tap, key press or scroll, or 5 seconds after the page loads, whichever comes
    // first: on a phone the analytics script alone blocked the main thread for about 500 ms.
    (function () {
      var started = false, timer;
      var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
      function start() {
        if (started) return;
        started = true;
        clearTimeout(timer);
        events.forEach(function (t) { removeEventListener(t, start, true); });
        var g = document.createElement('script'); g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=G-1MSBYYQT5Z'; document.head.appendChild(g);
        if ((function(){try{return localStorage.getItem('qg-cookie-consent')==='accepted'}catch(e){return false}})()) { var a = document.createElement('script'); a.async = true; a.src = 'https://analytics.ahrefs.com/analytics.js'; a.setAttribute('data-key', 'sW/uZfxMauSpqoKnSL6i6g'); document.head.appendChild(a); }
      }
      events.forEach(function (t) { addEventListener(t, start, { capture: true, passive: true }); });
      addEventListener('load', function () { timer = setTimeout(start, 5000); });
    })();
  </script>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={metaDescription(description)} />
  <meta name="theme-color" content="#fbfcfd" />
  <title>{metaTitle(title)}</title>
  <link rel="canonical" href={canonicalURL.href} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription(description)} />
  <meta property="og:image" content={ogImageURL.href} />
  <meta property="og:site_name" content="Quranic Grammar" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription(description)} />
  <meta name="twitter:image" content={ogImageURL.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="preload" href="/fonts/geist-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-400.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(courseSchema).replace(/<\//g, '<\\/')} />
</head>
<body>
<a href="#main-content" class="skip">Skip to main content</a>
<SiteNav current="learn" />

<div class="wrap shell">
  <aside class="rail" aria-label="Find a lesson">
    <form class="find js-only" role="search" id="find">
      <label class="vh" for="q">Filter lessons</label>
      <Fragment set:html={ICON.search} />
      <input id="q" type="search" autocomplete="off" placeholder="Filter lessons" aria-controls="list" />
      <button type="button" class="clear" aria-label="Clear filter"><Fragment set:html={ICON.x} /></button>
    </form>
    <p class="rail-h" id="lvs-h">Levels</p>
    <nav aria-labelledby="lvs-h">
      <ol class="lvs">
        {levels.map((l) => (
          <li>
            <a class="lv" href={`#level-${l.level}`} data-level={l.level}>
              <span class="ln">{l.level}</span>
              <span class="lt">{l.title}</span>
              <small><span class="lcount" data-total={l.count}>{l.count} lessons</span><i><s></s></i></small>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <p class="refs"><span>Reference tools</span>{LEARN_PAGE.tools.map((t) => <a href={t.href}>{t.label}</a>)}</p>
  </aside>

  <main id="main-content">
    <section class="top" aria-labelledby="learn-h">
      <LessonMovedNote />
      <h1 class="h1" id="learn-h">{LEARN_PAGE.h1}</h1>
      <p class="dek">{total} lessons in {levels.length} levels. Begin at Level 1, or type a topic such as “cases” to find it. Nothing is locked.</p>
      <p class="refs refs-main"><span>Reference tools</span>{LEARN_PAGE.tools.map((t) => <a href={t.href}>{t.label}</a>)}</p>
      <div class="resume" id="resume" hidden>
        <div><small>Continue where you left off</small><b id="resume-title"></b></div>
        <a class="btn" id="resume-link" href="#"><span class="btxt">Continue</span><Fragment set:html={ICON.arrow} /></a>
      </div>
    </section>
    <p class="count" id="count" aria-live="polite" data-total={total} data-levels={levels.length}>{total} lessons in {levels.length} levels</p>

    <div id="list">
      {levels.map((l) => (
        <section class="lvl" id={`level-${l.level}`} data-level={l.level} aria-labelledby={`level-${l.level}-h`}>
          <div class="lvl-head">
            <span class="num" aria-hidden="true">{l.level}</span>
            <h2 id={`level-${l.level}-h`}><span class="vh">Level {l.level}: </span>{l.title}</h2>
            <span class="ar" lang="ar" dir="rtl">{l.titleAr}</span>
            <div class="prog"><i><s></s></i><span class="ptxt"></span></div>
            <button class="fold" type="button" aria-expanded="true" aria-controls={`level-${l.level}-body`}><Fragment set:html={ICON.chev} /><span class="vh">Show or hide Level {l.level}</span></button>
            <p class="assume">{l.needs}</p>
          </div>
          <div class="lvl-body" id={`level-${l.level}-body`}>
            {l.groups.map((g) => (
              <div class="grp">
                <div class="grp-h"><h3>{g.title}</h3><span>{g.note || `${g.lessons.length} ${g.lessons.length === 1 ? 'lesson' : 'lessons'}`}</span></div>
                <div class="rows">
                  {g.lessons.map((x) => (
                    <a class="row" href={`/learn/${x.id}/`} data-id={x.id} data-level={l.level} data-q={x.search}>
                      <span class="n">{x.order}</span>
                      <span class="t"><b>{x.title}</b>{x.description && <span class="d">{x.description}</span>}</span>
                      <span class="tags">
                        {x.id === firstId && <span class="tag next" data-start>Start here</span>}
                        {g.essential && <span class="tag ess">Essential</span>}
                        {g.checkpoint && <span class="tag chk">Checkpoint</span>}
                      </span>
                      <span class="tick" aria-hidden="true"><Fragment set:html={ICON.check} /></span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
            <div class="more">
              <a href={`/learn/level-${l.level}/quiz/`}>Quiz<span class="vh"> for Level {l.level}</span><Fragment set:html={ICON.arrow} /></a>
              {l.level >= 2 && <a href={`/learn/level-${l.level}/review/`}>Review<span class="vh"> for Level {l.level}</span><Fragment set:html={ICON.arrow} /></a>}
              <a href={`/learn/level-${l.level}/vocabulary/`}>Vocabulary<span class="vh"> for Level {l.level}</span><Fragment set:html={ICON.arrow} /></a>
              {l.reading.length > 0 && (
                <span class="read">Read now: {l.reading.slice(0, 3).map((r, i) => <>{i > 0 && ', '}<a href={r.href}>{r.name}</a></>)}{l.reading.length > 3 && <>, and <a href="/surahs/">{l.reading.length - 3} more</a></>}</span>
              )}
            </div>
          </div>
        </section>
      ))}
      <div class="empty" id="empty" hidden>
        <b>No lesson matches that.</b>
        <p>Try one word, such as “verb”, “case” or “sentence”. For anything else, <a href="/search/">search the whole site</a>.</p>
      </div>
    </div>
  </main>
</div>

<SiteFoot />
<CookieBanner tone="light" />
<script>
  import '../../scripts/learn';
</script>
</body>
</html>
