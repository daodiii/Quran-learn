---
import { render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import ResponsiveImage from '../../components/mdx/ResponsiveImage.astro';
import { lessonPaths } from '../../lib/lesson-paths';
import { getEntryDates } from '../../lib/getEntryDates';

// Classic (long page) lessons. Lessons with `template: steps` are served by [level]/[lesson].astro.
export async function getStaticPaths() {
  const all = await lessonPaths();
  return all
    .filter((p) => p.lesson.data.template !== 'steps')
    .map((p) => ({ params: { slug: p.lesson.id }, props: p }));
}

const { lesson, computedPrevLesson, computedNextLesson, positionInLevel } = Astro.props;
const { Content, headings } = await render(lesson);

const { datePublished, dateModified } = getEntryDates(
  `src/content/lessons/${lesson.id}.mdx`,
  lesson.data,
);
---

<LessonLayout
  title={lesson.data.title}
  titleArabic={lesson.data.titleArabic}
  level={lesson.data.level}
  description={lesson.data.description}
  nextLesson={computedNextLesson}
  prevLesson={computedPrevLesson}
  datePublished={datePublished}
  dateModified={dateModified}
  headings={headings}
  positionInLevel={positionInLevel}
>
  <Content components={{ img: ResponsiveImage }} />
</LessonLayout>
