---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/primitives/Container.astro';
import VocabList from '../../../components/VocabList.astro';
import { getCollection } from 'astro:content';
import vocabData from '../../../data/vocab/lessons.json';

export async function getStaticPaths() {
  return [1, 2, 3, 4, 5].map(n => ({ params: { level: `level-${n}` } }));
}

const { level } = Astro.params;
const levelNum = Number(level!.split('-')[1]);

const lessons = (await getCollection('lessons'))
  .filter(l => l.data.level === levelNum)
  .sort((a, b) => a.data.order - b.data.order);

const groups = lessons
  .map(l => ({
    id: l.id,
    order: l.data.order,
    title: l.data.title,
    entries: (vocabData as Record<string, any[]>)[l.id] ?? [],
  }))
  .filter(g => g.entries.length > 0);

const totalWords = groups.reduce((n, g) => n + g.entries.length, 0);
---

<BaseLayout title={`Level ${levelNum} Vocabulary`} description={`All ${totalWords} high-frequency Quranic words introduced across Level ${levelNum} lessons, with recall practice mode.`}>
  <Container maxWidth="md">
    <header class="page-header">
      <h1 class="page-title">Level {levelNum} vocabulary</h1>
      <p class="page-subtitle">
        {totalWords} words, in the order the lessons introduced them. Every word appears
        in a verse you studied.
      </p>
      <button type="button" class="recall-toggle" data-recall-toggle aria-pressed="false">
        Recall mode
      </button>
      <p class="recall-hint" data-recall-hint hidden>Meanings are hidden. Select a word to reveal it.</p>
    </header>

    <div class="vocab-groups" data-vocab-groups>
      {groups.map(g => (
        <section class="vocab-group" aria-labelledby={`vg-${g.order}`}>
          <h2 id={`vg-${g.order}`} class="vocab-group-title">
            <a href={`/learn/${g.id}/`}>Lesson {g.order} · {g.title}</a>
          </h2>
          <VocabList entries={g.entries} />
        </section>
      ))}
    </div>
  </Container>
</BaseLayout>

<style>
  .page-header {
    padding-block-start: var(--spacing-2xl);
    padding-block-end: var(--spacing-lg);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin: 0 0 var(--spacing-sm);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    max-inline-size: 55ch;
    margin: 0 0 var(--spacing-md);
  }

  .recall-toggle {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-primary);
    background: transparent;
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-full);
    padding: 0.375rem 1rem;
    cursor: pointer;
    transition: background 200ms cubic-bezier(0.23, 1, 0.32, 1),
                color 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .recall-toggle[aria-pressed="true"] {
    background: var(--accent-primary);
    color: var(--text-inverse);
  }

  .recall-toggle:active { transform: scale(0.97); }

  .recall-hint {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    margin: var(--spacing-sm) 0 0;
  }

  .vocab-group { margin-block-start: var(--spacing-xl); }

  .vocab-group-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 var(--spacing-xs);
  }

  .vocab-group-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .vocab-group-title a:hover { color: var(--accent-primary); }

  /* Recall mode: hide glosses until the row is revealed */
  .vocab-groups.recall :global([data-vocab-gloss]) { visibility: hidden; }
  .vocab-groups.recall :global(.revealed [data-vocab-gloss]) { visibility: visible; }
  .vocab-groups.recall :global([data-vocab-row]) { cursor: pointer; }
</style>

<script>
  const toggle = document.querySelector('[data-recall-toggle]') as HTMLButtonElement | null;
  const hint = document.querySelector('[data-recall-hint]') as HTMLElement | null;
  const groups = document.querySelector('[data-vocab-groups]') as HTMLElement | null;

  if (toggle && groups) {
    const rows = groups.querySelectorAll<HTMLElement>('[data-vocab-row]');

    toggle.addEventListener('click', () => {
      const on = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(on));
      groups.classList.toggle('recall', on);
      if (hint) hint.hidden = !on;
      rows.forEach(row => {
        row.classList.remove('revealed');
        if (on) {
          row.setAttribute('tabindex', '0');
          row.setAttribute('role', 'button');
          row.setAttribute('aria-label', 'Reveal meaning');
        } else {
          row.removeAttribute('tabindex');
          row.removeAttribute('role');
          row.removeAttribute('aria-label');
        }
      });
    });

    groups.addEventListener('click', (e) => {
      if (!groups.classList.contains('recall')) return;
      const row = (e.target as HTMLElement).closest('[data-vocab-row]');
      if (row && !(e.target as HTMLElement).closest('a')) row.classList.toggle('revealed');
    });

    groups.addEventListener('keydown', (e) => {
      if (!groups.classList.contains('recall')) return;
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const row = (e.target as HTMLElement).closest('[data-vocab-row]');
      if (row) { e.preventDefault(); row.classList.toggle('revealed'); }
    });
  }
</script>
