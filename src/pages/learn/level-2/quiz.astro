---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/primitives/Container.astro';
import QuizComponent from '../../../components/Quiz.astro';
import { getCollection } from 'astro:content';

const LEVEL = 2;
const allLessons = await getCollection('lessons');
const levelLessons = allLessons.filter(l => l.data.level === LEVEL).sort((a, b) => a.data.order - b.data.order);
const nextLevelLessons = allLessons.filter(l => l.data.level === LEVEL + 1).sort((a, b) => a.data.order - b.data.order);
const prevLesson = levelLessons.length > 0 ? `/learn/${levelLessons[levelLessons.length - 1].id}/` : undefined;
const nextLesson = nextLevelLessons.length > 0 ? `/learn/${nextLevelLessons[0].id}/` : undefined;

const questions = [
  {
    id: 1,
    question: "What are the three cases of an Arabic noun?",
    options: [
      "Nominative (rafʿ), accusative (naṣb), genitive (jarr)",
      "Fatha, Kasra, Damma",
      "Mubtadaʾ, Khabar, Fāʿil",
      "Noun, Verb, Little word",
    ],
    correctAnswer: 0,
    explanation: "The three cases are nominative (rafʿ, -u), accusative (naṣb, -a) and genitive (jarr, -i) (L2.04 to L2.06)."
  },
  {
    id: 2,
    question: "Which mark shows the nominative on a single noun?",
    options: [
      "Fatha",
      "Kasra",
      "Damma",
      "Sukun",
    ],
    correctAnswer: 2,
    explanation: "The damma (-u, or -un when indefinite) shows the nominative on a single noun (L2.04)."
  },
  {
    id: 3,
    question: "What is an idafah (إضافة)?",
    options: [
      "Two nouns in a row that mean 'the X of Y'",
      "A verb conjugation",
      "A sentence type",
      "A plural form",
    ],
    correctAnswer: 0,
    explanation: "An idafah puts two nouns together, 'the X of Y'. The first word is the muḍāf and the second the muḍāf ilayh (L2.08)."
  },
  {
    id: 4,
    question: "In an idafah, what case is the second word (the muḍāf ilayh)?",
    options: [
      "Nominative",
      "Accusative",
      "Genitive",
      "It has no case",
    ],
    correctAnswer: 2,
    explanation: "The second word of an idafah is always genitive. The sign changes with the word, not the case (L2.08)."
  },
  {
    id: 5,
    question: "What is the fāʿil (فاعل)?",
    options: [
      "The verb",
      "The doer of the verb",
      "The thing acted on",
      "The news of a nominal sentence",
    ],
    correctAnswer: 1,
    explanation: "The fāʿil is the doer of the verb in a verbal sentence (L2.03)."
  },
  {
    id: 6,
    question: "In which case is the fāʿil (the doer)?",
    options: [
      "Nominative",
      "Accusative",
      "Genitive",
      "It has no case",
    ],
    correctAnswer: 0,
    explanation: "The fāʿil is nominative (L2.03, L2.04)."
  },
  {
    id: 7,
    question: "What is the Maf'ul Bihi (مفعول به)?",
    options: ["The subject", "The direct object", "The predicate", "The verb"],
    correctAnswer: 1,
    explanation: "Maf'ul Bihi is the direct object that receives the action of the verb."
  },
  {
    id: 8,
    question: "In which case is the mafʿūl bihi (the thing acted on)?",
    options: [
      "Nominative",
      "Accusative",
      "Genitive",
      "It has no case",
    ],
    correctAnswer: 1,
    explanation: "The mafʿūl bihi is accusative, usually with a fatha (-a) (L2.05)."
  },
  {
    id: 9,
    question: "In a nominal sentence, in which case is the mubtadaʾ (المبتدأ)?",
    options: [
      "Nominative",
      "Accusative",
      "Genitive",
      "It has no case",
    ],
    correctAnswer: 0,
    explanation: "The mubtadaʾ, the starting point of a nominal sentence, is nominative (L2.01)."
  },
  {
    id: 10,
    question: "Which little word means 'for' or 'belonging to'?",
    options: [
      "في (fī)",
      "من (min)",
      "لِ (li)",
      "إلى (ilā)",
    ],
    correctAnswer: 2,
    explanation: "لِ (li) means 'for' or 'belonging to': وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ, 'to Allah belongs what is in the heavens' (3:109, L2.07)."
  },
  {
    id: 11,
    question: "An adjective must match its noun in how many things?",
    options: [
      "One: gender",
      "Two: gender and number",
      "Three: gender, number and case",
      "Four: gender, number, case and definiteness",
    ],
    correctAnswer: 3,
    explanation: "An adjective matches its noun in gender, number, case and definiteness (L2.09)."
  },
  {
    id: 12,
    question: "After إِنَّ, in which case is the first noun (the ism of inna)?",
    options: [
      "Nominative",
      "Accusative",
      "Genitive",
      "It has no case",
    ],
    correctAnswer: 1,
    explanation: "إِنَّ puts the first noun in the accusative, and the khabar stays nominative (L2.10)."
  },
  {
    id: 13,
    question: "After كَانَ, in which case is its khabar?",
    options: [
      "Nominative",
      "Accusative",
      "Genitive",
      "It has no case",
    ],
    correctAnswer: 1,
    explanation: "كَانَ keeps its ism in the nominative and puts its khabar in the accusative (L2.11)."
  }
];
---

<BaseLayout title="Level 2 Quiz - Core Grammar" description="Test your Core Grammar knowledge: nominal and verbal sentences, the three cases, idafah, adjective agreement, inna and kāna.">
  <Container maxWidth="lg">
    <QuizComponent
      title="Level 2 Quiz: Core Grammar"
      questions={questions}
      passingScore={70}
      level={2}
    />
    <nav class="quiz-nav">
      {prevLesson ? (
        <a href={prevLesson} class="nav-link prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Previous Lesson
        </a>
      ) : <div></div>}
      {nextLesson ? (
        <a href={nextLesson} class="nav-link next">
          Next Lesson
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ) : <div></div>}
    </nav>
  </Container>
</BaseLayout>

<style>
  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 85ch;
    margin-inline: auto;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-gold);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-link svg {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .nav-link.prev:hover svg {
    transform: translateX(-2px);
  }

  .nav-link.next:hover svg {
    transform: translateX(2px);
  }
</style>
