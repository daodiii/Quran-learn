---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/primitives/Container.astro';
import QuizComponent from '../../../components/Quiz.astro';
import { getCollection } from 'astro:content';

const LEVEL = 3;
const allLessons = await getCollection('lessons');
const levelLessons = allLessons.filter(l => l.data.level === LEVEL).sort((a, b) => a.data.order - b.data.order);
const nextLevelLessons = allLessons.filter(l => l.data.level === LEVEL + 1).sort((a, b) => a.data.order - b.data.order);
const prevLesson = levelLessons.length > 0 ? `/learn/${levelLessons[levelLessons.length - 1].id}/` : undefined;
const nextLesson = nextLevelLessons.length > 0 ? `/learn/${nextLevelLessons[0].id}/` : undefined;

const questions = [
  {
    id: 1,
    question: "How many numbered verb forms does the Quran use?",
    options: [
      "5 forms",
      "8 forms",
      "10 forms",
      "15 forms",
    ],
    correctAnswer: 2,
    explanation: "The Quran uses ten forms, numbered I to X (L3.03). The root stays the same in all ten; only the shape around it changes. Form I is the bare verb."
  },
  {
    id: 2,
    question: "What is a Form I verb?",
    options: [
      "A verb with a causative meaning",
      "The bare verb: three root letters and vowels, nothing added",
      "A verb with a reflexive meaning",
      "A verb with a reciprocal meaning",
    ],
    correctAnswer: 1,
    explanation: "Form I (فَعَلَ) is the bare verb. It gives the plain meaning of the root (L3.04)."
  },
  {
    id: 3,
    question: "In 96:5, عَلِمَ means 'he knew' and عَلَّمَ means 'he taught'. What did the doubled ل add?",
    options: [
      "A second person who makes someone else know",
      "A passive meaning",
      "A negative meaning",
      "The idea of doing it to oneself",
    ],
    correctAnswer: 0,
    explanation: "Form I عَلِمَ has one person, the one who knows. Form II عَلَّمَ adds a teacher, who makes someone know, so the verb now takes two objects (L3.12). This is one use of the doubling, not a rule for all Form II verbs."
  },
  {
    id: 4,
    question: "In ٱلَّذِى خَلَقَنِى فَهُوَ يَهْدِينِ (Ash-Shuʿara 26:78), why does 'me' on the verb appear as ـنِى and not just ـِى?",
    options: [
      "The extra nūn is the protecting nūn (nūn al-wiqāya): it takes the kasra the yāʾ needs, so the verb keeps its fatha",
      "The nūn marks the plural",
      "The nūn is a root letter of خَلَقَ",
      "The nūn makes the verb passive",
    ],
    correctAnswer: 0,
    explanation: "On a verb, 'me' is ـنِى: the nūn protects the fatha of the verb. On a noun it is ـِى, as in كِتَابِى (L3.02)."
  },
  {
    id: 5,
    question: "Made-up example: a present verb ends in a sukūn after لَمْ, as in لَمْ يَجْعَلْ. What is this ending called, and what does the verb mean?",
    options: [
      "Jazm: 'he did not put'",
      "Naṣb: 'he will not put'",
      "Rafʿ: 'he puts'",
      "Jazm: 'he will not put'",
    ],
    correctAnswer: 0,
    explanation: "لَمْ puts the present form in jazm and gives it a past meaning: لَمْ يَجْعَلْ, 'he did not put' (L3.07). لَنْ brings naṣb, the -a ending."
  },
  {
    id: 6,
    question: "Which word is the doer word (active participle) from the root ك ت ب?",
    options: [
      "كَاتِبٌ",
      "مَكْتُوبٌ",
      "كَتَبَ",
      "يَكْتُبُ",
    ],
    correctAnswer: 0,
    explanation: "كَاتِبٌ has the pattern فَاعِل, which names the one who does the action. مَكْتُوبٌ, pattern مَفْعُول, is the done-to word (L3.19)."
  },
  {
    id: 7,
    question: "What is the passive voice called in Arabic grammar?",
    options: ["المبني للمعلوم", "المبني للمجهول", "المضارع", "الماضي"],
    correctAnswer: 1,
    explanation: "Passive voice is المبني للمجهول (Al-Mabni lil-Majhul), literally 'built for the unknown'."
  },
  {
    id: 8,
    question: "In passive voice, what happens to the fāʿil (the doer)?",
    options: [
      "It remains unchanged",
      "It becomes accusative",
      "It is not named",
      "It becomes genitive",
    ],
    correctAnswer: 2,
    explanation: "A passive verb does not name its doer. The word that was the object takes the doer's place; the grammar books call it the nāʾib fāʿil, the stand-in for the doer (L3.09)."
  },
  {
    id: 9,
    question: "What is the pattern for a Form III verb?",
    options: [
      "فَعَلَ",
      "فَعَّلَ",
      "فَاعَلَ",
      "أَفْعَلَ",
    ],
    correctAnswer: 2,
    explanation: "Form III is فَاعَلَ, with a long ā after the first root letter (L3.17). In many verses the action has someone on the other side (with, against or towards), but not always. Read the verse."
  },
  {
    id: 10,
    question: "How is the passive voice formed in past tense (Form I)?",
    options: [
      "Change first vowel to Kasra, second to Fatha",
      "Change first vowel to Damma, second to Kasra",
      "Change both vowels to Damma",
      "Change both vowels to Fatha"
    ],
    correctAnswer: 1,
    explanation: "Passive past tense: change فَعَلَ to فُعِلَ (first vowel Damma, second Kasra)."
  },
  {
    id: 11,
    question: "Which pronoun means 'we'?",
    options: [
      "أَنَا",
      "نَحْنُ",
      "هُوَ",
      "أَنْتَ",
    ],
    correctAnswer: 1,
    explanation: "نَحْنُ is the separate pronoun for 'we'. أَنَا is 'I', هُوَ is 'he' and أَنْتَ is 'you' (one man) (L3.01)."
  },
  {
    id: 12,
    question: "Which prefix on a present verb means 'we'?",
    options: [
      "أَ",
      "نَ",
      "تَ",
      "يَ",
    ],
    correctAnswer: 1,
    explanation: "The prefix نَـ marks 'we': نَعْبُدُ, 'we worship' (L3.06)."
  },
  {
    id: 13,
    question: "ذَٰلِكَ means 'that' (far, one male). Which word means 'this' (near, one male)?",
    options: [
      "هَٰذَا",
      "تِلْكَ",
      "ذَٰلِكَ",
      "هَٰذِهِ",
    ],
    correctAnswer: 0,
    explanation: "هَٰذَا is 'this' for one male. Near words start with هَـ and far words end in ـكَ (L3.10)."
  },
  {
    id: 14,
    question: "Which joining noun is used for a group of men?",
    options: [
      "ٱلَّذِى",
      "ٱلَّتِى",
      "ٱلَّذِينَ",
      "مَا",
    ],
    correctAnswer: 2,
    explanation: "ٱلَّذِينَ is the form for a group of men (L3.11). ٱلَّذِى is for one man and ٱلَّتِى for one woman."
  }
];
---

<BaseLayout title="Level 3 Quiz - Intermediate" description="Test your Intermediate knowledge: pronouns, the verb forms, the present tense, jazm, the passive, this and that, who and which, and doer words.">
  <Container maxWidth="lg">
    <QuizComponent
      title="Level 3 Quiz: Intermediate Grammar"
      questions={questions}
      passingScore={70}
      level={3}
    />
    <nav class="quiz-nav">
      {prevLesson ? (
        <a href={prevLesson} class="nav-link prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Previous Lesson
        </a>
      ) : <div></div>}
      {nextLesson ? (
        <a href={nextLesson} class="nav-link next">
          Next Lesson
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ) : <div></div>}
    </nav>
  </Container>
</BaseLayout>

<style>
  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 85ch;
    margin-inline: auto;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-gold);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-link svg {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .nav-link.prev:hover svg {
    transform: translateX(-2px);
  }

  .nav-link.next:hover svg {
    transform: translateX(2px);
  }
</style>
