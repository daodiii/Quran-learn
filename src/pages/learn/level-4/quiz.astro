---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/primitives/Container.astro';
import QuizComponent from '../../../components/Quiz.astro';
import { getCollection } from 'astro:content';

const LEVEL = 4;
const allLessons = await getCollection('lessons');
const levelLessons = allLessons.filter(l => l.data.level === LEVEL).sort((a, b) => a.data.order - b.data.order);
const nextLevelLessons = allLessons.filter(l => l.data.level === LEVEL + 1).sort((a, b) => a.data.order - b.data.order);
const prevLesson = levelLessons.length > 0 ? `/learn/${levelLessons[levelLessons.length - 1].id}/` : undefined;
const nextLesson = nextLevelLessons.length > 0 ? `/learn/${nextLevelLessons[0].id}/` : undefined;

const questions = [
  {
    id: 1,
    question: "Which of these words can open an 'if' sentence in the Quran?",
    options: [
      "لو (law)",
      "إن (in)",
      "إذا (idha)",
      "All of the above",
    ],
    correctAnswer: 3,
    explanation: "إِنْ, إِذَا and لَوْ can all open an 'if' sentence. إِنْ leaves the case open, إِذَا is for what you expect ('when/if'), and لَوْ is for what is not so or did not happen (L4.04)."
  },
  {
    id: 2,
    question: "What is the usual difference between إن (in) and إذا (idha)?",
    options: [
      "No difference",
      "إِذَا is usually for what you expect, إِنْ for what is open",
      "إذا for past only",
      "إن for present only",
    ],
    correctAnswer: 1,
    explanation: "Teachers describe it this way and the verses often fit, as in 5:6 (إِذَا for standing up for prayer, إِنْ for illness). It is a tendency, not a rule: 21:34 uses إِنْ for death (L4.04)."
  },
  {
    id: 3,
    question: "What word is used for exception (meaning 'except')?",
    options: [
      "لكن (laakin)",
      "إلا (illa)",
      "بل (bal)",
      "لولا (lawla)",
    ],
    correctAnswer: 1,
    explanation: "إِلَّا (illā) means 'except' and is the exception word this lesson teaches. The book also lists غَيْر and سِوَى (nouns), among others (L4.05)."
  },
  {
    id: 4,
    question: "What is the Maf'ul Mutlaq (المفعول المطلق)?",
    options: [
      "Direct object",
      "The verb's own verbal noun, or a stand-in for it, in naṣb: it says how the action happened",
      "Object of time",
      "Object of place",
    ],
    correctAnswer: 1,
    explanation: "The mafʿūl muṭlaq is a verbal noun in naṣb, usually from the verb's own root. It stresses the verb, gives its kind, or counts it (L4.07). A same-root word can still be an object, as in يَكْتُبُونَ ٱلْكِتَٰبَ."
  },
  {
    id: 5,
    question: "Which word before a present verb gives it a fatha (naṣb) and means 'will not'?",
    options: [
      "لَمْ",
      "لَنْ",
      "لَمَّا",
      "لَا",
    ],
    correctAnswer: 1,
    explanation: "لَنْ is a word of negation and naṣb, and its meaning looks ahead ('will not'): فَلَنْ أَبْرَحَ, where the verb أَبْرَحُ becomes أَبْرَحَ (12:80). لَمْ and لَمَّا bring jazm and point to the past; لَا before a plain verb leaves it alone (L4.10)."
  },
  {
    id: 6,
    question: "What is Maf'ul Li-Ajlihi (المفعول لأجله)?",
    options: [
      "Object of result",
      "Object of purpose/reason",
      "Object of manner",
      "Object of accompaniment"
    ],
    correctAnswer: 1,
    explanation: "Maf'ul Li-Ajlihi indicates the reason or purpose for which an action is done."
  },
  {
    id: 7,
    question: "What is the Maf'ul Ma'ahu (المفعول معه)?",
    options: [
      "Object of time",
      "Object of accompaniment (with)",
      "Direct object",
      "Object of place",
    ],
    correctAnswer: 1,
    explanation: "The mafʿūl maʿahu is the noun after the wāw of togetherness (wāw al-maʿiyya), meaning 'with' or 'along with'. The Quran has very few clear cases (L4.09)."
  },
  {
    id: 8,
    question: "Which kind of verb has a weak letter (و or ي) in the middle of its root, like قَالَ from ق و ل?",
    options: [
      "Hollow (أَجْوَف)",
      "Defective (نَاقِص)",
      "Assimilated (مِثَال)",
      "Doubled (مُضَعَّف)",
    ],
    correctAnswer: 0,
    explanation: "L4.11 sorts verbs by where the special letter sits in the root: middle = hollow (قَالَ), end = defective (قَضَىٰ), start = assimilated (وَقَعَ)."
  },
  {
    id: 9,
    question: "What is التمييز (at-Tamyiz)?",
    options: [
      "The direct object",
      "The specification/clarification",
      "The predicate",
      "The adjective",
    ],
    correctAnswer: 1,
    explanation: "A tamyiz is an indefinite noun in the accusative that clears up something vague, such as a number or a measure. After the numbers 3 to 10 the counted word is a genitive plural, not a tamyiz (L4.02)."
  },
  {
    id: 10,
    question: "What is الحال (al-Haal)?",
    options: [
      "The subject",
      "The state of the doer or the object while the action happens (a word, sentence or phrase)",
      "The predicate",
      "The object",
    ],
    correctAnswer: 1,
    explanation: "The ḥāl says in what state its owner was while the action happened: خَآئِفًا, 'he left afraid' (28:21). In the books it is an accusative noun; the Quran also uses a sentence (wāw al-ḥāl, 'while') or a phrase (L4.01)."
  },
  {
    id: 11,
    question: "Which word before a present verb puts it in jazm and points to the past?",
    options: [
      "لَمْ",
      "لَنْ",
      "لَا",
      "مَا",
    ],
    correctAnswer: 0,
    explanation: "لَمْ puts the present verb in jazm and gives it a past meaning: لَمْ يَلِدْ, 'He has not fathered' (112:3) (L4.10)."
  }
];
---

<BaseLayout title="Level 4 Quiz - Advanced" description="Test your Advanced knowledge: ḥāl, tamyiz, conditional sentences, exception words, the maf'ul types, negation and weak verbs.">
  <Container maxWidth="lg">
    <QuizComponent
      title="Level 4 Quiz: Advanced Grammar"
      questions={questions}
      passingScore={70}
      level={4}
    />
    <nav class="quiz-nav">
      {prevLesson ? (
        <a href={prevLesson} class="nav-link prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Previous Lesson
        </a>
      ) : <div></div>}
      {nextLesson ? (
        <a href={nextLesson} class="nav-link next">
          Next Lesson
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ) : <div></div>}
    </nav>
  </Container>
</BaseLayout>

<style>
  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 85ch;
    margin-inline: auto;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-gold);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-link svg {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .nav-link.prev:hover svg {
    transform: translateX(-2px);
  }

  .nav-link.next:hover svg {
    transform: translateX(2px);
  }
</style>
