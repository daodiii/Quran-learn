---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/primitives/Container.astro';
import QuizComponent from '../../../components/Quiz.astro';
import { getCollection } from 'astro:content';

const LEVEL = 5;
const allLessons = await getCollection('lessons');
const levelLessons = allLessons.filter(l => l.data.level === LEVEL).sort((a, b) => a.data.order - b.data.order);
const prevLesson = levelLessons.length > 0 ? `/learn/${levelLessons[levelLessons.length - 1].id}/` : undefined;
const nextLesson = undefined; // Level 5 is the last level

const questions = [
  {
    id: 1,
    question: "In Surah Al-Fatiha, what is the grammatical function of 'ٱلْحَمْدُ' (al-hamdu) in verse 1:2?",
    options: ["Fa'il (subject)", "Mubtada (topic)", "Khabar (predicate)", "Maf'ul (object)"],
    correctAnswer: 1,
    explanation: "'ٱلْحَمْدُ' is the Mubtada (topic/subject) of the nominal sentence, in Marfu' case."
  },
  {
    id: 2,
    question: "What verb form is 'استغفر' (istaghfara - to seek forgiveness)?",
    options: ["Form I", "Form IV", "Form VIII", "Form X"],
    correctAnswer: 3,
    explanation: "'استغفر' follows Form X pattern (استفعل) which often means 'to seek' or 'to ask for' something."
  },
  {
    id: 3,
    question: "The phrase 'بِسْمِ ٱللَّهِ' begins with which preposition?",
    options: ["بِ (with/by)", "لِ (for)", "في (in)", "من (from)"],
    correctAnswer: 0,
    explanation: "'بِسْمِ' contains the preposition بِ (with/by/in), followed by 'اسم' in Idafah construction."
  },
  {
    id: 4,
    question: "In 'ٱلرَّحْمَٰنِ ٱلرَّحِيمِ' (Al-Fatiha 1:3), both words are in which case?",
    options: ["Marfu'", "Mansub", "Majrur", "Mabni"],
    correctAnswer: 2,
    explanation: "Both are describing words (naʿt) of ٱللَّهِ, so they follow it in the genitive case (kasra). Al-Jadwal reads them this way (L5.02)."
  },
  {
    id: 5,
    question: "What grammatical pattern is 'رَحْمٰن' (Most Merciful)?",
    options: ["فَعِيل", "فَعَّال", "فَعْلان", "أَفْعَل"],
    correctAnswer: 2,
    explanation: "Al-Jadwal says رَحْمَٰن is a describing word on an intensive pattern, فَعْلَان (L5.02). It is not a doer word (فَاعِل)."
  },
  {
    id: 6,
    question: "In أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا (An-Naba 78:6), what does al-Jadwal say the hamza at the start does?",
    options: ["It scolds the listener", "It asks for news the speaker does not have", "It makes the verb passive", "It is a question that leads the listener to say 'yes' (istifham taqriri)"],
    correctAnswer: 3,
    explanation: "Al-Jadwal calls the hamza of أَلَمْ نَجْعَلِ a question of confirmation (istifhām taqrīrī): it leads the listener to agree (L5.13)."
  },
  {
    id: 7,
    question: "The word 'قُرْآن' is derived from which verb root?",
    options: ["ق ر ب (q-r-b)", "ق ر أ (q-r-')", "ق و م (q-w-m)", "ق د س (q-d-s)"],
    correctAnswer: 1,
    explanation: "'قُرْآن' comes from the root ق ر أ (q-r-') meaning 'to read/recite'."
  },
  {
    id: 8,
    question: "What is the علامة (sign/marker) of a sound masculine plural in Marfu' case?",
    options: ["ون (wun)", "ين (in)", "ات (at)", "و (u)"],
    correctAnswer: 0,
    explanation: "Sound masculine plural takes ون (wun) in Marfu' case and ين (in) in Mansub/Majrur cases."
  },
  {
    id: 9,
    question: "The construction 'إِيَّاكَ نَعْبُدُ' demonstrates which grammatical feature?",
    options: [
      "Normal word order",
      "The object put before the verb",
      "Passive voice",
      "Dual form"
    ],
    correctAnswer: 1,
    explanation: "'إِيَّاكَ' (You) is the object, put before the verb 'نَعْبُدُ' (we worship). Al-Jadwal says the repeated 'You' cuts the sharing between the two verbs (L5.02). L5.14 looks at word order."
  },
  {
    id: 10,
    question: "What does al-Jadwal call the particle 'قَد' in وَلَقَدْ, before a past tense verb?",
    options: [
      "A word that makes the verb future",
      "A word of certainty (taḥqīq)",
      "A word that makes the verb passive",
      "A word of negation"
    ],
    correctAnswer: 1,
    explanation: "Al-Jadwal reads قَدْ as a word of certainty, 'certainly' in English (L4.06)."
  },
  {
    id: 11,
    question: "In إِنَّمَا يَخْشَى ٱللَّهَ مِنْ عِبَادِهِ ٱلْعُلَمَٰٓؤُا۟ (Fatir 35:28), the object ٱللَّهَ comes before the doer. Which word is the doer?",
    options: ["ٱللَّهَ", "عِبَادِهِ", "ٱلْعُلَمَٰٓؤُا۟", "يَخْشَى"],
    correctAnswer: 2,
    explanation: "ٱلْعُلَمَٰٓؤُا۟ ends in a ḍamma, so it is the doer. ٱللَّهَ ends in a fatḥa, so it is the object. Al-Jadwal says the order limits the fear to the knowers (L5.14)."
  },
  {
    id: 12,
    question: "In وَٱلضُّحَىٰ (Ad-Duha 93:1), what does the وَ do?",
    options: [
      "It joins this verse to the verse before it",
      "It means 'but'",
      "It makes the verse a question",
      "It is the letter of an oath: it puts ٱلضُّحَىٰ in the genitive"
    ],
    correctAnswer: 3,
    explanation: "At the start of a surah, a wāw followed by a genitive noun is an oath letter. Al-Jadwal ties the phrase to a left-out 'I swear' (L5.08, L4.19)."
  },
  {
    id: 13,
    question: "In وَقَالَتِ ٱمْرَأَتُ فِرْعَوْنَ (Al-Qasas 28:9), who is the doer of قَالَتِ?",
    options: [
      "The wife of Pharaoh: a written doer, in the nominative",
      "A hidden 'she' inside the verb",
      "Pharaoh",
      "Musa"
    ],
    correctAnswer: 0,
    explanation: "ٱمْرَأَتُ is the doer: it follows its verb and ends in a ḍamma. The ت of قَالَتِ shows that the doer is feminine (L5.10)."
  },
  {
    id: 14,
    question: "In لَا تُشْرِكْ بِٱللَّهِ (Luqman 31:13), the verb تُشْرِكْ ends in a sukūn. What causes it?",
    options: [
      "The condition word إِن brings jazm",
      "The لَا of a ban brings jazm",
      "لَنْ brings naṣb",
      "It is a command"
    ],
    correctAnswer: 1,
    explanation: "A لَا that bans puts the present verb in jazm, here a sukūn (L4.10, L3.07). Luqman is speaking to his son (L5.17)."
  }
];
---

<BaseLayout title="Level 5 Quiz - Applied Study" description="Test your Applied Study knowledge: Surah Al-Fatiha, questions, oaths, who speaks in a story, word order and jazm in the verses of Level 5.">
  <Container maxWidth="lg">
    <QuizComponent
      title="Level 5 Quiz: Applied Quranic Study"
      questions={questions}
      passingScore={70}
      level={5}
    />
    <nav class="quiz-nav">
      {prevLesson ? (
        <a href={prevLesson} class="nav-link prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Previous Lesson
        </a>
      ) : <div></div>}
      {nextLesson ? (
        <a href={nextLesson} class="nav-link next">
          Next Lesson
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ) : <div></div>}
    </nav>
  </Container>
</BaseLayout>

<style>
  .quiz-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 85ch;
    margin-inline: auto;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-primary);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-gold);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-link svg {
    width: 18px;
    height: 18px;
    transition: transform var(--transition-fast);
  }

  .nav-link.prev:hover svg {
    transform: translateX(-2px);
  }

  .nav-link.next:hover svg {
    transform: translateX(2px);
  }
</style>
