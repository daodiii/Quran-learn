---
import { getEntryDates } from '../../lib/getEntryDates';

interface Props {
  title: string;
  description: string;
  url: string;
  type?: 'Article' | 'LearningResource';
  educationalLevel?: string;
  datePublished?: Date;
  dateModified?: Date;
  isPartOfCourse?: boolean;
  /** The source this page is built on, as a schema.org object (a Book or Dataset). */
  isBasedOn?: Record<string, unknown>;
}

const {
  title,
  description,
  url,
  type = 'Article',
  educationalLevel,
  datePublished,
  dateModified,
  isPartOfCourse = false,
  isBasedOn,
} = Astro.props;
const siteUrl = Astro.site?.href.replace(/\/$/, '') || '';
const fullUrl = `${siteUrl}${url}`;

// Surah and hadith pages do not pass dates: read them from the committed git dates (src/data/entry-dates.json).
const entryMatch = /^[/](surahs|hadith)[/]([^/]+)[/]?$/.exec(url);
const entryDates = !datePublished && entryMatch ? getEntryDates(`src/content/${entryMatch[1]}/${entryMatch[2]}.mdx`, {}) : undefined;
const published = datePublished ?? entryDates?.datePublished;
const modified = dateModified ?? entryDates?.dateModified;
const orgId = `${siteUrl}/#organization`;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": type,
  "headline": title,
  "description": description,
  "url": fullUrl,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullUrl,
  },
  "inLanguage": "en",
  "image": `${siteUrl}/images/og-default.jpg`,
  "author": { "@id": orgId },
  "publisher": {
    "@type": "Organization",
    "@id": orgId,
    "name": "Quranic Grammar",
    "url": siteUrl,
  },
};

if (educationalLevel) {
  jsonLd.educationalLevel = educationalLevel;
}

if (published) {
  jsonLd.datePublished = published.toISOString();
}

if (modified) {
  jsonLd.dateModified = modified.toISOString();
}

if (isBasedOn) {
  jsonLd.isBasedOn = isBasedOn;
}

if (isPartOfCourse) {
  jsonLd.isPartOf = {
    "@type": "Course",
    "@id": `${siteUrl}/learn/#course`,
    "name": "Quranic Arabic Grammar",
    "url": `${siteUrl}/learn/`,
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
