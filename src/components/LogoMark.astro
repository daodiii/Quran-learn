---
import { HARAKAT_COLOR, HARAKAT_PATHS, HARAKAT_VIEWBOX } from '../lib/brand';
interface Props { class?: string; color?: string; }
const { class: className, color = HARAKAT_COLOR } = Astro.props;
---
<svg class={className} viewBox={HARAKAT_VIEWBOX} width="32" height="34" fill={color} aria-hidden="true" focusable="false" data-brand="harakat">
  {HARAKAT_PATHS.map((d) => <path d={d} />)}
</svg>
