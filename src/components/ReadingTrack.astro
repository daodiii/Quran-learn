---
// Graded reading rows for one level: surah analyses the learner can now read
// with the analysis open. Build-time guard: every slug must resolve to a
// surah collection entry.
import { getCollection } from 'astro:content';
import { READING_TRACK } from '../data/reading-track';

interface Props {
  level: number;
}
const { level } = Astro.props;

const surahs = await getCollection('surahs');
const rows = READING_TRACK
  .filter(e => e.afterLevel === level)
  .map(entry => {
    const surah = surahs.find(s => s.id === entry.slug);
    if (!surah) throw new Error(`reading-track: unknown surah slug "${entry.slug}"`);
    return {
      ...entry,
      name: surah.data.name,
      nameArabic: surah.data.nameArabic,
      number: surah.data.surahNumber,
      verseCount: surah.data.verseCount,
    };
  })
  .sort((a, b) => a.number - b.number);
---

{rows.length > 0 && (
  <section class="reading-track" data-reading-track aria-labelledby={`reading-heading-l${level}`}>
    <h3 class="reading-title" id={`reading-heading-l${level}`}>Apply it: read with the analysis open</h3>
    <p class="reading-sub">
      {rows.length} surah {rows.length === 1 ? 'analysis' : 'analyses'} matched to what Level {level} taught.
    </p>
    <div class="reading-rows">
      {rows.map(r => (
        <a href={`/surahs/${r.slug}/`} class="reading-row" data-reading-row>
          <span class="reading-number">{r.number}</span>
          <span class="reading-main">
            <span class="reading-name">
              {r.name}
              <span class="reading-verses">{r.verseCount}&nbsp;verses</span>
            </span>
            <span class="reading-note">{r.note}</span>
          </span>
          <span class="reading-arabic" lang="ar" dir="rtl">{r.nameArabic}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .reading-track {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--border-primary);
  }

  .reading-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .reading-sub {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin: 0.25rem 0 var(--space-md);
  }

  .reading-rows {
    display: flex;
    flex-direction: column;
  }

  .reading-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    transition: background 200ms cubic-bezier(0.23, 1, 0.32, 1),
                transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .reading-row:hover { background: var(--bg-secondary); }
    .reading-row:hover .reading-name { color: var(--accent-primary); }
  }

  .reading-row:active { transform: scale(0.99); }

  .reading-number {
    flex-shrink: 0;
    inline-size: 2.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .reading-main {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
    flex: 1;
  }

  .reading-name {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .reading-verses {
    margin-inline-start: 0.5rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .reading-note {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    max-inline-size: 62ch;
  }

  .reading-arabic {
    flex-shrink: 0;
    font-family: var(--font-arabic);
    font-size: 1.25rem;
    color: var(--text-secondary);
    align-self: center;
  }

  @media (max-width: 640px) {
    .reading-arabic { display: none; }
    .reading-number { inline-size: 1.75rem; }
  }
</style>
