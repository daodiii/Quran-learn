---
/**
 * ArabicExample - Display Quranic verses as a lab "verse console"
 *
 * Usage example (basic):
 * <ArabicExample
 *   arabic="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
 *   transliteration="bismi llahi r-rahmani r-rahim"
 *   translation="In the name of God, the Most Gracious, the Most Merciful"
 *   reference="Surah Al-Fatiha 1:1"
 *   highlight="بِسْمِ"
 * />
 *
 * Usage example (with interlinear word-by-word — renders an interactive
 * console: each word is a focusable button that populates the readout
 * panel and dispatches a `lab:word-touched` event for the rail telemetry):
 * <ArabicExample
 *   arabic="بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
 *   transliteration="bismi llahi r-rahmani r-rahim"
 *   translation="In the name of God, the Most Gracious, the Most Merciful"
 *   reference="Surah Al-Fatiha 1:1"
 *   words={[
 *     { ar: "بِسْمِ", tr: "bismi", en: "In the name of" },
 *     { ar: "اللَّهِ", tr: "Allāhi", en: "Allah" },
 *     { ar: "الرَّحْمَنِ", tr: "ar-raḥmāni", en: "the Most Gracious" },
 *     { ar: "الرَّحِيمِ", tr: "ar-raḥīmi", en: "the Most Merciful" },
 *   ]}
 * />
 */

interface WordEntry {
  ar: string;   // Arabic word (vocalized)
  tr: string;   // Transliteration
  en: string;   // English meaning
}

interface Props {
  arabic: string;           // Arabic text (fully vocalized with harakat)
  transliteration?: string; // Romanized pronunciation
  translation: string;      // English meaning
  reference?: string;       // Quranic reference (e.g., "Surah Al-Fatiha 1:2")
  highlight?: string;       // Comma-separated Arabic words to visually highlight
  words?: WordEntry[];      // Optional word-by-word interlinear data
}

import { parseAyahRef, ayahAudioUrl } from '../../lib/ayah-ref';

const { arabic, transliteration, translation, reference, highlight, words } = Astro.props;

// Recitation audio is derived from the reference when it names an ayah.
const ayah = reference ? parseAyahRef(reference) : null;

// Process highlight if provided
const highlightWords = highlight ? highlight.split(',').map(w => w.trim()) : [];

// Function to wrap highlighted words
const processArabicText = (text: string, words: string[]): string => {
  if (words.length === 0) return text;

  // Split by spaces and wrap matching words
  const parts = text.split(' ');
  return parts.map(part => {
    if (words.includes(part)) {
      return `<mark class="grammar-highlight">${part}</mark>`;
    }
    return part;
  }).join(' ');
};

const processedArabic = processArabicText(arabic, highlightWords);
const hasWords = words && words.length > 0;
---

<figure class="arabic-example console" data-reveal>
  <figcaption class="c-top">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    {reference || 'Specimen'}
  </figcaption>

  {hasWords ? (
    <p class="c-ar" lang="ar" dir="rtl" data-words>
      {words!.map((word, i) => {
        const isHighlighted = highlightWords.includes(word.ar);
        return (
          <>
            {i > 0 && ' '}
            <button
              type="button"
              class:list={['w', { al: isHighlighted }]}
              data-tr={word.tr}
              data-en={word.en}
            ><bdi>{word.ar}</bdi></button>
          </>
        );
      })}
    </p>
  ) : (
    <p class="c-ar static" dir="rtl" lang="ar" set:html={processedArabic} />
  )}

  {hasWords && (
    <div class="readout" aria-live="polite">
      <div><span class="r-k">Word</span><span class="r-v gold" data-ro="ar">— touch a word —</span></div>
      <div><span class="r-k">Meaning</span><span class="r-v" data-ro="en">—</span></div>
      <div><span class="r-k">Transliteration</span><span class="r-v" data-ro="tr">—</span></div>
    </div>
  )}

  <div class="c-foot">
    {transliteration && <p class="c-tr">{transliteration}</p>}
    <p class="c-en">{translation}</p>
    {reference && (
      <p class="reference" dir="ltr">
        &mdash; {reference}
        {ayah && (
          <button class="ayah-play" type="button" data-audio-src={ayahAudioUrl(ayah)}
                  aria-label={`Play recitation of verse ${ayah.surah}:${ayah.ayah}`}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <span class="ayah-play-label">Listen</span>
          </button>
        )}
      </p>
    )}
  </div>
</figure>

<script>
  // Two independently-delegated handlers (Astro dedupes identical component
  // scripts to one instance per page — no astro:page-load re-clone needed).

  // ---------- audio playback ----------
  let current: HTMLAudioElement | null = null;
  let currentBtn: HTMLElement | null = null;

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.ayah-play') as HTMLElement | null;
    if (!btn || btn.hasAttribute('disabled')) return;
    if (currentBtn === btn && current) {
      if (current.paused) { current.play(); btn.classList.add('playing'); }
      else { current.pause(); btn.classList.remove('playing'); }
      return;
    }
    current?.pause();
    currentBtn?.classList.remove('playing');
    current = new Audio(btn.dataset.audioSrc!); // fetched on demand, never preloaded
    currentBtn = btn;
    btn.classList.add('playing');
    current.play().catch(() => { btn.classList.add('unavailable'); btn.setAttribute('disabled', ''); });
    current.addEventListener('ended', () => btn.classList.remove('playing'));
    current.addEventListener('error', () => {
      btn.classList.add('unavailable');
      btn.setAttribute('disabled', '');
      btn.classList.remove('playing');
    });
  });

  // ---------- verse console readout ----------
  function showWord(w: HTMLElement, panel: Element) {
    panel.querySelectorAll('.w.lit').forEach((x) => x.classList.remove('lit'));
    w.classList.add('lit');
    const figure = panel.closest('figure');
    const roAr = figure?.querySelector('[data-ro="ar"]');
    const roEn = figure?.querySelector('[data-ro="en"]');
    const roTr = figure?.querySelector('[data-ro="tr"]');
    if (roAr) roAr.textContent = w.textContent ?? '';
    if (roEn) roEn.textContent = w.dataset.en ?? '';
    if (roTr) roTr.textContent = w.dataset.tr ?? '';
  }

  document.addEventListener('click', (e) => {
    const w = (e.target as HTMLElement).closest('.console .c-ar[data-words] .w') as HTMLElement | null;
    if (!w) return;
    const panel = w.closest('[data-words]');
    if (!panel) return;
    showWord(w, panel);
    document.dispatchEvent(new CustomEvent('lab:word-touched'));
  });

  document.addEventListener(
    'focus',
    (e) => {
      const w = (e.target as HTMLElement).closest?.('.console .c-ar[data-words] .w') as HTMLElement | null;
      if (!w) return;
      const panel = w.closest('[data-words]');
      if (!panel) return;
      showWord(w, panel);
    },
    true
  );
</script>

<style>
  /* Component-scoped styles are intentionally minimal: the lab visual
     language (frame chrome, readout grid, console typography) lives in
     the global src/styles/lesson-lab.css so it can also reach the
     runtime-created readout content — see astro-css-gotchas. This block
     only holds the highlight-mark rule Astro's scoping can see. */
  .c-ar :global(mark.grammar-highlight) {
    background: rgba(227, 179, 92, 0.16);
    color: var(--gold-bright, #f4d68f);
    border-bottom: 2px solid var(--gold, #e3b35c);
    border-radius: 4px;
    padding-inline: 0.2rem;
  }
</style>
