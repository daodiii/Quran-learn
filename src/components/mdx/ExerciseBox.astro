---
/**
 * ExerciseBox - Interactive practice exercise with show/hide answer toggle,
 * skinned as a lab "diagnostic" ("DIAG 01", "DIAG 02", …, numbered via a
 * CSS counter on .lesson-content — see lesson-lab.css).
 *
 * The ONE MDX component that requires client-side JavaScript for interactivity.
 * Provides accessible keyboard navigation and screen reader support.
 *
 * Usage example:
 * <ExerciseBox question="What is the definite article in Arabic?">
 *   The definite article is **al-** (الـ). It is prefixed directly to the noun.
 *
 *   <ArabicExample
 *     arabic="الْكِتَابُ"
 *     translation="the book"
 *     reference="Example"
 *   />
 * </ExerciseBox>
 */

interface Props {
  question: string;
  id?: string;
}

const { question, id = `exercise-${Math.random().toString(36).substr(2, 9)}` } = Astro.props;
const answerId = `answer-${id}`;
---

<div class="exercise-box" data-reveal>
  <p class="exercise-question">{question}</p>

  <button
    type="button"
    class="toggle-answer"
    aria-expanded="false"
    aria-controls={answerId}
  >
    <span class="toggle-text">Show Answer</span>
    <span class="toggle-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </button>

  <div class="exercise-answer" id={answerId} hidden>
    <slot />
  </div>
</div>

<style>
  /* Chrome (border, DIAG numbering, colors) lives in the global
     src/styles/lesson-lab.css so the per-page CSS counter can span every
     ExerciseBox instance. Only answer-content spacing stays scoped here. */
  .exercise-answer :global(p) {
    margin-block-end: 0.75rem;
    line-height: 1.7;
  }

  .exercise-answer :global(p:last-child) {
    margin-block-end: 0;
  }

  .exercise-answer :global(ul),
  .exercise-answer :global(ol) {
    margin-block-end: 0.75rem;
  }

  .exercise-answer :global(.arabic-example),
  .exercise-answer :global(.callout) {
    margin-block: 0.75rem;
  }

  /* Accessibility: reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .toggle-icon {
      transition: none;
    }
  }

  /* Base (non-lab) skin — ships wherever ExerciseBox is used, incl. surah and
     resource pages without lesson-lab.css. :where() keeps specificity low so
     lesson-lab's `.lab .exercise-box …` rules win on lesson pages. */
  :global(.prose) .exercise-box {
    margin-block: 1.25rem;
    border: 1px solid var(--color-border-primary, var(--border-primary));
    border-radius: var(--radius-md);
    background: var(--color-background-secondary, var(--bg-secondary));
    overflow: clip;
  }
  :global(.prose) .exercise-box .exercise-question {
    margin: 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-primary);
  }
  :global(.prose) .exercise-box .toggle-answer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 clamp(1rem, 2.5vw, 1.5rem) clamp(0.9rem, 2vw, 1.25rem);
    padding: 0.4rem 0.9rem;
    background: none;
    border: 1px solid var(--accent-gold);
    border-radius: 999px;
    color: var(--accent-gold);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  :global(.prose) .exercise-box .toggle-answer:hover { background: var(--accent-gold-light, rgba(242, 217, 140, 0.2)); }
  :global(.prose) .exercise-box .toggle-icon { display: inline-flex; transition: transform 0.3s ease; }
  :global(.prose) .exercise-box .toggle-answer[aria-expanded='true'] .toggle-icon { transform: rotate(180deg); }
  :global(.prose) .exercise-box .exercise-answer {
    padding: 0 clamp(1rem, 2.5vw, 1.5rem) clamp(1rem, 2.5vw, 1.5rem);
    border-block-start: 1px solid var(--color-border-primary, var(--border-primary));
    color: var(--color-text-secondary);
  }
  :global(.prose) .exercise-box .exercise-answer::before {
    content: 'Answer';
    display: block;
    padding-block-start: 0.9rem;
    margin-block-end: 0.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.prose) .exercise-box .toggle-icon { transition: none; }
  }
</style>

<script>
  function initExercises() {
    const toggleButtons = document.querySelectorAll('.toggle-answer');

    toggleButtons.forEach(button => {
      // Remove existing listener to prevent duplicates on view transitions
      button.replaceWith(button.cloneNode(true));
    });

    // Re-query after cloning
    const freshButtons = document.querySelectorAll('.toggle-answer');

    freshButtons.forEach(button => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        const answerId = button.getAttribute('aria-controls');
        const answerPanel = document.getElementById(answerId || '');
        const toggleText = button.querySelector('.toggle-text');
        const exercise = button.closest('.exercise-box');

        if (!answerPanel || !toggleText) return;

        // Toggle state
        button.setAttribute('aria-expanded', String(!expanded));
        answerPanel.hidden = expanded;
        toggleText.textContent = expanded ? 'Show Answer' : 'Hide Answer';
        exercise?.classList.toggle('open', !expanded);
      });

      // Also support keyboard activation (Enter and Space are handled by default for buttons)
    });
  }

  // Initialize on page load
  initExercises();

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:page-load', initExercises);
</script>
