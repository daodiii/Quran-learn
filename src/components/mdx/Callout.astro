---
/**
 * Callout - Educational callout boxes for lessons, skinned as lab frames
 * (note/tip) or ruleboxes (rule/warning).
 *
 * Usage examples:
 * <Callout type="rule" title="The Definite Article">
 *   In Arabic, **al-** (ال) makes any noun definite. Unlike English, there is only one article for all genders and numbers.
 * </Callout>
 *
 * <Callout type="warning">
 *   Don't confuse the sun letters with moon letters — they affect pronunciation but not spelling.
 * </Callout>
 */

interface Props {
  type?: 'note' | 'tip' | 'rule' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;

// Default titles for each type
const defaultTitles: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  rule: 'Grammar Rule',
  warning: 'Common Mistake',
};

const displayTitle = title || defaultTitles[type];

// note/tip render as labelled frames; rule/warning render as gradient ruleboxes
const isRuleStyle = type === 'rule' || type === 'warning';
const kicker = type === 'rule' ? 'Rule' : 'Warning';
const frameVariant = type === 'tip' ? 'tipf' : 'notef';
---

{isRuleStyle ? (
  <aside class={`callout callout-${type} rulebox ${type === 'warning' ? 'warn' : ''}`} role="note" data-reveal>
    <div class="rulebox-in">
      <p class="rb-k">{kicker}</p>
      <p class="rb-t">{displayTitle}</p>
      <div class="callout-content">
        <slot />
      </div>
    </div>
  </aside>
) : (
  <aside class={`callout callout-${type} frame ${frameVariant}`} role="note" aria-label={displayTitle} data-label={displayTitle} data-reveal>
    <div class="frame-in">
      <div class="callout-content">
        <slot />
      </div>
    </div>
  </aside>
)}

<style>
  /* Type-neutral content spacing — the frame/rulebox chrome itself lives
     in the global src/styles/lesson-lab.css (scoped under .lab). */
  .callout-content :global(p) {
    margin-block-end: 0.75rem;
  }

  .callout-content :global(p:last-child) {
    margin-block-end: 0;
  }

  .callout-content :global(ul),
  .callout-content :global(ol) {
    margin-block-start: 0.5rem;
    margin-block-end: 0.5rem;
  }

  .callout-content :global(strong) {
    color: var(--ink, inherit);
  }

  /* Base (non-lab) skin — ships wherever Callout is used, incl. surah and
     resource pages without lesson-lab.css. :where() keeps specificity low so
     lesson-lab's `.lab .rulebox`/`.lab .frame` rules win on lesson pages.
     The title is rendered via the ::before below (mirrors lesson-lab); the
     aria-label on the note/tip <aside> carries it into the a11y tree. */
  :global(.prose) .callout.rulebox {
    margin-block: 1.5rem;
    border: 1px solid var(--accent-gold);
    border-inline-start-width: 3px;
    border-radius: var(--radius-md);
    background: var(--glass-bg-tinted-gold, var(--color-background-secondary, var(--bg-secondary)));
  }
  :global(.prose) .callout.rulebox.warn { border-color: var(--accent-copper, #c98a4b); }
  :global(.prose) .rulebox .rulebox-in { padding: clamp(1.1rem, 3vw, 1.6rem); }
  :global(.prose) .rulebox .rb-k {
    margin: 0; font-size: 0.7rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent-gold); font-weight: 600;
  }
  :global(.prose) .rulebox.warn .rb-k, :global(.prose) .rulebox.warn .rb-t { color: var(--accent-copper, #c98a4b); }
  :global(.prose) .rulebox .rb-t {
    margin: 0.25rem 0 0.6rem; font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem); color: var(--color-text-primary);
  }
  :global(.prose) .rulebox .callout-content { color: var(--color-text-secondary); }

  :global(.prose) .callout.frame {
    position: relative;
    margin-block: 1.75rem;
    border: 1px solid var(--color-border-primary, var(--border-primary));
    border-radius: var(--radius-md);
    background: var(--color-background-secondary, var(--bg-secondary));
  }
  :global(.prose) .callout.frame::before {
    content: attr(data-label);
    position: absolute;
    inset-block-start: -0.6rem;
    inset-inline-start: 1rem;
    padding: 0 0.5rem;
    background: var(--color-background-primary, var(--bg-primary, #fff));
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  :global(.prose) .callout.frame.tipf::before { color: var(--accent-teal, #2a9d8f); }
  :global(.prose) .frame .frame-in { padding: clamp(1.1rem, 3vw, 1.6rem); }
  :global(.prose) .frame .callout-content { color: var(--color-text-secondary); }
</style>
