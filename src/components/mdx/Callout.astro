---
/**
 * Callout - Educational callout boxes for lessons, skinned as lab frames
 * (note/tip) or ruleboxes (rule/warning).
 *
 * Usage examples:
 * <Callout type="rule" title="The Definite Article">
 *   In Arabic, **al-** (ال) makes any noun definite. Unlike English, there is only one article for all genders and numbers.
 * </Callout>
 *
 * <Callout type="warning">
 *   Don't confuse the sun letters with moon letters — they affect pronunciation but not spelling.
 * </Callout>
 */

interface Props {
  type?: 'note' | 'tip' | 'rule' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;

// Default titles for each type
const defaultTitles: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  rule: 'Grammar Rule',
  warning: 'Common Mistake',
};

const displayTitle = title || defaultTitles[type];

// note/tip render as labelled frames; rule/warning render as gradient ruleboxes
const isRuleStyle = type === 'rule' || type === 'warning';
const kicker = type === 'rule' ? 'Rule' : 'Warning';
const frameVariant = type === 'tip' ? 'tipf' : 'notef';
---

{isRuleStyle ? (
  <aside class={`callout callout-${type} rulebox ${type === 'warning' ? 'warn' : ''}`} role="note" data-reveal>
    <div class="rulebox-in">
      <p class="rb-k">{kicker}</p>
      <p class="rb-t">{displayTitle}</p>
      <div class="callout-content">
        <slot />
      </div>
    </div>
  </aside>
) : (
  <aside class={`callout callout-${type} frame ${frameVariant}`} role="note" data-label={displayTitle} data-reveal>
    <div class="frame-in">
      <div class="callout-content">
        <slot />
      </div>
    </div>
  </aside>
)}

<style>
  /* Type-neutral content spacing — the frame/rulebox chrome itself lives
     in the global src/styles/lesson-lab.css (scoped under .lab). */
  .callout-content :global(p) {
    margin-block-end: 0.75rem;
  }

  .callout-content :global(p:last-child) {
    margin-block-end: 0;
  }

  .callout-content :global(ul),
  .callout-content :global(ol) {
    margin-block-start: 0.5rem;
    margin-block-end: 0.5rem;
  }

  .callout-content :global(strong) {
    color: var(--ink, inherit);
  }
</style>
