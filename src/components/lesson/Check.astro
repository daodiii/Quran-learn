---
/**
 * One quick question with instant feedback. A wrong pick says "try another"; the right pick shows why.
 * The layout script (src/scripts/lesson-steps.ts) handles the clicks.
 *
 * <Check n={1} q="Which word is the mubtadaʾ?" options={['ٱللَّهُ', 'غَفُورٌ']} answer={0} why="It is what the sentence is about." />
 */
import { wrapArabic } from '../../lib/lesson-steps';

interface Props {
  q: string;
  options: string[];
  answer: number;
  why: string;
  n?: number;
}
const { q, options, answer, why, n } = Astro.props;
---

<div class="lx-check" data-answer={answer}>
  <p class="lx-q">
    {n !== undefined && <span class="lx-qn" aria-hidden="true">{n}</span>}
    <span set:html={wrapArabic(q)} />
  </p>
  <div class="lx-opts" role="group" aria-label="Answers">
    {options.map((o, k) => <button type="button" class="lx-opt" data-k={k} set:html={wrapArabic(o)} />)}
  </div>
  <p class="lx-fb" role="status" aria-live="polite" hidden></p>
  <p class="lx-why" hidden set:html={wrapArabic(why)} />
</div>
