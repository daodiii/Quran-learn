---
// Vocabulary rows shared by the lesson footer section and the per-level
// review page. Entries come from src/data/vocab/lessons.json (generated by
// scripts/build-lesson-vocab.ts — words the learner literally saw in lessons).
import type { VocabEntry } from '../../scripts/lib/lesson-vocab';

interface Props { entries: VocabEntry[] }
const { entries } = Astro.props;
---
<ul class="vocab-list">
  {entries.map(w => (
    <li class="vocab-row" data-vocab-row>
      <span class="vocab-ar" lang="ar" dir="rtl">{w.arabic}</span>
      <span class="vocab-mid">
        <span class="vocab-translit">{w.translit}</span>
        <span class="vocab-gloss" data-vocab-gloss>{w.gloss}</span>
      </span>
      <span class="vocab-meta">
        <a href={`/resources/word-lookup/?q=${encodeURIComponent(w.arabic)}`} class="vocab-lookup">analyze</a>
        <span class="vocab-count" title={`occurs ${w.count} times in the Quran`}>×{w.count}</span>
      </span>
    </li>
  ))}
</ul>
<style>
  .vocab-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .vocab-row {
    display: flex; align-items: baseline; gap: var(--space-md);
    padding: 0.625rem 0.5rem;
    border-block-end: 1px solid var(--border-primary);
  }
  .vocab-ar {
    font-family: var(--font-arabic);
    font-size: 1.5rem;
    min-inline-size: 7rem;
    line-height: 1.8;
  }
  .vocab-mid { display: flex; flex-direction: column; gap: 0.125rem; min-inline-size: 0; flex: 1; }
  .vocab-translit { font-size: 0.875rem; color: var(--text-tertiary); }
  .vocab-gloss { font-size: 1rem; color: var(--text-primary); }
  .vocab-meta { display: flex; align-items: baseline; gap: var(--space-sm); flex-shrink: 0; }
  .vocab-count {
    font-size: 0.8125rem; color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .vocab-lookup { font-size: 0.8125rem; color: var(--accent-primary); }
  @media (max-width: 480px) {
    .vocab-ar { min-inline-size: 5rem; font-size: 1.375rem; }
  }
</style>
