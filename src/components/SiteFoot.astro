---
/** The dark footer for every light page: the dua, the main links, the sources and a very small credit. */
import '../styles/site-nav.css';
import LogoMark from './LogoMark.astro';

// The home page already ends on the dua, so it passes dua={false}.
const { dua = true } = Astro.props;

---
<footer class="sf">
  {dua && <div class="sf-dua" lang="ar" dir="rtl"><span>رَبِّ</span><span>زِدْنِى</span><span>عِلْمًا</span></div>}
  {dua && <p class="sf-mean">“My Lord, increase me in knowledge.” · Taha 20:114</p>}
  <div class="sf-in">
    <div class="sf-row">
      <a class="sf-brand" href="/" aria-label="Quranic Grammar, home">
        <LogoMark color="#e68b80" />
        <span>Quranic Grammar</span>
      </a>
      <nav aria-label="Footer"><a href="/learn/">Learn</a><a href="/surahs/">Surahs</a><a href="/resources/">Resources</a><a href="/hadith/">Forty Hadith</a><a href="/about/">About and feedback</a></nav>
    </div>
    <p class="sf-legal">Word data from the <a href="https://corpus.quran.com/">Quranic Arabic Corpus</a> (Kais Dukes, GPL). Quran text after <a href="https://tanzil.net/">Tanzil</a>. English meanings on this site are our own plain-English wording, not a translation.</p>
    <nav class="sf-fine" aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
    <p class="sf-credit">Made by <a href="https://www.idweb.no" target="_blank" rel="noopener">IDweb</a></p>
  </div>
</footer>
