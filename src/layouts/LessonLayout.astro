---
import BaseLayout from './BaseLayout.astro';

import CourseNavigator from '../components/navigation/CourseNavigator.astro';
import NavigatorToggle from '../components/navigation/NavigatorToggle.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import VocabList from '../components/VocabList.astro';
import ReadingTrack from '../components/ReadingTrack.astro';
import vocabData from '../data/vocab/lessons.json';
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro';
import ArticleSchema from '../components/seo/ArticleSchema.astro';
import { getCollection } from 'astro:content';
import '../styles/night.css';
import '../styles/lesson-lab.css';

interface Props {
  title: string;
  titleArabic?: string;
  level: number;
  description?: string;
  nextLesson?: string;
  prevLesson?: string;
  datePublished?: Date;
  dateModified?: Date;
  headings?: { depth: number; slug: string; text: string }[];
  positionInLevel?: { index: number; total: number };
}

const { title, titleArabic, level, description, nextLesson, prevLesson, datePublished, dateModified, headings, positionInLevel } = Astro.props;

const tocHeadings = (headings ?? []).filter(h => h.depth === 2);

// Get the lesson slug from the URL path
const lessonSlug = Astro.url.pathname.replace(/^\/learn\//, '').replace(/\/$/, '');

// Find the current lesson entry to get its full ID for CourseNavigator
const allLessons = await getCollection('lessons');
const currentLesson = allLessons.find(lesson => {
  const lessonPath = `/learn/${lesson.id.replace('.mdx', '')}/`;
  return lessonPath === Astro.url.pathname || lessonPath === Astro.url.pathname + '/';
});

const currentLessonSlug = currentLesson?.id || '';

// New high-frequency words this lesson introduced (empty for most checkpoints
// and any lesson whose example words were all taught earlier).
const lessonVocab = (vocabData as Record<string, any[]>)[currentLessonSlug || lessonSlug] ?? [];

// Build breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Learn', href: '/learn/' },
  { label: `Level ${level}`, href: `/learn/#level-${level}` },
  { label: title }
];

const levelNames: Record<number, string> = {
  1: 'Foundation',
  2: 'Core Grammar',
  3: 'Intermediate',
  4: 'Advanced',
  5: 'Applied Study',
};

const educationalLevels: Record<number, string> = {
  1: 'Beginner',
  2: 'Beginner',
  3: 'Intermediate',
  4: 'Advanced',
  5: 'Advanced',
};

// Station rail: 00 = Briefing (the header), then one station per h2 section.
const stations = [
  { target: 'lesson-brief', pip: '00', label: 'Briefing' },
  ...tocHeadings.map((h, i) => ({ target: h.slug, pip: String(i + 1).padStart(2, '0'), label: h.text })),
];

const fontsHref = "https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:ital,wght@0,400;0,700;1,400&family=Marcellus&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap";
---

<BaseLayout title={title} description={description} type="article">
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbItems} />
    <ArticleSchema
      title={title}
      description={description || `${levelNames[level]} lesson on ${title} in Quranic Arabic grammar.`}
      url={Astro.url.pathname}
      type="LearningResource"
      educationalLevel={educationalLevels[level]}
      datePublished={datePublished}
      dateModified={dateModified}
      isPartOfCourse={true}
    />
    {prevLesson && <link rel="prev" href={new URL(prevLesson, Astro.site).href} />}
    {nextLesson && <link rel="next" href={new URL(nextLesson, Astro.site).href} />}

    <!--
      Lesson pages are always the Anatomy Lab (always-night), regardless of
      the visitor's site-wide theme preference. This never touches
      localStorage — leaving the rest of the site on the reader's choice —
      and re-forces on Astro's page-load/after-swap events in case view
      transitions land here from a themed page mid-transition.
    -->
    <script is:inline>
      (function () {
        document.documentElement.dataset.theme = 'dark';
        document.addEventListener('astro:page-load', function () {
          document.documentElement.dataset.theme = 'dark';
        });
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.dataset.theme = 'dark';
        });
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontsHref} />
    </noscript>
  </Fragment>

  <!-- Backdrop for mobile sidebar -->
  <div id="navigator-backdrop" class="navigator-backdrop"></div>

  <div class="lesson-page">
    <div class="lesson-grid lab">
      <!-- Sidebar with CourseNavigator -->
      <aside class="lesson-sidebar">
        <CourseNavigator currentLessonSlug={currentLessonSlug} />
      </aside>

      <!-- Main Content -->
      <main class="lesson-main">
        <!-- Breadcrumbs -->
        <Breadcrumbs items={breadcrumbItems} />

        <div class="lab-body">
          <!-- ================= STATION RAIL ================= -->
          <aside class="rail" data-lesson-toc aria-label="Lesson stations">
            <p class="r-head">
              Level {level} · {positionInLevel ? `Lesson ${positionInLevel.index} of ${positionInLevel.total}` : levelNames[level]}
              <b>{title}</b>
            </p>
            {stations.map(s => (
              <a class="station" href={`#${s.target}`} data-station-target={s.target}>
                <span class="pip">{s.pip}</span>{s.label}
              </a>
            ))}
            <div class="r-stat">
              Progress <b data-rail-pct>0%</b>
              <span class="r-bar"><i data-rail-fill></i></span>
              Words touched <b data-rail-touch>0</b>
            </div>
          </aside>

          <!-- ================= MAIN ================= -->
          <article class="lesson-article">
            <header class="lesson-header" id="lesson-brief">
              <p class="sess">
                <span class={`level-badge level-badge-${level}`}>Level {level} · {levelNames[level]}</span>
                {positionInLevel && (
                  <span class="lesson-position" data-lesson-position>Lesson {positionInLevel.index} of {positionInLevel.total}</span>
                )}
              </p>
              <h1 class="lesson-title">{title}</h1>
              {titleArabic && (
                <p class="lesson-arabic" lang="ar" dir="rtl">{titleArabic}</p>
              )}
              {description && (
                <p class="lesson-description">{description}</p>
              )}
            </header>

            <div class="lesson-content" data-reveal>
              <slot />
            </div>

            {lessonVocab.length > 0 && (
              <section class="vocab-section frame" data-label="Specimen inventory" data-vocab-section aria-labelledby="vocab-heading" data-reveal>
                <div class="frame-in">
                  <h2 id="vocab-heading" class="vocab-heading">Words from this lesson</h2>
                  <p class="vocab-sub">High-frequency Quran vocabulary you just saw in context.</p>
                  <VocabList entries={lessonVocab} />
                  <p class="vocab-review-link">
                    <a href={`/learn/level-${level}/vocabulary/`}>Review all Level {level} vocabulary &rarr;</a>
                  </p>
                </div>
              </section>
            )}

            {positionInLevel && positionInLevel.index === positionInLevel.total && (
              <ReadingTrack level={level} />
            )}

            <!-- Debrief: completion -->
            <div class="debrief">
              <div class="complete-section" id="complete-section" data-lesson-slug={lessonSlug} data-reveal>
                <button id="complete-btn" class="done-btn">
                  <svg viewBox="0 0 15 15" aria-hidden="true"><path d="M2 8l4 4 7-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span id="complete-btn-text">Mark lesson complete</span>
                </button>
                <p id="complete-status" class="complete-status done-btn done" style="display: none;">
                  <svg viewBox="0 0 15 15" aria-hidden="true"><path d="M2 8l4 4 7-9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  Completed — lab signed off
                </p>
              </div>
            </div>

            <!-- Previous/Next Navigation -->
            <nav class="pager" aria-label="Lesson navigation">
              {prevLesson ? (
                <a href={prevLesson} class="page-link prev">
                  <span class="dir">&larr; Previous</span>
                  <span class="pt">Previous Lesson</span>
                </a>
              ) : <div></div>}
              {nextLesson ? (
                <a href={nextLesson} class="page-link next">
                  <span class="dir">Next &rarr;</span>
                  <span class="pt">Next Lesson</span>
                </a>
              ) : <div></div>}
            </nav>
          </article>
        </div>
      </main>
    </div>
  </div>

  <!-- Floating toggle for mobile -->
  <NavigatorToggle variant="floating" />
</BaseLayout>

<script>
  import { markLessonComplete, isLessonComplete } from '../lib/progress';

  async function initCompleteButton() {
    const section = document.getElementById('complete-section');
    const btn = document.getElementById('complete-btn') as HTMLButtonElement;
    const btnText = document.getElementById('complete-btn-text');
    const status = document.getElementById('complete-status');

    if (!section || !btn || !btnText || !status) return;

    const lessonSlug = section.dataset.lessonSlug || '';

    // Check if already completed
    const completed = await isLessonComplete(lessonSlug);
    if (completed) {
      btn.style.display = 'none';
      status.style.display = 'inline-flex';
      return;
    }

    // Handle click
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btnText.textContent = 'Saving...';

      const success = await markLessonComplete(lessonSlug);

      if (success) {
        btn.style.display = 'none';
        status.style.display = 'inline-flex';
      } else {
        btn.disabled = false;
        btnText.textContent = 'Mark lesson complete';
      }
    });
  }

  initCompleteButton();
</script>

<script>
  import '../scripts/lab-lesson';
</script>
